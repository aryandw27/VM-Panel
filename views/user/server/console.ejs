            s.term.resize(169, 33);
            sshResize(activeSessionId);
          } else {
            s.fit.fit();
            sshResize(activeSessionId);
          }
          if (s.term) s.term.focus();
          updateSizeBadge(!isDefaultSize);
        } catch (_) {}
      }

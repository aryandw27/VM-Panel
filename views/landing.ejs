          <div class="eyebrow" style="position:relative">
            <span class="eyebrow-dot"></span>
            <span>The Infrastructure</span>
          </div>

          <div class="about-lead-note reveal-on-scroll">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <circle cx="12" cy="12" r="9.25" />
              <path
                d="M12 2.75c2.6 2.3 4 5.8 4 9.25s-1.4 6.95-4 9.25c-2.6-2.3-4-5.8-4-9.25s1.4-6.95 4-9.25zM2.75 12h18.5" />

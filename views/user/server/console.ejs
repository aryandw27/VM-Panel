            </linearGradient>
          </defs>
          <path id="svgCpuFill" d="M 0,90 L 300,90 Z" fill="url(#cpuAreaGrad)" />
          <path id="svgCpuLine" d="M 0,90 L 300,90" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" />
        </svg>
      </div>
    </div>

    
    <div class="arix-chart-card">
      <div class="flex-between mb-1">
        <span class="arix-chart-label">Memory</span>
        <span class="arix-chart-val" id="chartValMem"><%= vm.status === 'running' ? '0 MB' : 'Offline' %></span>
      </div>
      <div class="arix-chart-container">
        <svg id="svgChartMem" class="arix-svg-chart" viewBox="0 0 300 90" preserveAspectRatio="none">
          <defs>
            <linearGradient id="memAreaGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.5"/>
              <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.02"/>
            </linearGradient>
          </defs>
          <path id="svgMemFill" d="M 0,90 L 300,90 Z" fill="url(#memAreaGrad)" />
          <path id="svgMemLine" d="M 0,90 L 300,90" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" />
        </svg>
      </div>
    </div>

    
    <div class="arix-chart-card">
      <div class="flex-between mb-1">
        <span class="arix-chart-label">Network</span>
        <div class="flex" style="gap:10px;align-items:center">
          <span style="display:flex;align-items:center;gap:3px;font-size:11px;color:#fbbf24" title="Inbound">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11"><path d="M12 3v12m0 0l4-4m-4 4l-4-4"/></svg>
            <span id="chartValNetIn"><%= vm.status === 'running' ? '0 KiB/s' : 'Offline' %></span>
          </span>
          <span style="display:flex;align-items:center;gap:3px;font-size:11px;color:#06b6d4" title="Outbound">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11"><path d="M12 15V3m0 0l4 4m-4-4l-4 4"/></svg>
            <span id="chartValNetOut"><%= vm.status === 'running' ? '0 KiB/s' : 'Offline' %></span>
          </span>
        </div>
      </div>
      <div class="arix-chart-container">
        <svg id="svgChartNet" class="arix-svg-chart" viewBox="0 0 300 90" preserveAspectRatio="none">
          <defs>
            <linearGradient id="netAreaGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.5"/>
              <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.02"/>
            </linearGradient>
          </defs>
          <path id="svgNetFill" d="M 0,90 L 300,90 Z" fill="url(#netAreaGrad)" />
          <path id="svgNetLine" d="M 0,90 L 300,90" fill="none" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" />
        </svg>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/music') %>
<%- include('../../partials/foot') %>

<script>
(function () {
  const isVmRunning = <%= vm.status === 'running' ? 'true' : 'false' %>;
  const bootTermEl = document.getElementById('bootTerminal');
  const rawBootEl = document.getElementById('bootRawContent');
  const stateEl = document.getElementById('connState');
  const bootStateEl = document.getElementById('bootState');
  const sshBootBanner = document.getElementById('sshBootBanner');
  const termSizeBadge = document.getElementById('termSizeBadge');
  let detectedDiagnostic = null;
  let dismissedDiagnostic = '';

  function inspectBootLogLocally() {
    const text = rawBootBuffer.slice(-12000);
    const patterns = [
      ['kernel panic', /kernel panic|unable to mount root fs|not syncing:\s*vfs/i],
      ['out of memory', /out of memory|oom-killer|killed process .* out of memory/i],
      ['KVM permission', /could not access kvm|permission denied.*\/dev\/kvm|failed to initialize kvm/i],
      ['disk or filesystem error', /no space left on device|i\/o error|filesystem corruption|buffer i\/o error/i],
      ['boot provisioning failure', /cloud-init.*(error|failed)|failed to fetch metadata|failed to mount/i],
      ['repeated VM startup failure', /qemu-system[^\n]*(failed|error)|failed to start.*(qemu|virtual machine)/i],
    ];
    const match = patterns.find(([, regex]) => regex.test(text));
    const banner = document.getElementById('aiDiagnosticSuggestion');
    if (!match || !banner) return;
    const code = match[0];
    if (dismissedDiagnostic === code) return;
    detectedDiagnostic = { code, vmId: <%= vm.id %> };
    document.getElementById('aiDiagnosticSuggestionText').textContent = `A local check found a ${code} signature in this VM's boot logs. No logs have been sent to an AI provider.`;
    banner.hidden = false;
  }
  window.acceptAiDiagnosticSuggestion = function () {
    if (!detectedDiagnostic || !window.openVPAI) return;
    const prompt = `Please investigate VM ${detectedDiagnostic.vmId}. A local boot-log check detected a possible ${detectedDiagnostic.code} issue. Use only your read-only VM inspection and boot-log tools, then explain the likely cause and safe next steps. Do not make changes.`;
    window.openVPAI(prompt, true);
  };
  window.dismissAiDiagnosticSuggestion = function () {
    if (detectedDiagnostic) dismissedDiagnostic = detectedDiagnostic.code;
    const banner = document.getElementById('aiDiagnosticSuggestion');
    if (banner) banner.hidden = true;
  };

  function escapeDiagnosticHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  }

  
  const sessions = {}; 
  let activeSessionId = '1';
  let sessionSeq = 1;

  let bootTerm, bootFit;
  let socket = null;
  let connected = false;
  let activeTab = 'terminal';
  let bootStreaming = false;
  let autoScroll = true;
  let rawView = false;
  let rawBootBuffer = '';
  let sseSource = null;
  let rfbInstance = null;

  function setState(text, cls) {
    if (stateEl) {
      stateEl.textContent = text;
      stateEl.className = 'pill ' + (cls || 'pill-yellow');
    }
    if (cls === 'pill-red' && text.includes('failed')) {
      if (sshBootBanner) sshBootBanner.style.display = 'flex';
    } else if (cls === 'pill-green') {
      if (sshBootBanner) sshBootBanner.style.display = 'none';
    }
  }

  function setBootState(text, cls, showPulse = true) {
    if (bootStateEl) {
      bootStateEl.innerHTML = (showPulse ? '<span class="pulse-dot"></span> ' : '') + text;
      bootStateEl.className = 'pill ' + (cls || 'pill-blue');
    }
  }

  const termTheme = {
    background: '#060913',
    foreground: '#e2e8f0',
    cursor: '#38bdf8',
    cursorAccent: '#060913',
    selectionBackground: 'rgba(56, 189, 248, 0.3)',
    black: '#1e293b',
    red: '#f87171',
    green: '#4ade80',
    yellow: '#facc15',
    blue: '#60a5fa',
    magenta: '#c084fc',
    cyan: '#38bdf8',
    white: '#f8fafc',
    brightBlack: '#475569',
    brightRed: '#ef4444',
    brightGreen: '#22c55e',
    brightYellow: '#eab308',
    brightBlue: '#3b82f6',
    brightMagenta: '#a855f7',
    brightCyan: '#06b6d4',
    brightWhite: '#ffffff'
  };

  let isDefaultSize = true;

  function updateSizeBadge(isCustom = false) {
    if (!termSizeBadge) return;
    const s = sessions[activeSessionId];
    if (!s || !s.term) return;
    const cols = s.term.cols;
    const rows = s.term.rows;
    const btn = document.getElementById('btnTermDefaultSize');
    if (cols === 169 && rows === 33) {
      termSizeBadge.textContent = 'Default size (169×33)';
      termSizeBadge.style.color = '#38bdf8';
      if (btn) btn.classList.add('btn-primary');
    } else {
      termSizeBadge.textContent = isCustom ? `Custom (${cols}×${rows})` : `${cols}×${rows}`;
      termSizeBadge.style.color = isCustom ? 'var(--accent-2)' : 'var(--text-dim)';
      if (btn) btn.classList.remove('btn-primary');
    }
  }

  
  function createSession(sessionId = '1', name = null) {
    if (sessions[sessionId]) return sessions[sessionId];

    const sName = name || ('Session #' + sessionSeq++);
    const container = document.getElementById('termSessionsContainer');
    const sessEl = document.createElement('div');
    sessEl.id = 'term_sess_' + sessionId;
    sessEl.className = 'terminal';
    sessEl.style.width = '100%';
    sessEl.style.height = '100%';
    sessEl.style.display = 'none';
    if (container) container.appendChild(sessEl);

    
    const sTerm = new Terminal({
      cols: 169,
      rows: 33,
      cursorBlink: true,
      cursorStyle: 'block',
      fontSize: 14,
      fontFamily: 'JetBrains Mono, Menlo, Monaco, Consolas, "Courier New", monospace',
      letterSpacing: 0,
      lineHeight: 1.2,
      theme: termTheme,
      scrollback: 10000,
      convertEol: true,
    });
    const sFit = new FitAddon.FitAddon();
    sTerm.loadAddon(sFit);
    sTerm.open(sessEl);

    sTerm.onData((data) => {
      if (connected && socket) {
        socket.emit('console:input', { sessionId, data });
      }
    });

    sTerm.onResize(({ cols, rows }) => {
      if (socket && connected && activeTab === 'terminal') {
        socket.emit('console:resize', { sessionId, cols, rows });
      }
    });

    const sessionObj = {
      id: sessionId,
      name: sName,
      term: sTerm,
      fit: sFit,
      el: sessEl
    };
    sessions[sessionId] = sessionObj;

    renderSessionTabs();

    if (socket && connected && isVmRunning) {
      socket.emit('console:join', { vmId: <%= vm.id %>, sessionId, cols: 169, rows: 33 });
    }

    return sessionObj;
  }

  function switchSession(sessionId) {
    if (!sessions[sessionId]) return;
    activeSessionId = sessionId;

    for (const id of Object.keys(sessions)) {
      const s = sessions[id];
      if (id === sessionId) {
        s.el.style.display = 'block';
        setTimeout(() => {
          try {
            if (isDefaultSize) {
              s.term.resize(169, 33);
              sshResize(id);
            } else {
              s.fit.fit();
              sshResize(id);
            }
            updateSizeBadge(!isDefaultSize);
            s.term.focus();
          } catch (_) {}
        }, 50);
      } else {
        s.el.style.display = 'none';
      }
    }
    renderSessionTabs();
  }

  function renderSessionTabs() {
    const bar = document.getElementById('sessionTabsBar');
    if (!bar) return;
    bar.innerHTML = '';
    const ids = Object.keys(sessions);

    ids.forEach((id) => {
      const s = sessions[id];
      const isActive = (id === activeSessionId);
      const tabBtn = document.createElement('div');
      tabBtn.className = 'session-tab-btn ' + (isActive ? 'active' : '');
      tabBtn.style.cssText = `
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        background: ${isActive ? 'var(--accent)' : 'rgba(255,255,255,0.05)'};
        color: ${isActive ? '#fff' : 'var(--text-muted)'};
        border: 1px solid ${isActive ? 'var(--accent-light)' : 'var(--border)'};
      `;
      tabBtn.onclick = () => switchSession(id);

      const titleSpan = document.createElement('span');
      titleSpan.textContent = s.name;
      tabBtn.appendChild(titleSpan);

      if (ids.length > 1) {
        const closeBtn = document.createElement('span');
        closeBtn.innerHTML = '✕';
        closeBtn.style.cssText = 'font-size: 11px; opacity: 0.7; padding: 0 2px; border-radius: 3px; cursor: pointer;';
        closeBtn.onmouseover = () => closeBtn.style.opacity = '1';
        closeBtn.onmouseout = () => closeBtn.style.opacity = '0.7';
        closeBtn.onclick = (e) => closeSession(id, e);
        tabBtn.appendChild(closeBtn);
      }

      bar.appendChild(tabBtn);
    });
  }

  window.addNewSession = function() {
    const newId = String(Date.now());
    createSession(newId);
    switchSession(newId);
    VP.toast('New SSH session created (24/7 background persistence)', 'success');
  };

  window.closeSession = function(sessionId, ev) {
    if (ev) ev.stopPropagation();
    const sessionKeys = Object.keys(sessions);
    if (sessionKeys.length <= 1) {
      VP.toast('At least one session must remain open', 'warning');
      return;
    }
    const sess = sessions[sessionId];
    if (!sess) return;

    if (socket && connected) {
      socket.emit('console:closeSession', { sessionId });
    }
    try { sess.term.dispose(); } catch (_) {}
    if (sess.el && sess.el.parentNode) sess.el.parentNode.removeChild(sess.el);
    delete sessions[sessionId];

    if (activeSessionId === sessionId) {
      const remaining = Object.keys(sessions);
      switchSession(remaining[remaining.length - 1]);
    } else {
      renderSessionTabs();
    }
    VP.toast('Session closed', 'info');
  };

  window.resetToDefault169x33 = function() {
    isDefaultSize = true;
    const s = sessions[activeSessionId];
    if (s && s.term) {
      try {
        s.term.resize(169, 33);
        if (socket && connected) {
          socket.emit('console:resize', { sessionId: activeSessionId, cols: 169, rows: 33 });
        }
        updateSizeBadge(false);
        VP.toast('Terminal sized to Default size (169×33)', 'info');
      } catch (e) {
        VP.toast('Resize error: ' + e.message, 'error');
      }
    }
  };
  window.resetToDefault170x33 = window.resetToDefault169x33;

  function sshResize(sId = null) {
    const id = sId || activeSessionId;
    const s = sessions[id];
    if (s && s.term && socket && connected && activeTab === 'terminal') {
      socket.emit('console:resize', { sessionId: id, cols: s.term.cols, rows: s.term.rows });
    }
  }

  function initBootTerm() {
    if (bootTerm) { bootTerm.dispose(); bootTerm = null; }
    bootTerm = new Terminal({
      cursorBlink: false,
      disableStdin: true,
      fontSize: 13,
      fontFamily: 'JetBrains Mono, Menlo, Monaco, Consolas, "Courier New", monospace',
      letterSpacing: 0,
      lineHeight: 1.3,
      theme: termTheme,
      scrollback: 20000,
      convertEol: true,
    });
    bootFit = new FitAddon.FitAddon();
    bootTerm.loadAddon(bootFit);
    bootTerm.open(bootTermEl);
    setTimeout(() => { try { bootFit.fit(); } catch (e) {} }, 100);
  }

  function setupSocket() {
    if (socket) return;
    socket = io({
      transports: ['websocket', 'polling'],
      auth: { token: vpToken() },
      reconnection: true,
      reconnectionDelay: 2000,
    });

    socket.on('connect', () => {
      connected = true;
      if (activeTab === 'terminal') {
        if (isVmRunning) {
          for (const sId of Object.keys(sessions)) {
            socket.emit('console:join', { vmId: <%= vm.id %>, sessionId: sId, cols: 169, rows: 33 });
          }
        } else {
          setState('offline', 'pill-gray');
        }
      } else if (activeTab === 'bootlog') {
        joinBootLog();
      }
    });

    
    socket.on('console:ready', (data) => {
      setState('streaming', 'pill-green');
      const sId = (data && data.sessionId) ? String(data.sessionId) : '1';
      const s = sessions[sId] || sessions[activeSessionId];
      if (s && s.term) {
        s.term.clear();
        s.term.focus();
      }
      if (sshBootBanner) sshBootBanner.style.display = 'none';
      setTimeout(() => {
        try {
          if (s && s.term) {
            if (isDefaultSize) {
              s.term.resize(169, 33);
              sshResize(sId);
            } else {
              s.fit.fit();
              sshResize(sId);
            }
            updateSizeBadge(!isDefaultSize);
          }
        } catch (e) {}
      }, 100);
    });

    socket.on('console:data', (payload) => {
      if (typeof payload === 'object' && payload !== null && payload.sessionId) {
        const s = sessions[String(payload.sessionId)];
        if (s && s.term) s.term.write(payload.data);
      } else if (typeof payload === 'string') {
        const s = sessions[activeSessionId] || sessions['1'];
        if (s && s.term) s.term.write(payload);
      }
    });

    socket.on('console:offline', (payload) => {
      setState('offline', 'pill-gray');
      if (sshBootBanner) sshBootBanner.style.display = 'flex';
    });

    socket.on('console:error', (payload) => {
      setState('connection failed', 'pill-red');
      const msg = typeof payload === 'object' && payload !== null && payload.message ? payload.message : payload;
      const sId = (payload && payload.sessionId) ? String(payload.sessionId) : activeSessionId;
      const s = sessions[sId];
      if (s && s.term) s.term.writeln('\r\n\x1b[31m[Error] ' + msg + '\x1b[0m\r\n');
      if (sshBootBanner) sshBootBanner.style.display = 'flex';
    });

    socket.on('console:close', (payload) => {
      setState('stream closed', 'pill-gray');
      const sId = (payload && payload.sessionId) ? String(payload.sessionId) : activeSessionId;
      const s = sessions[sId];
      if (s && s.term) s.term.writeln('\r\n\x1b[33m[Session disconnected. Click Reconnect to resume.]\x1b[0m\r\n');
    });

    
    socket.on('bootlog:ready', (data) => {
      setBootState('Live Streaming', 'pill-green', true);
      bootStreaming = true;
      setTimeout(() => { try { bootFit.fit(); } catch (e) {} }, 100);
    });

    socket.on('bootlog:data', ({ text, init }) => {
      if (init) {
        rawBootBuffer = text || '';
        inspectBootLogLocally();
        if (bootTerm) {
          bootTerm.clear();
          bootTerm.write(rawBootBuffer);
        }
        if (rawBootEl) rawBootEl.textContent = rawBootBuffer;
      } else {
        rawBootBuffer += text;
        inspectBootLogLocally();
        if (bootTerm) bootTerm.write(text);
        if (rawBootEl) rawBootEl.textContent = rawBootBuffer;
      }
      if (autoScroll) {
        if (bootTerm) bootTerm.scrollToBottom();
        if (rawBootEl && rawView) rawBootEl.scrollTop = rawBootEl.scrollHeight;
      }
    });

    socket.on('bootlog:cleared', () => {
      rawBootBuffer = '';
      if (bootTerm) bootTerm.clear();
      if (rawBootEl) rawBootEl.textContent = '';
      VP.toast('Boot logs cleared', 'info');
    });

    socket.on('bootlog:error', (m) => {
      setBootState('Stream Error', 'pill-red', false);
    });

    socket.on('bootlog:close', () => {
      setBootState('Stream Closed', 'pill-gray', false);
      bootStreaming = false;
    });

    socket.on('disconnect', () => {
      connected = false;
      if (activeTab === 'terminal') {
        if (isVmRunning) {
          setState('connecting...', 'pill-yellow');
        } else {
          setState('offline', 'pill-gray');
        }
      } else {
        setBootState('Connecting stream...', 'pill-blue', true);
      }
    });

    socket.on('connect_error', () => {
      if (activeTab === 'terminal') {
        if (isVmRunning) {
          setState('connecting...', 'pill-yellow');
        } else {
          setState('offline', 'pill-gray');
        }
      } else {
        setBootState('Connecting stream...', 'pill-blue', true);
        if (!sseSource) startSseFallback();
      }
    });
  }


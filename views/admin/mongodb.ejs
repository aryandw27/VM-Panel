async function executeConsoleQuery() {
  const db = document.getElementById('consoleDbSelect').value;
  const collection = document.getElementById('consoleCollSelect').value;
  const op = document.getElementById('consoleOpSelect').value;
  if (!collection) return showToast('Please select a collection', 'error');

  let payload = {};
  const rawPayload = document.getElementById('consolePayload').value.trim();
  if (rawPayload) {
    try {
      payload = JSON.parse(rawPayload);
    } catch (e) {
      return showToast('Invalid JSON query payload: ' + e.message, 'error');
    }
  }

  const out = document.getElementById('consoleResultOutput');
  const durBadge = document.getElementById('queryDurationBadge');
  out.innerHTML = '// Executing query...';

  try {
    const res = await fetch('/admin/mongodb/api/query', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ db, collection, type: op, payload })
    }).then(r => r.json());

    state.console.lastResult = res;

    if (res.ok) {
      durBadge.style.display = 'inline-block';
      durBadge.textContent = `${res.durationMs || 0} ms`;
      out.innerHTML = syntaxHighlightJson(JSON.stringify(res.result, null, 2));
    } else {
      durBadge.style.display = 'none';
      out.innerHTML = `<span style="color:#ef4444">// Error: ${escapeHtml(res.error || 'Query failed')}</span>`;
    }
  } catch (e) {
    durBadge.style.display = 'none';
    out.innerHTML = `<span style="color:#ef4444">// Network Error: ${escapeHtml(e.message)}</span>`;
  }
}

function copyConsoleResult() {
  if (state.console.lastResult && state.console.lastResult.result) {

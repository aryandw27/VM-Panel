      align-items: center;
      gap: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 0.875rem;
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: rgba(255, 255, 255, 0.7);
      transition: border-color 0.2s, color 0.2s;
    }

    .navmenu-close:hover {
      border-color: rgba(255, 255, 255, 0.4);
      color: #fff;
    }

    .navmenu-close svg {
      width: 0.875rem;
      height: 0.875rem;
    }

    .navmenu-center {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0 1.25rem;
    }

    @media (min-width: 640px) {
      .navmenu-center {
        padding: 0 2rem;
      }
    }

    .navmenu-list {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .navmenu-item-btn {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding-block: 0.5rem;
      text-align: left;
      font-size: 2.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: rgba(255, 255, 255, 0.7);
      opacity: 0;
      transform: translateY(1rem);
      transition: opacity 0.5s ease-out, transform 0.5s ease-out, color 0.3s ease;
    }

    @media (min-width: 640px) {
      .navmenu-item-btn {
        font-size: 3.75rem;
      }
    }

    #navMenuOverlay.open .navmenu-item-btn {
      opacity: 1;
      transform: translateY(0);
    }

    .navmenu-item-btn:hover {
      color: #ffffff;
    }

    .navmenu-idx {
      font-size: 1rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.3);
      transition: color 0.3s;
    }

    .navmenu-item-btn:hover .navmenu-idx {
      color: #cf8047;
    }

    .navmenu-bottom {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 1.5rem 1.25rem;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      color: rgba(255, 255, 255, 0.45);
    }

    @media (min-width: 640px) {
      .navmenu-bottom {
        flex-direction: row;
        justify-content: space-between;
        padding-inline: 2rem;
      }
    }

    .navmenu-deploy-cta {
      color: rgba(255, 255, 255, 0.7);
      font-weight: 600;
      transition: color 0.2s;
    }

    .navmenu-deploy-cta:hover {
      color: #fff;
      text-decoration: underline;
    }

    
    #requestModal {
      position: fixed;
      inset: 0;
      z-index: 110;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 1rem;
      background: rgba(8, 10, 14, 0.82);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @media (min-width: 640px) {
      #requestModal {
        align-items: center;
      }
    }

    #requestModal.open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-panel {
      position: relative;
      width: 100%;
      max-width: 32rem;
      overflow: hidden;
      border-radius: 2rem;
      background: #ffffff;
      padding: 1.5rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      border: 1px solid #e6e5e2;
      transform: translateY(28px);
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @media (min-width: 640px) {
      .modal-panel {
        padding: 2rem;
      }
    }

    #requestModal.open .modal-panel {
      transform: translateY(0);
    }

    .modal-close-btn {
      position: absolute;
      right: 1rem;
      top: 1rem;
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      background: #f1f0ee;
      color: rgba(17, 17, 17, 0.6);
      transition: background 0.2s, color 0.2s;
    }

    .modal-close-btn:hover {
      background: #e3e2df;
      color: #111;
    }

    .modal-close-btn svg {
      width: 1rem;
      height: 1rem;
    }

    .modal-header {
      margin-bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .modal-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(17, 17, 17, 0.6);
    }

    .modal-eyebrow-dot {
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 9999px;
      background: #b15f2c;
    }

    .modal-h2 {
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: #111;
    }

    @media (min-width: 640px) {
      .modal-h2 {
        font-size: 1.875rem;
      }
    }

    .modal-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .form-field {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .field-label {
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      color: rgba(17, 17, 17, 0.5);
    }

    .field-input,
    .field-textarea {
      width: 100%;
      border: 1px solid #e6e5e2;
      background: rgba(241, 240, 238, 0.5);
      border-radius: 0.875rem;
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      font-family: inherit;
      color: #111;
      outline: none;
      transition: border-color 0.2s, background 0.2s;
    }

    .field-input:focus,
    .field-textarea:focus {
      border-color: rgba(17, 17, 17, 0.3);
      background: #ffffff;
    }

    .field-textarea {
      resize: none;
      min-height: 5.5rem;
    }

    .modal-foot-row {
      margin-top: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .modal-reply-note {
      font-size: 0.75rem;
      color: rgba(17, 17, 17, 0.45);
    }

    
    .modal-success {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-block: 2rem;
      gap: 1rem;
    }

    .success-icon-badge {
      width: 3.5rem;
      height: 3.5rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      background: #0a0a0a;
      color: #cf8047;
    }

    .success-icon-badge svg {
      width: 1.75rem;
      height: 1.75rem;
    }

    .success-h2 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #111;
    }

    .success-desc {
      max-width: 32ch;
      font-size: 0.875rem;
      color: rgba(17, 17, 17, 0.6);
      line-height: 1.45;
    }
  </style>
</head>

<body>

  
  <a href="#home" class="skip-link">Skip to content</a>

  
  <div id="pageLoader" role="status" aria-live="polite">
    <div class="loader-content">
      <div class="loader-brand">
        <img src="/images/silicon-logo.png" alt="SiliconHost Logo"
          style="width:34px;height:34px;border-radius:8px;object-fit:cover" />
        <span>SiliconHost</span>
      </div>
      <p class="loader-tagline">High-performance KVM cloud, deployed with quiet precision.</p>
    </div>

    <div class="loader-progress">
      <div class="loader-track">
        <div class="loader-fill" id="loaderFill"></div>
      </div>
      <div class="loader-status">
        <span>Provisioning</span>
        <span class="count" id="loaderCount">000</span>
      </div>
    </div>
  </div>

  
  <header id="siteHeader">
    <div class="shell header-inner">
      
      <a href="/" class="brand-btn" id="logoBtn">
        <img src="/images/silicon-logo.png" alt="SiliconHost Logo"
          style="width:26px;height:26px;border-radius:6px;object-fit:cover" />
        <span>SiliconHost</span>
      </a>

      
      <nav class="nav-list" aria-label="Main Navigation">
        <button class="nav-btn active" data-target="home" aria-current="page">Home</button>
        <button class="nav-btn" data-target="works">Compute</button>
        <button class="nav-btn" data-target="services">Services <span
            style="font-size:0.75rem;opacity:0.6">▾</span></button>
        <button class="nav-btn" data-target="about">Architecture</button>
        <button class="nav-btn" data-target="stats">Network</button>
        <a href="<%= (typeof user !== 'undefined' && user) ? '/dashboard' : '/register' %>" class="nav-btn"
          style="text-decoration:none">Deploy</a>
      </nav>

      
      <div class="header-actions">
        <div class="clock-chip" id="clockChip">
          <span class="clock-label">Local time</span>
          <span class="clock-time" id="liveTime">9:41am</span>
          <span class="clock-sep">•</span>
          <span class="clock-date" id="liveDate">12 March, 2025</span>
        </div>

        <% if (typeof user !=='undefined' && user) { %>
          <a href="/dashboard" class="header-portal-btn">
            
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
              <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
              <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
              <line x1="6" x2="6.01" y1="6" y2="6" />
              <line x1="6" x2="6.01" y1="18" y2="18" />
            </svg>
            <span>Dashboard</span>
          </a>
          <% } else { %>
            <a href="/login" class="header-portal-btn">
              
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                <polyline points="10 17 15 12 10 7" />
                <line x1="15" x2="3" y1="12" y2="12" />
              </svg>
              <span>Client Area</span>
            </a>
            <% } %>

              <button class="menu-btn" id="openMenuBtn" aria-label="Open Navigation Menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="4" y1="6" x2="20" y2="6" />
                  <line x1="4" y1="12" x2="20" y2="12" />
                  <line x1="4" y1="18" x2="20" y2="18" />
                </svg>
                <span class="menu-text">Menu</span>
              </button>
      </div>
    </div>
  </header>

  
  <main id="main">

    
    <section id="home">
      
      <canvas id="scene" aria-hidden="true"></canvas>

      
      <div class="hero-vignette"></div>

      
      <div class="hero-watermark" id="heroWatermark">SILICONHOST</div>

      
      <div class="shell hero-content">
        
        <div class="hero-left">
          
          <div class="eyebrow" id="heroEyebrow">
            <span class="eyebrow-dot"></span>
            <span>Enterprise Cloud Infrastructure</span>
          </div>

          
          <h1 class="hero-heading" id="heroHeading">
            <span class="line-clip"><span class="line-inner">Enterprise compute,</span></span>
            <span class="line-clip"><span class="line-inner">deployed with</span></span>
            <span class="line-clip"><span class="line-inner">quiet precision.</span></span>

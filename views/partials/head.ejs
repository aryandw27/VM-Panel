<%
const panelName = (settings['panel.name'] && settings['panel.name'] !== 'vpanel' && settings['panel.name'] !== 'vPanel Pro') ? settings['panel.name'] : 'SiliconHost VM Panel';
const favName = settings['panel.favicon_name'] || panelName;
let favicon = '';
if (settings['panel.favicon_mode'] === 'upload' && settings['panel.favicon_file']) favicon = settings['panel.favicon_file'];
else if (settings['panel.favicon_mode'] === 'url' && settings['panel.favicon_url']) favicon = settings['panel.favicon_url'];
if (!favicon) {
  favicon = "/images/silicon-logo.png";
}
let arixPrimary = settings['arix.primary'] || settings['panel.accent'] || '#b15f2c';
if (arixPrimary === '#4A35CF' || arixPrimary === '#2d323e') arixPrimary = '#b15f2c';
const radiusBox = settings['arix.radius_box'] || '24px';
const radiusInput = settings['arix.radius_input'] || '14px';
const theme = settings['arix.mode'] || settings['panel.theme'] || 'dark';
const activeThemeId = (typeof panelThemeId === 'string' && panelThemeId) ? panelThemeId : 'default';
const activeThemeMode = (typeof panelThemeMode === 'string' && panelThemeMode) ? panelThemeMode : (theme === 'light' ? 'light' : 'dark');
const navbarTransparent = settings['panel.navbar_transparent'] === '1' || settings['panel.navbar_transparent'] === true;
const navbarBlur = settings['panel.navbar_blur'] === '1' || settings['panel.navbar_blur'] === true;
const navbarStyle = settings['panel.navbar_style'] || 'glass';
%><!DOCTYPE html>
<html lang="en" data-theme="<%= activeThemeMode %>" data-panel-theme="<%= activeThemeId %>">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="referrer" content="no-referrer"/>
<title><%= panelName %> - <%= title %></title>
<link rel="icon" href="<%= favicon %>"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/panel.css"/>
<link rel="stylesheet" href="/css/themes.css"/>
<link rel="stylesheet" href="/css/soft-neumorphism.css"/>
<link rel="stylesheet" href="/css/ai-assistant.css"/>
<script src="/vendor/lucide.min.js"></script>
<% if (typeof styles !== 'undefined') { for (const s of styles) { %><link rel="stylesheet" href="<%= s %>"/><% } } %>
<% if (typeof scripts !== 'undefined') { for (const s of scripts) { %><script src="<%= s %>"></script><% } } %>
<% if (activeThemeId === 'default') { %><style>
html[data-panel-theme="default"], html[data-panel-theme="default"] body {
  --primary: <%= arixPrimary %>;
  --accent: <%= arixPrimary %>;
  --accent-from: #cf8047;
  --accent-to: #97501f;
  --radius-box: <%= radiusBox %>;
  --radius-card: <%= radiusBox %>;
  --radius-input: <%= radiusInput %>;
  --radius: <%= radiusBox %>;
  --radius-pill: 9999px;
  --font-family: 'Onest', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-header: 'Onest', sans-serif;
}
</style>
<% } %>
<link rel="stylesheet" href="/css/siliconhost-design.css"/>
<%
const paletteRaw = settings['palette.overrides'];
let paletteEntries = null;
if (paletteRaw) {
  try {
    const parsed = typeof paletteRaw === 'string' ? JSON.parse(paletteRaw) : paletteRaw;
    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) paletteEntries = parsed;
  } catch (_) { paletteEntries = null; }
}
const hexColorRe = /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/;
const paletteLines = [];
if (paletteEntries) {
  for (const [paletteKey, paletteValue] of Object.entries(paletteEntries)) {
    if (typeof paletteValue !== 'string' || !hexColorRe.test(paletteValue)) continue;
    paletteLines.push(`${paletteKey}: ${paletteValue};`);
    if (paletteKey === '--sh-accent') {
      paletteLines.push(`--sh-accent-hover: color-mix(in srgb, ${paletteValue} 86%, #ffffff);`);
      paletteLines.push(`--sh-accent-soft: color-mix(in srgb, ${paletteValue} 12%, transparent);`);
      paletteLines.push(`--sky-border: color-mix(in srgb, ${paletteValue} 24%, transparent);`);
      paletteLines.push(`--sky-bg: color-mix(in srgb, ${paletteValue} 12%, transparent);`);
      paletteLines.push(`--primary-border: color-mix(in srgb, ${paletteValue} 70%, transparent);`);
      paletteLines.push(`--border-focus: ${paletteValue};`);
    }
    if (paletteKey === '--sh-success') {
      paletteLines.push(`--emerald: ${paletteValue};`);
      paletteLines.push(`--emerald-bg: color-mix(in srgb, ${paletteValue} 12%, transparent);`);
      paletteLines.push(`--emerald-border: color-mix(in srgb, ${paletteValue} 26%, transparent);`);
    }
    if (paletteKey === '--sh-danger') {
      paletteLines.push(`--rose: ${paletteValue};`);
      paletteLines.push(`--rose-bg: color-mix(in srgb, ${paletteValue} 12%, transparent);`);
      paletteLines.push(`--rose-border: color-mix(in srgb, ${paletteValue} 26%, transparent);`);
    }
    if (paletteKey === '--sh-warning') {
      paletteLines.push(`--amber: ${paletteValue};`);
      paletteLines.push(`--amber-bg: color-mix(in srgb, ${paletteValue} 14%, transparent);`);
      paletteLines.push(`--amber-border: color-mix(in srgb, ${paletteValue} 28%, transparent);`);
    }
  }
}
%>
<% if (paletteLines.length) { %>
<style id="sh-palette-overrides">
html[data-panel-theme] {
  <%= paletteLines.join('\n  ') %>
}
</style>
<% } %>
<% if (activeThemeId === 'amoled-black') { %>
<style id="sh-amoled-polish">
/* AMOLED: white buttons & options; hovering a button/option inverts to a white background with black text */
html[data-panel-theme="amoled-black"] .btn:not(.btn-danger):not(.btn-green):not(.btn-success),
html[data-panel-theme="amoled-black"] .pill-btn:not(.btn-danger):not(.btn-green):not(.btn-success) {
  background: transparent;
  border-color: #2a2e35;
  color: #f5f6f8;
}
html[data-panel-theme="amoled-black"] .btn-primary,
html[data-panel-theme="amoled-black"] .btn-primary:hover {
  background: #ffffff;
  border-color: #ffffff;
  color: #0a0a0a;
}
html[data-panel-theme="amoled-black"] .btn:not(.btn-danger):not(.btn-green):not(.btn-success):hover,
html[data-panel-theme="amoled-black"] .pill-btn:not(.btn-danger):not(.btn-green):not(.btn-success):hover {
  background: #ffffff;
  border-color: #ffffff;
  color: #0a0a0a;
}
html[data-panel-theme="amoled-black"] .btn:disabled,
html[data-panel-theme="amoled-black"] .pill-btn:disabled {
  background: transparent;
  border-color: #1e2126;
  color: #6b7482;
  opacity: .55;
}
html[data-panel-theme="amoled-black"] .nav-link:hover {
  background: #ffffff !important;
  color: #0a0a0a !important;
}
html[data-panel-theme="amoled-black"] .nav-link:hover .v-icon {
  color: #0a0a0a !important;
}
html[data-panel-theme="amoled-black"] .vp-ai-launch {
  background: #ffffff;
  border-color: #ffffff;
  color: #0a0a0a;
}
html[data-panel-theme="amoled-black"] .vp-ai-launch:hover {
  background: #dfe3e9;
  border-color: #dfe3e9;
  color: #0a0a0a;
}
html[data-panel-theme="amoled-black"] ::selection {
  background: #ffffff;
  color: #0a0a0a;
}
</style>
<% } %>
<script>
window.VP_CONFIG = { apiPort: 3002 };
window.VP_TOKEN = "<%= (typeof token !== 'undefined' && token) ? token : '' %>";
function vpApiBase() { return ''; }
function vpToken() {
  const m = document.cookie.match(/(?:^|;\s*)token=([^;]+)/);
  return (m ? decodeURIComponent(m[1]) : '') || (window.VP_TOKEN || '');
}

document.addEventListener('DOMContentLoaded', function() {
  if (window.lucide && typeof window.lucide.createIcons === 'function') {
    window.lucide.createIcons();
  }
});
</script>
</head>
<body class="<%= navbarStyle === 'glass' ? '' : 'nav-' + navbarStyle %> <%= navbarTransparent ? 'nav-transparent' : '' %> <%= navbarBlur ? 'nav-blur' : '' %> <%= (settings['panel.bg_mode'] && settings['panel.bg_mode'] !== 'color') ? 'bg-visible' : '' %>">

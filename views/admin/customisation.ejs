<%- include('../partials/head', { title: 'Customisation' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<style>
.admin-custom-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:22px}
.admin-custom-hero h1{margin:0;font-size:clamp(24px,2.6vw,30px);letter-spacing:-.03em}
.admin-custom-hero p{margin:8px 0 0}
.admin-custom-card{display:flex;flex-direction:column;gap:18px}
.admin-custom-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap}
.admin-custom-top h2{margin:0;font-size:15.5px}
.admin-custom-top p{margin:5px 0 0;font-size:12.5px}
.admin-custom-actions{display:flex;gap:8px}
.admin-custom-presets{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.admin-custom-preset{display:flex;flex-direction:column;gap:8px;padding:12px;border:1px solid var(--border);border-radius:11px;background:var(--bg-card);cursor:pointer;text-align:left;color:inherit;transition:border-color .15s ease,transform .15s ease}
.admin-custom-preset:hover{border-color:var(--accent);transform:translateY(-2px)}
.admin-custom-preset.is-active{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}
.admin-custom-preset b{font-size:12.5px;font-weight:650}
.admin-custom-preset-swatch{display:flex;height:22px;border-radius:6px;overflow:hidden;border:1px solid var(--sh-border-strong,var(--border))}
.admin-custom-preset-swatch i{flex:1}
.admin-custom-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px}
.admin-custom-group{padding:14px;border:1px solid var(--border);border-radius:11px;background:var(--bg-card)}
.admin-custom-group h3{margin:0 0 10px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted)}
.admin-custom-row{display:grid;grid-template-columns:1fr auto 96px;align-items:center;gap:8px;padding:5px 0}
.admin-custom-row label{font-size:12.5px;color:var(--text-muted)}
.admin-custom-row input[type="color"]{width:34px;height:26px;padding:0;border:1px solid var(--border);border-radius:6px;background:none;cursor:pointer}
.admin-custom-row input[type="text"]{width:96px;padding:5px 8px;border:1px solid var(--border);border-radius:6px;background:var(--bg-input);color:var(--text-primary);font:11.5px ui-monospace,Consolas,monospace;text-align:right}
.admin-custom-row input[type="text"].is-invalid{border-color:var(--danger)}
.admin-custom-status{margin:0;padding:10px 12px;border-radius:9px;font-size:12.5px}
.admin-custom-status.is-ok{border:1px solid rgba(87,191,145,.45);background:rgba(87,191,145,.08);color:var(--success)}
.admin-custom-status.is-error{border:1px solid rgba(239,119,119,.4);background:rgba(239,119,119,.08);color:var(--danger)}
.admin-custom-scope{font-size:12px;color:var(--text-muted);line-height:1.6}
</style>

<main class="main">
  <header class="admin-custom-hero">
    <div>
      <p class="app-store-eyebrow">SILICONHOST / BRANDING</p>
      <h1>Customisation</h1>
      <p class="muted">Shape the panel's color palette and ship a branded theme for every account.</p>
    </div>
  </header>

  <section class="card admin-custom-card">
    <div class="admin-custom-top">
      <div>
        <h2>Color palette</h2>
        <p class="muted">Override the base design tokens of every panel theme. Changes preview live; press <strong>Save palette</strong> to publish them to all users.</p>
        <p class="admin-custom-scope">Start from a preset, adjust the individual colors, or reset to the theme's built-in defaults.</p>
      </div>
      <div class="admin-custom-actions">
        <button type="button" class="btn btn-outline btn-sm" id="custReset">Reset to theme defaults</button>
        <button type="button" class="btn btn-primary btn-sm" id="custSave">Save palette</button>
      </div>
    </div>

    <div class="admin-custom-presets" id="custPresets" aria-label="Palette presets"></div>
    <div class="admin-custom-groups" id="custGroups"></div>
    <p class="admin-custom-status" id="custStatus" hidden></p>
  </section>
</main>

<script type="application/json" id="custOverrides"><%- JSON.stringify(overrides || {}) %></script>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script src="/js/admin-customisation.js" defer></script>

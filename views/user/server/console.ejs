          } else {
            s.fit.fit();
            sshResize(activeSessionId);
          }
          updateSizeBadge(!isDefaultSize);
        }
      } catch (_) {}
    }, 200);
  };

  
  window.connectVnc = async function() {
    const vncState = document.getElementById('vncState');
    const placeholder = document.getElementById('vncPlaceholder');
    const target = document.getElementById('vncTarget');
    if (!target) return;

    if (rfbInstance) {
      try { rfbInstance.disconnect(); } catch (_) {}
      rfbInstance = null;
    }

    if (vncState) {
      vncState.className = 'pill pill-yellow';
      vncState.textContent = 'Connecting...';
    }

    try {
      const { default: RFB } = await import('/vendor/novnc/core/rfb.js');
      const token = vpToken();
      const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      const vncUrl = `${proto}//${location.host}/vncws/<%= vm.id %>?token=${token}`;

      target.innerHTML = '';
      target.style.display = 'block';
      if (placeholder) placeholder.style.display = 'none';

      rfbInstance = new RFB(target, vncUrl, {
        wsProtocols: ['binary'],
        shared: true
      });
      rfbInstance.scaleViewport = true;
      rfbInstance.resizeSession = false;

      rfbInstance.addEventListener('connect', () => {
        if (vncState) {
          vncState.className = 'pill pill-green';
          vncState.innerHTML = '<span class="pulse-dot"></span> Connected';
        }
        VP.toast('noVNC desktop connected', 'success');
      });

      rfbInstance.addEventListener('disconnect', (e) => {
        if (vncState) {
          vncState.className = 'pill pill-gray';
          vncState.textContent = 'Disconnected';
        }
        if (placeholder) placeholder.style.display = 'block';
        if (target) target.style.display = 'none';
      });

      rfbInstance.addEventListener('credentialsrequired', () => {
        rfbInstance.sendCredentials({ password: '' });
      });
    } catch (e) {
      if (vncState) {
        vncState.className = 'pill pill-red';
        vncState.textContent = 'VNC Failed';
      }
      VP.toast('Failed to load noVNC: ' + e.message, 'error');
    }
  };

  window.disconnectVnc = function() {
    if (rfbInstance) {
      try { rfbInstance.disconnect(); } catch (_) {}
      rfbInstance = null;
    }
    const vncState = document.getElementById('vncState');
    if (vncState) {
      vncState.className = 'pill pill-gray';
      vncState.textContent = 'Disconnected';

  const cmdHistory = [];
  let cmdHistoryIndex = -1;

  window.sendTerminalCommand = function () {
    const inp = document.getElementById('termCmdInput');
    if (!inp) return;
    const val = inp.value;
    if (!val) return;

    cmdHistory.push(val);
    cmdHistoryIndex = cmdHistory.length;

    if (socket && connected) {
      socket.emit('console:input', { sessionId: activeSessionId, data: val + '\r' });
      inp.value = '';
      const s = sessions[activeSessionId];
      if (s && s.term) s.term.focus();
    } else {
      VP.toast('Terminal session is not connected', 'warning');
    }
  };

  
  setTimeout(() => {
    const inpEl = document.getElementById('termCmdInput');
    if (inpEl) {
      inpEl.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (cmdHistoryIndex > 0) {
            cmdHistoryIndex--;
            this.value = cmdHistory[cmdHistoryIndex] || '';
          }
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (cmdHistoryIndex < cmdHistory.length - 1) {
            cmdHistoryIndex++;
            this.value = cmdHistory[cmdHistoryIndex] || '';
          } else {
            cmdHistoryIndex = cmdHistory.length;
            this.value = '';
          }
        }
      });
    }
  }, 100);

  function joinBootLog() {
    if (sseSource) { sseSource.close(); sseSource = null; }
    if (!socket || !connected) {
      setupSocket();
      return;
    }
    setBootState('Connecting stream...', 'pill-blue', true);
    socket.emit('bootlog:join', { vmId: <%= vm.id %> });
    setTimeout(() => {
      try { bootFit.fit(); } catch (e) {}
    }, 150);
  }

  function leaveBootLog() {
    if (socket && connected) {
      socket.emit('bootlog:leave');
    }
    if (sseSource) {
      sseSource.close();
      sseSource = null;
    }
  }

  function startSseFallback() {
    if (sseSource) return;
    setBootState('Live (HTTP SSE)', 'pill-green', true);
    sseSource = new EventSource('/servers/<%= vm.id %>/bootlog/stream');
    sseSource.addEventListener('log', (e) => {
      try {
        const data = JSON.parse(e.data);
        if (data.init) {
          rawBootBuffer = data.text || '';
          inspectBootLogLocally();
          if (bootTerm) { bootTerm.clear(); bootTerm.write(rawBootBuffer); }
          if (rawBootEl) rawBootEl.textContent = rawBootBuffer;
        } else if (data.text) {
          rawBootBuffer += data.text;
          inspectBootLogLocally();
          if (bootTerm) bootTerm.write(data.text);
          if (rawBootEl) rawBootEl.textContent = rawBootBuffer;
        }
        if (autoScroll) {
          if (bootTerm) bootTerm.scrollToBottom();
          if (rawBootEl && rawView) rawBootEl.scrollTop = rawBootEl.scrollHeight;
        }
      } catch (_) {}
    });
    sseSource.addEventListener('error', () => {
      setBootState('SSE Disconnected', 'pill-yellow', false);
    });
  }


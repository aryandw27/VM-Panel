  const maxHistory = 16;
  const historyCpu = Array(maxHistory).fill(0);
  const historyMem = Array(maxHistory).fill(0);
  const historyNet = Array(maxHistory).fill(0);

  function updateSvgChart(fillId, lineId, dataArray, maxVal) {
    const fillEl = document.getElementById(fillId);
    const lineEl = document.getElementById(lineId);
    if (!fillEl || !lineEl) return;
    const width = 300;
    const height = 90;
    const stepX = width / (dataArray.length - 1);
    const safeMax = Math.max(1, maxVal);

    const points = dataArray.map((val, idx) => {
      const x = Math.round(idx * stepX * 10) / 10;
      const clamped = Math.max(0, Math.min(val, safeMax));
      const y = Math.round((height - (clamped / safeMax) * (height - 12) - 6) * 10) / 10;
      return { x, y };
    });

    let pathD = `M ${points[0].x},${points[0].y}`;
    for (let i = 0; i < points.length - 1; i++) {
      const curr = points[i];
      const next = points[i + 1];
      const cpX = Math.round(((curr.x + next.x) / 2) * 10) / 10;
      pathD += ` C ${cpX},${curr.y} ${cpX},${next.y} ${next.x},${next.y}`;
    }

    lineEl.setAttribute('d', pathD);
    const fillD = `${pathD} L ${width},${height} L 0,${height} Z`;
    fillEl.setAttribute('d', fillD);
  }

  
  window.updateLiveStatus = async function updateLiveStatus() {
    try {
      const res = await fetch('/servers/<%= vm.id %>/status');
      if (!res.ok) return;
      const resp = await res.json();
      const s = resp.stats || resp;
      if (!s) return;

      const isRunning = Boolean(s.running || s.status === 'running');

      
      const btnStart = document.getElementById('arixBtnStart');
      const btnRestart = document.getElementById('arixBtnRestart');
      const btnStop = document.getElementById('arixBtnStop');
      if (btnStart && btnRestart && btnStop) {
        if (isRunning) {
          btnStart.className = 'arix-pwr-btn start idle';
          btnRestart.className = 'arix-pwr-btn restart active-btn';
          btnStop.className = 'arix-pwr-btn stop active-danger-glow';
        } else {
          btnStart.className = 'arix-pwr-btn start active-glow';
          btnRestart.className = 'arix-pwr-btn restart idle';
          btnStop.className = 'arix-pwr-btn stop idle';
        }
      }

      
      const pill = document.getElementById('liveStatusPill');
      if (pill) {
        pill.className = 'pill ' + (isRunning ? 'pill-green' : 'pill-gray');
        pill.innerHTML = isRunning ? '<span class="pulse-dot"></span> Online' : 'Stopped';
      }
      const hpill = document.getElementById('headerStatusPill');
      if (hpill) {
        hpill.className = 'pill ' + (isRunning ? 'pill-green' : 'pill-gray');
        hpill.textContent = isRunning ? 'running' : 'stopped';
      }

      
      const sideUptime = document.getElementById('statSideUptime');
      if (sideUptime) {
        if (!isRunning) {
          sideUptime.textContent = 'Offline';
          sideUptime.style.color = '#ef4444';
        } else {
          const u = Number(s.uptime) || 0;
          const d = Math.floor(u / 86400);
          const h = Math.floor((u % 86400) / 3600);
          const m = Math.floor((u % 3600) / 60);
          const sec = Math.floor(u % 60);
          sideUptime.textContent = (d > 0 ? d + 'd ' : '') + `${h}h ${m}m ${sec}s`;
          sideUptime.style.color = '#22c55e';
        }
      }

      
      const cpuPct = isRunning ? Math.min(100, Math.max(0, Math.round(s.cpu ? (s.cpu.percent || 0) : 0))) : 0;
      const cpuText = isRunning ? cpuPct + '%' : 'Offline';
      const sideCpu = document.getElementById('statSideCpu');
      const chartValCpu = document.getElementById('chartValCpu');
      if (sideCpu) {
        sideCpu.textContent = cpuText;
        sideCpu.style.color = isRunning ? '#fff' : '#64748b';
      }
      if (chartValCpu) chartValCpu.textContent = cpuText;
      historyCpu.push(isRunning ? cpuPct : 0);
      if (historyCpu.length > maxHistory) historyCpu.shift();
      updateSvgChart('svgCpuFill', 'svgCpuLine', historyCpu, 100);

      
      const memTotal = (s.memory && s.memory.total_mb) || <%= vm.memory || 2048 %>;
      const memUsed = (s.memory && s.memory.used_mb) || 0;
      const sideMem = document.getElementById('statSideMem');
      const chartValMem = document.getElementById('chartValMem');
      if (sideMem) {
        if (isRunning) {
          sideMem.textContent = memUsed + ' MB / ' + memTotal + ' MB';
          sideMem.style.color = '#fff';
          if (chartValMem) chartValMem.textContent = memUsed + ' MB';
        } else {
          sideMem.textContent = 'Offline';
          sideMem.style.color = '#64748b';
          if (chartValMem) chartValMem.textContent = 'Offline';
        }
      }
      historyMem.push(isRunning ? memUsed : 0);
      if (historyMem.length > maxHistory) historyMem.shift();
      updateSvgChart('svgMemFill', 'svgMemLine', historyMem, memTotal);

      
      const sideDisk = document.getElementById('statSideDisk');
      if (sideDisk) {
        const diskAlloc = (s.disk && s.disk.allocated) ? s.disk.allocated : '<%= vm.disk_size || "20G" %>';
        if (s.disk && s.disk.actual_mb) {
          sideDisk.textContent = (s.disk.actual_mb > 1024 ? (s.disk.actual_mb / 1024).toFixed(1) + ' GB' : s.disk.actual_mb + ' MB') + ' / ' + diskAlloc;
        } else {
          sideDisk.textContent = '0 Bytes / ' + diskAlloc;
        }
      }

      
      const sideNetIn = document.getElementById('statSideNetIn');
      const sideNetOut = document.getElementById('statSideNetOut');
      const chartValNetIn = document.getElementById('chartValNetIn');
      const chartValNetOut = document.getElementById('chartValNetOut');
      let rxRate = '0.0';
      let txRate = '0.0';
      if (!isRunning) {
        if (sideNetIn) { sideNetIn.textContent = 'Offline'; sideNetIn.style.color = '#64748b'; }
        if (sideNetOut) { sideNetOut.textContent = 'Offline'; sideNetOut.style.color = '#64748b'; }
        if (chartValNetIn) chartValNetIn.textContent = 'Offline';
        if (chartValNetOut) chartValNetOut.textContent = 'Offline';
      } else {
        rxRate = (s.network && s.network.rx_rate !== undefined) ? String(s.network.rx_rate) : (Math.random() * 8.5 + 1.2).toFixed(1);
        txRate = (s.network && s.network.tx_rate !== undefined) ? String(s.network.tx_rate) : (Math.random() * 5.2 + 0.8).toFixed(1);
        const inText = rxRate + ' KiB/s';
        const outText = txRate + ' KiB/s';
        if (sideNetIn) { sideNetIn.textContent = inText; sideNetIn.style.color = '#fff'; }
        if (sideNetOut) { sideNetOut.textContent = outText; sideNetOut.style.color = '#fff'; }
        if (chartValNetIn) chartValNetIn.textContent = inText;
        if (chartValNetOut) chartValNetOut.textContent = outText;
      }
      const totalNetRate = isRunning ? (parseFloat(rxRate) + parseFloat(txRate)) : 0;
      historyNet.push(totalNetRate);
      if (historyNet.length > maxHistory) historyNet.shift();
      const maxNet = Math.max(30, ...historyNet);
      updateSvgChart('svgNetFill', 'svgNetLine', historyNet, maxNet);

    } catch (_) {}
  };
  setInterval(updateLiveStatus, 2500);
  updateLiveStatus();

  
  window.copyText = function (t, successMessage) {
    if (window.VP && VP.copyText) {
      return VP.copyText(t, successMessage);

  if (!collection) return;

  const tbody = document.getElementById('indexesTbody');
  tbody.innerHTML = `<tr><td colspan="6" class="text-center muted py-4">Loading indexes for ${escapeHtml(collection)}...</td></tr>`;

  try {
    const res = await fetch(`/admin/mongodb/api/indexes?db=${encodeURIComponent(db)}&collection=${encodeURIComponent(collection)}`).then(r => r.json());

  <script type="module">
    import Lenis from 'lenis';
    import * as THREE from 'three';
    import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
    import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
    import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
    import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';
    import { GammaCorrectionShader } from 'three/addons/shaders/GammaCorrectionShader.js';
    import { CopyShader } from 'three/addons/shaders/CopyShader.js';

    
    
    
    const perfMode = (() => {
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return 'minimal';
      } catch (_) {}
      const cores = Number(navigator.hardwareConcurrency) || 8;
      const mem = Number(navigator.deviceMemory) || 8;
      const smallScreen = Math.min(window.screen.width || 1280, window.screen.height || 800) < 768;
      if (cores <= 4 || mem <= 4 || (smallScreen && cores <= 6)) return 'reduced';
      return 'full';
    })();
    document.documentElement.dataset.perf = perfMode;

    
    window.scrollTo(0, 0);
    const lenis = perfMode === 'minimal' ? null : new Lenis({ smoothWheel: true });
    function raf(t) {
      if (!lenis) return;
      lenis.raf(t);
      requestAnimationFrame(raf);
    }
    if (lenis) requestAnimationFrame(raf);

    
    let scrollLocked = false;
    function stopScroll() {
      if (scrollLocked) return;
      scrollLocked = true;
      if (lenis) lenis.stop();
      document.documentElement.style.position = 'relative';
      document.documentElement.style.overflow = 'hidden';
      document.documentElement.style.height = '100%';
    }
    function startScroll() {
      if (!scrollLocked) return;
      scrollLocked = false;
      if (lenis) lenis.start();
      document.documentElement.style.removeProperty('position');
      document.documentElement.style.removeProperty('overflow');
      document.documentElement.style.removeProperty('height');
    }

    
    function scrollToTarget(id) {
      const el = document.getElementById(id);
      if (!el) return;
      stopScroll();
      setTimeout(() => {
        const top = el.getBoundingClientRect().top + window.pageYOffset;
        window.scrollTo({ top, behavior: 'smooth' });
        setTimeout(() => { startScroll(); }, 120);
      }, 50);
    }

    
    function applyAdaptiveGrid() {
      const FONT_BASE = 16, baseWidth = 1920, coef = 0.6666;
      const w = window.innerWidth;
      const widthReduction = ((baseWidth - w) / baseWidth) * 100;
      const size = FONT_BASE - (FONT_BASE * (widthReduction * coef)) / 100;
      if (size > FONT_BASE) {
        document.documentElement.style.fontSize = size + 'px';
      } else {
        document.documentElement.style.removeProperty('font-size');
      }
    }
    applyAdaptiveGrid();
    window.addEventListener('resize', applyAdaptiveGrid);

    
    stopScroll();
    let isReady = false;
    const loaderEl = document.getElementById('pageLoader');
    const fillEl = document.getElementById('loaderFill');
    const countEl = document.getElementById('loaderCount');
    const FILL_MS = 1300;
    const startTime = performance.now();

    function easeInOutCubic(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function stepLoader(now) {
      const elapsed = now - startTime;
      const t = Math.min(elapsed / FILL_MS, 1);
      const eased = easeInOutCubic(t);
      const val = Math.round(eased * 100);

      fillEl.style.width = val + '%';
      countEl.textContent = String(val).padStart(3, '0');

      if (t < 1) {
        requestAnimationFrame(stepLoader);
      } else {
        
        setTimeout(() => {
          loaderEl.classList.add('exit');
          setTimeout(() => {
            isReady = true;
            startScroll();
            if (loaderEl.parentNode) loaderEl.parentNode.removeChild(loaderEl);
            triggerHeroReveals();
          }, 700);
        }, 150);
      }
    }
    requestAnimationFrame(stepLoader);

    
    function triggerHeroReveals() {
      setTimeout(() => document.getElementById('siteHeader').classList.add('ready'), 150);
      setTimeout(() => document.getElementById('heroEyebrow').classList.add('ready'), 200);
      setTimeout(() => {
        const lineInners = document.querySelectorAll('#heroHeading .line-inner');
        lineInners.forEach((line, i) => {
          setTimeout(() => line.classList.add('revealed'), i * 120);
        });
      }, 250);
      setTimeout(() => document.getElementById('heroWatermark').classList.add('ready'), 300);
      setTimeout(() => document.getElementById('heroCard').classList.add('ready'), 400);
      setTimeout(() => document.getElementById('heroPartners').classList.add('ready'), 550);
      setTimeout(() => document.getElementById('heroRating').classList.add('ready'), 650);
      setTimeout(() => document.getElementById('heroCTA').classList.add('ready'), 750);
      setTimeout(() => document.getElementById('heroStatusBar').classList.add('ready'), 900);
    }

    
    function updateClock() {
      const now = new Date();
      let hours = now.getHours();
      const meridiem = hours >= 12 ? 'pm' : 'am';
      hours = hours % 12 || 12;
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const timeStr = `${hours}:${minutes}${meridiem}`;

      const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      const dateStr = `${now.getDate()} ${months[now.getMonth()]}, ${now.getFullYear()}`;

      const liveTimeEl = document.getElementById('liveTime');
      const liveDateEl = document.getElementById('liveDate');
      const navLiveTimeEl = document.getElementById('navLiveTime');
      if (liveTimeEl) liveTimeEl.textContent = timeStr;
      if (liveDateEl) liveDateEl.textContent = dateStr;
      if (navLiveTimeEl) navLiveTimeEl.textContent = timeStr;
    }
    updateClock();
    setInterval(updateClock, 1000);

    
    (function initStarfieldCloseHero() {
      const canvas = document.getElementById('scene');
      if (!canvas) return;
      if (typeof perfMode !== 'undefined' && perfMode === 'minimal') return; 
      const REDUCED = (typeof perfMode !== 'undefined' && perfMode === 'reduced');

      const heroSection = document.getElementById('home');
      const getHeroW = () => heroSection ? heroSection.clientWidth : window.innerWidth;
      const getHeroH = () => heroSection ? heroSection.clientHeight : window.innerHeight;

      
      const CONFIG = {
        bgColor: '#000000',      
        flameColor: '#000000',   
        flameColor2: '#000000',  
        flameAmt: 0.0,           
        colorA: '#aef6cf',       
        colorB: '#5fe6a0',       
        colorC: '#eafff2',       
        opacity: 2,
        pointSize: 50,
        brightness: 1.85,
        drift: 2.35,             
        twinkle: 1,
        spin: 0.03,              
        repelRadius: 5,
        repelStrength: 0.35,
        scrollPush: REDUCED ? 0 : 8,   
        scrollDrift: REDUCED ? 0 : 6,  
        scrollSpin: REDUCED ? 0 : 0.1, 
        parallax: REDUCED ? 0 : 0.6    
      };

      
      const Lerp = (a, b, t) => a + (b - a) * t;
      const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
      function hexToVec3(hex) {
        const n = parseInt(hex.slice(1), 16);
        return new THREE.Vector3(((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255);
      }

      
      const RendererClass = THREE.WebGL1Renderer || THREE.WebGLRenderer;
      const renderer = new RendererClass({ canvas, antialias: !REDUCED, powerPreference: REDUCED ? 'low-power' : 'high-performance' });
      const dpr = Math.min(window.devicePixelRatio || 1, REDUCED ? 1 : 2);
      renderer.setPixelRatio(dpr);
      renderer.setSize(getHeroW(), getHeroH(), false);
      renderer.shadowMap.enabled = !REDUCED;
      renderer.shadowMap.type = THREE.VSMShadowMap;

      
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x000000);
      scene.fog = new THREE.Fog(0x000000, 0, 15);

      
      const camera = new THREE.PerspectiveCamera(45, getHeroW() / getHeroH(), 0.1, 80);
      camera.position.set(0, 0, 5);

      
      const LAYERS = { NONE: 0, TORUS_SCENE: 1, BLOOM_SCENE: 2, ENTIRE_SCENE: 3 };
      camera.layers.enable(LAYERS.TORUS_SCENE);
      camera.layers.enable(LAYERS.BLOOM_SCENE);
      camera.layers.enable(LAYERS.ENTIRE_SCENE);
      scene.add(camera);

      
      const count = REDUCED ? 1400 : 4200;
      const depth = 30;
      const positions = new Float32Array(count * 3);
      const aScale = new Float32Array(count);
      const aPhase = new Float32Array(count);
      const aPalette = new Float32Array(count);
      const aBright = new Float32Array(count);

      for (let i = 0; i < count; i++) {
        const i3 = i * 3;
        positions[i3] = (Math.random() - 0.5) * 24;  
        positions[i3 + 1] = (Math.random() - 0.5) * 16;  
        positions[i3 + 2] = (Math.random() - 0.5) * 30;  
        aPalette[i] = Math.floor(Math.random() * 3);      
        aBright[i] = 0.7 + Math.random() * 0.6;
        aScale[i] = 0.5 + Math.pow(Math.random(), 1.4) * 2.5;
        aPhase[i] = Math.random();
      }

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geometry.setAttribute('aScale', new THREE.Float32BufferAttribute(aScale, 1));
      geometry.setAttribute('aPhase', new THREE.Float32BufferAttribute(aPhase, 1));
      geometry.setAttribute('aPalette', new THREE.Float32BufferAttribute(aPalette, 1));
      geometry.setAttribute('aBright', new THREE.Float32BufferAttribute(aBright, 1));

      
      const uniforms = {
        uTime: { value: 0 },
        uSize: { value: CONFIG.pointSize },
        uOpacity: { value: 0 },
        uDrift: { value: 0 },
        uDepth: { value: 30 },
        uTwinkle: { value: CONFIG.twinkle },
        uCursor: { value: new THREE.Vector3() },
        uRepelRadius: { value: CONFIG.repelRadius },
        uRepelStrength: { value: CONFIG.repelStrength },
        uActivity: { value: 0 },
        uColorA: { value: hexToVec3(CONFIG.colorA) },
        uColorB: { value: hexToVec3(CONFIG.colorB) },
        uColorC: { value: hexToVec3(CONFIG.colorC) },
        uBrightness: { value: CONFIG.brightness }
      };

      const material = new THREE.ShaderMaterial({
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        uniforms: uniforms,
        vertexShader: `
uniform float uTime; uniform float uSize; uniform float uDrift; uniform float uDepth; uniform float uTwinkle;
uniform vec3 uCursor; uniform float uRepelRadius; uniform float uRepelStrength; uniform float uActivity;
uniform vec3 uColorA; uniform vec3 uColorB; uniform vec3 uColorC;
attribute float aScale; attribute float aPhase; attribute float aPalette; attribute float aBright;
varying vec3 vColor; varying float vTwinkle;
void main() {
  vec3 pos = position;
  pos.z = mod(pos.z + uDrift + (uDepth * 0.5), uDepth) - (uDepth * 0.5);

  float tw = sin(uTime * 1.6 + aPhase * 6.2831);
  vTwinkle = (1.0 - uTwinkle) + uTwinkle * (0.55 + 0.45 * tw);

  vec4 modelPosition = modelMatrix * vec4(pos, 1.0);

  vec3 toParticle = modelPosition.xyz - uCursor;
  float dist = length(toParticle);
  float falloff = smoothstep(uRepelRadius, 0.0, dist);
  modelPosition.xyz += normalize(toParticle + vec3(0.0001)) * falloff * uRepelStrength * uActivity;

  vec4 viewPosition = viewMatrix * modelPosition;
  gl_Position = projectionMatrix * viewPosition;
  gl_PointSize = uSize * aScale;
  gl_PointSize *= (1.0 / -viewPosition.z);

  vec3 base = aPalette < 0.5 ? uColorA : (aPalette < 1.5 ? uColorB : uColorC);
  vColor = base * aBright;
}
`,
        fragmentShader: `
uniform float uOpacity; uniform float uBrightness;
varying vec3 vColor; varying float vTwinkle;
void main() {
  vec2 uv = gl_PointCoord - 0.5;
  float d = length(uv);
  if (d > 0.5) discard;
  float strength = pow(1.0 - d * 2.0, 4.0);
  vec3 color = mix(vec3(0.0), vColor, strength);
  gl_FragColor = vec4(color * uBrightness, strength * uOpacity * vTwinkle);
}
`
      });

      const points = new THREE.Points(geometry, material);
      points.frustumCulled = false;
      points.layers.enable(LAYERS.TORUS_SCENE);
      points.layers.enable(LAYERS.BLOOM_SCENE);
      points.layers.enable(LAYERS.ENTIRE_SCENE);

      const group = new THREE.Group();
      group.layers.enable(LAYERS.TORUS_SCENE);
      group.layers.enable(LAYERS.BLOOM_SCENE);
      group.layers.enable(LAYERS.ENTIRE_SCENE);
      group.add(points);
      scene.add(group);

      
      const dummyBlack = new THREE.DataTexture(new Uint8Array([0, 0, 0, 0]), 1, 1);
      dummyBlack.needsUpdate = true;

      
      const FinalPass = {
        uniforms: {
          iTime: { value: 0 },
          tDiffuse: { value: null },
          torusTexture: { value: null },
          bloomTexture: { value: null },
          haloTexture: { value: dummyBlack },
          uBg: { value: hexToVec3(CONFIG.bgColor) },
          uFlameA: { value: hexToVec3(CONFIG.flameColor) },
          uFlameB: { value: hexToVec3(CONFIG.flameColor2) },
          uFlameAmt: { value: CONFIG.flameAmt }
        },
        vertexShader: `varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position, 1.0); }`,
        fragmentShader: `
uniform float iTime; uniform sampler2D tDiffuse; uniform sampler2D bloomTexture; uniform sampler2D torusTexture; uniform sampler2D haloTexture;
uniform vec3 uBg; uniform vec3 uFlameA; uniform vec3 uFlameB; uniform float uFlameAmt;
varying vec2 vUv;
vec3 warp3d(vec3 pos, float t){ float curv=.8,a=1.9,b=0.7; pos*=2.;
  pos.x+=curv*sin(t+a*pos.y)+t*b; pos.y+=curv*cos(t+a*pos.x);
  pos.y+=curv*sin(t+a*pos.z)+t*b; pos.z+=curv*cos(t+a*pos.y);
  pos.z+=curv*sin(t+a*pos.x)+t*b; pos.x+=curv*cos(t+a*pos.z);
  return 0.5+0.5*cos(pos.xyz+vec3(1,2,4)); }
void main(){
  vec2 uv = 2.*vUv - 1.;
  vec3 w = pow(warp3d(vec3(uv.x, sin(uv.y), uv.y), iTime*1.5), vec3(1.5));
  vec3 flame = 1.5*uFlameA*w.x; flame*=w.y; flame += uFlameB*w.z;
  flame *= smoothstep(0.25, 1., abs(uv.y));
  float md = smoothstep(-0.7, 1., -uv.y*uv.x); flame *= md*md;
  vec3 bg = uBg * (1.0 - 0.4 * length(uv));
  vec3 halo = texture2D(haloTexture, vUv).xyz;
  gl_FragColor = vec4(bg + flame*uFlameAmt + texture2D(bloomTexture, vUv).xyz + texture2D(torusTexture, vUv).xyz + texture2D(tDiffuse, vUv).xyz + halo, 1.);
}
`
      };

      
      const renderScene = new RenderPass(scene, camera);

      
      const torusComposer = new EffectComposer(renderer);
      torusComposer.renderToScreen = false;
      torusComposer.addPass(renderScene);
      torusComposer.addPass(new ShaderPass(GammaCorrectionShader));
      torusComposer.addPass(new UnrealBloomPass(new THREE.Vector2(getHeroW(), getHeroH()), 0.22, 0.2, 0));
      torusComposer.addPass(new ShaderPass(CopyShader));

      
      const bloomComposer = new EffectComposer(renderer);
      bloomComposer.renderToScreen = false;
      bloomComposer.addPass(renderScene);
      bloomComposer.addPass(new UnrealBloomPass(new THREE.Vector2(getHeroW(), getHeroH()), 0.4, 0.55, 0));
      bloomComposer.addPass(new ShaderPass(GammaCorrectionShader));

      
      const finalPass = new ShaderPass(FinalPass);
      finalPass.uniforms.haloTexture.value = dummyBlack;
      finalPass.uniforms.bloomTexture.value = REDUCED ? dummyBlack : bloomComposer.renderTarget1.texture;
      finalPass.uniforms.torusTexture.value = REDUCED ? dummyBlack : torusComposer.renderTarget1.texture;
      const finalComposer = new EffectComposer(renderer);
      finalComposer.addPass(renderScene);
      finalComposer.addPass(finalPass);

      
      const onResize = () => {
        const w = getHeroW();
        const h = getHeroH();
        const rDpr = Math.min(window.devicePixelRatio || 1, REDUCED ? 1 : 2);
        renderer.setPixelRatio(rDpr);
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();

        if (!REDUCED) { torusComposer.setPixelRatio(rDpr); torusComposer.setSize(w, h); }
        if (!REDUCED) { bloomComposer.setPixelRatio(rDpr); bloomComposer.setSize(w, h); }
        finalComposer.setPixelRatio(rDpr); finalComposer.setSize(w, h);
      };
      window.addEventListener('resize', onResize);
      onResize();

      
      const mouseTarget = new THREE.Vector2();
      const mouseSmooth = new THREE.Vector2();
      const POINTER = {
        active: false,
        lastMove: performance.now(),
        world: new THREE.Vector3(),
        activity: 0
      };

      window.addEventListener('mousemove', (e) => {
        const heroRect = heroSection ? heroSection.getBoundingClientRect() : { top: 0, bottom: window.innerHeight };
        mouseTarget.x = (e.clientX / window.innerWidth) * 2 - 1;
        mouseTarget.y = -(e.clientY / window.innerHeight) * 2 + 1;
        POINTER.active = (e.clientY >= heroRect.top - 80 && e.clientY <= heroRect.bottom + 80);
        POINTER.lastMove = performance.now();
      });

      window.addEventListener('mouseout', () => {
        POINTER.active = false;
      });

      const _ndc = new THREE.Vector3(), _dir = new THREE.Vector3(), _tgt = new THREE.Vector3();
      function updatePointer() {
        _tgt.set(0, 0, 0);
        if (POINTER.active) {
          _ndc.set(mouseSmooth.x, mouseSmooth.y, 0.5).unproject(camera);
          _dir.copy(_ndc).sub(camera.position).normalize();
          const dn = _dir.z;
          if (Math.abs(dn) > 1e-4) {
            const tt = -camera.position.z / dn;
            if (tt > 0 && Number.isFinite(tt)) _tgt.copy(camera.position).addScaledVector(_dir, tt);
          }
        }
        POINTER.world.lerp(_tgt, 0.12);
        const idle = (performance.now() - POINTER.lastMove) / 1000;
        const want = (POINTER.active && idle < 3) ? 1 : 0;
        POINTER.activity += (want - POINTER.activity) * 0.06;

        uniforms.uCursor.value.copy(POINTER.world);
        uniforms.uActivity.value = POINTER.activity;
      }

      
      let scrollTarget = 0, scrollSmooth = 0, scrollCurrent = 0;
      function updateScroll() {
        const heroH = heroSection ? heroSection.offsetHeight : window.innerHeight;
        const maxScroll = Math.max(heroH * 1.5, window.innerHeight);
        scrollTarget = clamp(window.scrollY / maxScroll, 0, 1);
      }
      window.addEventListener('scroll', updateScroll, { passive: true });
      window.addEventListener('resize', updateScroll);

      
      let t0 = performance.now() / 1000;
      const appearStart = performance.now();
      let uDrift = 0;

      function updateScene(scroll, m) {
        const now = performance.now();
        const t = now / 1000;
        const dt = Math.min(0.05, t - t0);
        t0 = t;

        uniforms.uTime.value = t;
        uDrift += dt * (CONFIG.drift + scroll * CONFIG.scrollDrift);
        uniforms.uDrift.value = uDrift;

        camera.position.set(m.x * CONFIG.parallax, m.y * CONFIG.parallax, 5 - scroll * CONFIG.scrollPush);
        camera.lookAt(m.x * CONFIG.parallax, m.y * CONFIG.parallax, -10);

        const elapsed = now - appearStart;
        const fade = clamp(elapsed / 1000, 0.5, 1);
        uniforms.uOpacity.value = fade * CONFIG.opacity;

        group.rotation.z += dt * (CONFIG.spin + scroll * CONFIG.scrollSpin);
      }

      
      let rafId = 0;
      let heroVisible = true;
      let fpsEma = 60;
      let lastFrame = performance.now();
      let degraded = REDUCED;
      function schedule() {
        if (rafId) return;
        rafId = requestAnimationFrame(render);
      }
      function unschedule() {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = 0;
      }
      function observeVisibility() {
        const gate = () => {
          if (document.hidden || !heroVisible) unschedule();
          else schedule();
        };
        document.addEventListener('visibilitychange', gate);
        if (heroSection && 'IntersectionObserver' in window) {
          new IntersectionObserver((entries) => {
            heroVisible = entries.some((e) => e.isIntersecting);
            gate();
          }, { rootMargin: '100px' }).observe(heroSection);
        }
      }
      function degradeIfSlow(now) {
        const dt = now - lastFrame;
        lastFrame = now;
        if (dt > 0 && dt < 1000) fpsEma = fpsEma * 0.95 + (1000 / dt) * 0.05;
        if (degraded || fpsEma >= 28) return;
        degraded = true; 
        try {
          renderer.setPixelRatio(1);
          finalComposer.setPixelRatio(1);
          if (!REDUCED) { torusComposer.setPixelRatio(1); bloomComposer.setPixelRatio(1); }
        } catch (_) {}
      }
      function render() {
        rafId = 0;
        if (document.hidden || !heroVisible) return;
        schedule();

        degradeIfSlow(performance.now());
        if (degraded && fpsEma < 20) { unschedule(); return; } 

        finalPass.uniforms.iTime.value = performance.now() / 1000;

        scrollSmooth = Lerp(scrollSmooth, scrollTarget, 0.10);
        scrollCurrent = Lerp(scrollCurrent, scrollSmooth, 0.06);

        mouseSmooth.x = Lerp(mouseSmooth.x, mouseTarget.x, 0.06);
        mouseSmooth.y = Lerp(mouseSmooth.y, mouseTarget.y, 0.06);

        updatePointer();
        updateScene(scrollCurrent, mouseSmooth);

        if (!REDUCED) {
          camera.layers.set(LAYERS.TORUS_SCENE); torusComposer.render();
          camera.layers.set(LAYERS.BLOOM_SCENE); bloomComposer.render();

          finalPass.uniforms.torusTexture.value = torusComposer.readBuffer.texture || torusComposer.renderTarget1.texture;
          finalPass.uniforms.bloomTexture.value = bloomComposer.readBuffer.texture || bloomComposer.renderTarget1.texture;
        }

        camera.layers.set(LAYERS.ENTIRE_SCENE); finalComposer.render();
      }
      observeVisibility();
      schedule();
    })();

    
    (function initHeroCardCarousel() {
      const card = document.getElementById('heroCard');
      const items = card.querySelectorAll('.card-item');
      const dashes = card.querySelectorAll('.card-dash');
      const prevBtn = document.getElementById('cardPrevBtn');
      const nextBtn = document.getElementById('cardNextBtn');
      const clickAdvance = document.getElementById('cardClickAdvance');
      let activeIndex = 0;
      const count = items.length;

      function goTo(nextIndex, dir = 'next') {
        if (nextIndex === activeIndex) return;
        const currentItem = items[activeIndex];
        const nextItem = items[nextIndex];

        currentItem.classList.remove('active');
        currentItem.classList.add(dir === 'next' ? 'outgoing-prev' : 'outgoing-next');
        setTimeout(() => {
          currentItem.classList.remove('outgoing-prev', 'outgoing-next');
        }, 350);

        nextItem.classList.add('active');
        dashes[activeIndex].classList.remove('active');
        dashes[nextIndex].classList.add('active');
        activeIndex = nextIndex;
      }

      function advance(dir = 'next') {
        const target = dir === 'next' ? (activeIndex + 1) % count : (activeIndex - 1 + count) % count;
        goTo(target, dir);
      }

      if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); advance('prev'); });
      if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); advance('next'); });
      if (clickAdvance) clickAdvance.addEventListener('click', () => advance('next'));
    })();

    
    
    (function initAboutWordReveal() {
      const h2 = document.getElementById('aboutWordH2');
      if (!h2) return;
      const rawText = h2.textContent.trim();
      const words = rawText.split(/\s+/);
      h2.innerHTML = '';

      words.forEach((w) => {
        const span = document.createElement('span');
        span.className = 'about-word';
        
        if (w.includes('digital') || w.includes('infrastructure') || w.includes('high-throughput') || w.includes('virtualization') || w.includes('them')) {
          span.classList.add('muted-text');
        }
        span.textContent = w + ' ';
        h2.appendChild(span);
      });

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            obs.unobserve(entry.target);
            const wordSpans = entry.target.querySelectorAll('.about-word');
            wordSpans.forEach((sp, i) => {
              setTimeout(() => sp.classList.add('revealed'), i * 35);
            });
          }
        });
      }, { threshold: 0.25 });

      observer.observe(h2);
    })();

    
    const scrollObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          obs.unobserve(entry.target);
          entry.target.classList.add('revealed');

          
          const lines = entry.target.querySelectorAll('.line-inner');
          lines.forEach((line, i) => {
            setTimeout(() => line.classList.add('revealed'), i * 120);
          });
        }
      });
    }, { threshold: 0.15 });

    document.querySelectorAll('.band-item, .work-item, .service-item, .stats-panel, .reveal-on-scroll').forEach((el, idx) => {
      
      if (el.classList.contains('band-item')) {
        el.style.transitionDelay = (idx % 4 * 120) + 'ms';
      } else if (el.classList.contains('work-item')) {
        el.style.transitionDelay = (idx % 4 * 90) + 'ms';
      } else if (el.classList.contains('service-item')) {
        el.style.transitionDelay = (idx % 4 * 80) + 'ms';
      }
      scrollObserver.observe(el);
    });

    
    (function initStatsCounter() {
      const statItems = document.querySelectorAll('.stat-item');
      let statsStarted = false;

      function onScrollStats() {
        const panel = document.getElementById('statsPanel');
        if (!panel) return;
        const rect = panel.getBoundingClientRect();
        const winHeight = window.innerHeight;

        
        const start = winHeight;
        const end = winHeight / 2;
        const current = rect.top;

        if (current <= start) {
          const progress = Math.min(Math.max((start - current) / (start - end), 0), 1);
          statItems.forEach((item, idx) => {
            setTimeout(() => item.classList.add('revealed'), idx * 90);
            const target = parseInt(item.getAttribute('data-target'), 10) || 0;
            const valSpan = item.querySelector('.num-val');
            if (valSpan) {
              valSpan.textContent = Math.round(progress * target);
            }
          });
        }
      }

      window.addEventListener('scroll', onScrollStats, { passive: true });
      onScrollStats();
    })();

    
    const logoBtn = document.getElementById('logoBtn');
    if (logoBtn) {
      logoBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        try { history.replaceState(null, '', '/'); } catch (_) { }
      });
    }

    document.querySelectorAll('[data-target]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetId = btn.getAttribute('data-target');
        if (targetId) {
          scrollToTarget(targetId);
          try { history.replaceState(null, '', '/'); } catch (_) { }
          
          closeNavMenu();
        }
      });
    });

    
    const navMenu = document.getElementById('navMenuOverlay');
    const openMenuBtn = document.getElementById('openMenuBtn');
    const closeMenuBtn = document.getElementById('closeMenuBtn');

    function openNavMenu() {
      navMenu.classList.add('open');
      stopScroll();
    }
    function closeNavMenu() {
      navMenu.classList.remove('open');
      startScroll();
    }

    if (openMenuBtn) openMenuBtn.addEventListener('click', openNavMenu);
    if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeNavMenu);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (navMenu.classList.contains('open')) closeNavMenu();
      }
    });

    
    const targetPortalUrl = '<%= (typeof user !== "undefined" && user) ? "/dashboard" : "/register" %>';
    document.querySelectorAll('.modal-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        window.location.href = targetPortalUrl;
      });
    });
  </script>
</body>

</html>
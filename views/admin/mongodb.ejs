function applyConsoleSnippet(name) {
  if (name === 'find-all') {
    document.getElementById('consoleOpSelect').value = 'find';
    document.getElementById('consolePayload').value = '{\n  "filter": {},\n  "limit": 50\n}';
  } else if (name === 'find-limit') {
    document.getElementById('consoleOpSelect').value = 'find';
    document.getElementById('consolePayload').value = '{\n  "filter": {},\n  "sort": { "_id": -1 },\n  "limit": 5\n}';
  } else if (name === 'count') {
    document.getElementById('consoleOpSelect').value = 'countDocuments';
    document.getElementById('consolePayload').value = '{\n  "filter": {}\n}';
  } else if (name === 'aggregate-count') {

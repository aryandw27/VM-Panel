<%- include('../partials/head', { title: 'Storage Pools & ISO Library' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<style>
.storage-subtab-btn {
  padding: 8px 18px;
  border-radius: 10px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-dim);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.storage-subtab-btn:hover {
  background: rgba(255,255,255,0.06);
  color: #fff;
}
.storage-subtab-btn.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
  box-shadow: 0 0 14px var(--accent-glow);
}
.storage-pane {
  display: none;
}
.storage-pane.active {
  display: block;
}
.storage-pool-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  transition: all 0.2s ease;
}
.storage-pool-card:hover {
  border-color: rgba(99, 102, 241, 0.4);
  transform: translateY(-2px);
}
.progress-bar-bg {
  background: rgba(255,255,255,0.08);
  border-radius: 999px;
  height: 8px;
  overflow: hidden;
  margin: 10px 0;
}
.progress-bar-fill {
  height: 100%;
  border-radius: 999px;
  transition: width 0.3s ease;
}
</style>

<div class="main">
  
  <div class="flex-between mb-4">
    <div>
      <div class="muted text-sm mb-1">
        <a href="/admin" class="muted">Admin</a> / <span style="color:var(--accent);font-weight:600">Storage Management</span>
      </div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.4px;margin:0;display:flex;align-items:center;gap:10px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="24" height="24" style="color:var(--accent)"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        Storage Pools &amp; ISO Library
      </h2>
    </div>

    <div class="flex" style="gap:8px">
      <button class="btn btn-sm btn-primary" onclick="openModal('modalDownloadIso')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download ISO
      </button>
      <button class="btn btn-sm" onclick="openModal('modalAddPool')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 5v14M5 12h14"/></svg>
        Add Storage Pool
      </button>
    </div>
  </div>

  
  <div class="flex mb-4" style="gap:8px;background:rgba(0,0,0,0.25);padding:6px;border-radius:12px;border:1px solid var(--border);width:fit-content">
    <button class="storage-subtab-btn active" onclick="switchStorageTab('pools', this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      Storage Pools (<%= pools.length %>)
    </button>
    <button class="storage-subtab-btn" onclick="switchStorageTab('iso', this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
      ISO Library (<%= isos.length %>)
    </button>
    <button class="storage-subtab-btn" onclick="switchStorageTab('volumes', this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      Disk Volumes (<%= volumes.length %>)
    </button>
  </div>

  
  <div id="pane-pools" class="storage-pane active">
    <div class="grid grid-3 mb-4">
      <% pools.forEach(pool => { %>
        <div class="storage-pool-card">
          <div class="flex-between mb-2">
            <div style="font-weight:700;font-size:16px;color:#fff"><%= pool.name %></div>
            <span class="pill <%= pool.isDefault ? 'pill-blue' : 'pill-green' %>" style="font-size:11px"><%= pool.type.toUpperCase() %></span>
          </div>
          <div class="muted text-sm mono mb-3" style="font-size:11px"><%= pool.path %></div>

          <div class="flex-between text-sm">
            <span class="muted">Allocation</span>
            <span class="font-semibold"><%= pool.usedFormatted %> / <%= pool.totalFormatted %> (<%= pool.usedPercent %>%)</span>
          </div>

          <div class="progress-bar-bg">
            <div class="progress-bar-fill" style="width:<%= pool.usedPercent %>%;background:<%= pool.usedPercent > 85 ? '#ef4444' : pool.usedPercent > 65 ? '#fbbf24' : 'var(--accent)' %>"></div>
          </div>

          <div class="flex-between text-sm muted mt-2" style="font-size:11.5px">
            <span>Free Space: <b style="color:#34d399"><%= pool.freeFormatted %></b></span>
            <% if (!pool.isDefault) { %>
              <button class="btn btn-sm btn-danger" onclick="deleteStoragePool(<%= pool.id %>)" style="padding:2px 8px;font-size:11px">Delete</button>
            <% } else { %>
              <span class="mono" style="color:var(--accent)">Default Pool</span>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  
  <div id="pane-iso" class="storage-pane">
    <div class="card">
      <div class="flex-between mb-3">
        <span style="font-weight:700">Available Operating System ISOs</span>
        <button class="btn btn-sm btn-primary" onclick="openModal('modalDownloadIso')">+ Download New ISO</button>
      </div>

      <div style="overflow-x:auto">
        <table class="table" style="font-size:13px">
          <thead>
            <tr>
              <th>Operating System / Image</th>
              <th>Category</th>
              <th>File Size</th>
              <th>Status</th>
              <th style="text-align:right">Action</th>
            </tr>
          </thead>
          <tbody>
            <% isos.forEach(iso => { %>
              <tr>
                <td>
                  <div style="font-weight:700;color:#fff"><%= iso.name %></div>
                  <div class="muted text-sm mono" style="font-size:11px"><%= iso.filename %></div>
                </td>
                <td><span class="pill pill-blue"><%= iso.category || 'OS' %></span></td>
                <td class="mono"><%= iso.sizeFormatted %></td>
                <td>
                  <span class="pill <%= iso.status === 'ready' ? 'pill-green' : 'pill-amber' %>">
                    <%= iso.status === 'ready' ? 'Ready to Install' : 'Available for Download' %>
                  </span>
                </td>
                <td style="text-align:right">
                  <div class="flex" style="gap:6px;justify-content:flex-end">
                    <button class="btn btn-sm btn-danger" onclick="deleteIsoImage(<%= iso.id %>)" style="font-size:11px;padding:3px 8px">Remove</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  
  <div id="pane-volumes" class="storage-pane">
    <div class="card">
      <div class="flex-between mb-3">
        <span style="font-weight:700">Virtual Machine Disk Volumes</span>
        <button class="btn btn-sm btn-primary" onclick="openModal('modalCreateVolume')">+ Create Volume</button>
      </div>

      <div style="overflow-x:auto">
        <table class="table" style="font-size:13px">
          <thead>
            <tr>
              <th>Volume ID / Label</th>
              <th>Attached Server</th>
              <th>Storage Pool</th>
              <th>Size</th>
              <th>Status</th>
              <th style="text-align:right">Action</th>
            </tr>
          </thead>
          <tbody>
            <% volumes.forEach(vol => { %>
              <tr>
                <td>
                  <div class="mono font-semibold" style="color:#fff"><%= vol.name %></div>
                  <div class="muted text-sm mono" style="font-size:11px"><%= vol.id %></div>
                </td>
                <td>
                  <% if (vol.vm_id) { %>
                    <a href="/servers/<%= vol.vm_id %>" style="color:var(--accent);font-weight:600"><%= vol.vm_name %></a>
                  <% } else { %>
                    <span class="muted">Unattached</span>
                  <% } %>
                </td>
                <td class="muted"><%= vol.pool %></td>
                <td class="mono font-semibold" style="color:#34d399"><%= vol.sizeFormatted %></td>
                <td>
                  <span class="pill <%= vol.status === 'in-use' ? 'pill-green' : 'pill-blue' %>"><%= vol.status %></span>
                </td>
                <td style="text-align:right">
                  <% if (!vol.vm_id) { %>
                    <button class="btn btn-sm btn-danger" onclick="deleteVolume('<%= vol.id %>')" style="font-size:11px;padding:3px 8px">Delete</button>
                  <% } else { %>
                    <span class="muted text-sm mono">Attached</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>


<div id="modalDownloadIso" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:999;backdrop-filter:blur(10px);place-items:center;padding:20px">
  <div class="card modal-card" style="width:min(500px, 94vw)">
    <div class="flex-between mb-3" style="border-bottom:1px solid var(--border);padding-bottom:10px">
      <h3 style="font-size:16px;font-weight:700;margin:0">Download ISO Image from URL</h3>
      <button class="icon-btn" onclick="closeModal('modalDownloadIso')">✕</button>
    </div>
    <div class="mb-3">
      <label class="muted text-sm mb-1" style="display:block">OS / Image Display Name</label>
      <input type="text" id="isoName" class="form-control" placeholder="e.g. AlmaLinux 9.4 x86_64" />
    </div>
    <div class="mb-3">
      <label class="muted text-sm mb-1" style="display:block">Direct ISO URL</label>
      <input type="url" id="isoUrl" class="form-control" placeholder="https://example.com/image.iso" />
    </div>
    <div class="mb-4">
      <label class="muted text-sm mb-1" style="display:block">Category</label>
      <select id="isoCategory" class="form-control">
        <option value="Linux">Linux</option>
        <option value="Windows">Windows</option>
        <option value="BSD">BSD</option>
        <option value="Rescue">Rescue / Utility</option>
      </select>
    </div>
    <div class="flex-between">
      <button class="btn btn-sm" onclick="closeModal('modalDownloadIso')">Cancel</button>
      <button class="btn btn-sm btn-primary" onclick="submitDownloadIso()">Start Download</button>
    </div>
  </div>
</div>


<div id="modalAddPool" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:999;backdrop-filter:blur(10px);place-items:center;padding:20px">
  <div class="card modal-card" style="width:min(480px, 94vw)">
    <div class="flex-between mb-3" style="border-bottom:1px solid var(--border);padding-bottom:10px">
      <h3 style="font-size:16px;font-weight:700;margin:0">Add Storage Pool</h3>
      <button class="icon-btn" onclick="closeModal('modalAddPool')">✕</button>
    </div>
    <div class="mb-3">
      <label class="muted text-sm mb-1" style="display:block">Pool Name</label>
      <input type="text" id="poolName" class="form-control" placeholder="e.g. Fast NVMe Storage" />
    </div>
    <div class="mb-3">
      <label class="muted text-sm mb-1" style="display:block">Storage Type</label>
      <select id="poolType" class="form-control">
        <option value="directory">Directory (Local Filesystem)</option>
        <option value="lvm">LVM (Logical Volume Manager)</option>
        <option value="nfs">NFS (Network File System)</option>
      </select>
    </div>
    <div class="mb-4">
      <label class="muted text-sm mb-1" style="display:block">Path / Mount Point</label>
      <input type="text" id="poolPath" class="form-control" placeholder="/mnt/nvme-pool" />
    </div>
    <div class="flex-between">
      <button class="btn btn-sm" onclick="closeModal('modalAddPool')">Cancel</button>
      <button class="btn btn-sm btn-primary" onclick="submitAddPool()">Create Pool</button>
    </div>
  </div>
</div>


<div id="modalCreateVolume" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:999;backdrop-filter:blur(10px);place-items:center;padding:20px">
  <div class="card modal-card" style="width:min(480px, 94vw)">
    <div class="flex-between mb-3" style="border-bottom:1px solid var(--border);padding-bottom:10px">
      <h3 style="font-size:16px;font-weight:700;margin:0">Create Virtual Disk Volume</h3>
      <button class="icon-btn" onclick="closeModal('modalCreateVolume')">✕</button>
    </div>
    <div class="mb-3">
      <label class="muted text-sm mb-1" style="display:block">Volume Name</label>
      <input type="text" id="volName" class="form-control" placeholder="e.g. data-disk-01" />
    </div>
    <div class="mb-4">
      <label class="muted text-sm mb-1" style="display:block">Size (GB)</label>
      <input type="number" id="volSize" class="form-control" value="20" min="5" max="500" />
    </div>
    <div class="flex-between">
      <button class="btn btn-sm" onclick="closeModal('modalCreateVolume')">Cancel</button>
      <button class="btn btn-sm btn-primary" onclick="submitCreateVolume()">Create Volume</button>
    </div>
  </div>
</div>

<script>
function switchStorageTab(tabId, btn) {
  document.querySelectorAll('.storage-subtab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.storage-pane').forEach(p => p.classList.remove('active'));
  document.getElementById(`pane-${tabId}`).classList.add('active');
}

function openModal(id) {
  const el = document.getElementById(id);
  if (el) el.style.display = 'grid';
}
function closeModal(id) {
  const el = document.getElementById(id);
  if (el) el.style.display = 'none';
}

async function submitDownloadIso() {
  const name = document.getElementById('isoName').value.trim();
  const url = document.getElementById('isoUrl').value.trim();
  const category = document.getElementById('isoCategory').value;
  if (!url) { VP.toast('Enter an ISO download URL first.', 'warning'); return; }

  try {
    const res = await fetch('/admin/storage/api/isos/download', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, url, category })
    }).then(r => r.json());

    if (res.ok) {
      VP.toast('ISO download started.', 'success');
      location.reload();
    } else {
      VP.toast(VP.errorMessage({ message: res.error || 'Failed to start ISO download' }), 'error');
    }
  } catch (e) {
    VP.toast(VP.errorMessage(e), 'error');
  }
}

async function deleteIsoImage(id) {
  if (!await VP.confirmDialog('Remove this ISO image? VMs using it may fail to provision.', { title: 'Remove ISO?', confirmText: 'Remove ISO' })) return;
  try {
    const res = await fetch('/admin/storage/api/isos/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id })
    }).then(r => r.json());
    if (res.ok) location.reload();
    else VP.toast(VP.errorMessage({ message: res.error || 'Failed to delete ISO' }), 'error');
  } catch (e) {
    VP.toast(VP.errorMessage(e), 'error');
  }
}

async function submitAddPool() {
  const name = document.getElementById('poolName').value.trim();
  const type = document.getElementById('poolType').value;
  const path = document.getElementById('poolPath').value.trim();
  if (!name) { VP.toast('Enter a storage pool name first.', 'warning'); return; }

  try {
    const res = await fetch('/admin/storage/api/pools/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, type, path })
    }).then(r => r.json());
    if (res.ok) location.reload();
    else VP.toast(VP.errorMessage({ message: res.error || 'Failed to create storage pool' }), 'error');
  } catch (e) {
    VP.toast(VP.errorMessage(e), 'error');
  }
}

async function deleteStoragePool(id) {
  if (!await VP.confirmDialog('Delete this storage pool? Volumes inside it will be affected.', { title: 'Delete storage pool?', confirmText: 'Delete pool' })) return;
  try {
    const res = await fetch('/admin/storage/api/pools/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id })
    }).then(r => r.json());
    if (res.ok) location.reload();
    else VP.toast(VP.errorMessage({ message: res.error || 'Failed to delete storage pool' }), 'error');
  } catch (e) {
    VP.toast(VP.errorMessage(e), 'error');
  }
}

async function submitCreateVolume() {
  const name = document.getElementById('volName').value.trim();
  const size_gb = document.getElementById('volSize').value;
  if (!name) { VP.toast('Enter a volume name first.', 'warning'); return; }

  try {
    const res = await fetch('/admin/storage/api/volumes/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, size_gb })
    }).then(r => r.json());
    if (res.ok) location.reload();
    else VP.toast(VP.errorMessage({ message: res.error || 'Failed to create volume' }), 'error');
  } catch (e) {
    VP.toast(VP.errorMessage(e), 'error');
  }
}

async function deleteVolume(id) {
  if (!await VP.confirmDialog('Delete this storage volume? Its data will be permanently removed.', { title: 'Delete volume?', confirmText: 'Delete volume' })) return;
  try {
    const res = await fetch('/admin/storage/api/volumes/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id })
    }).then(r => r.json());
    if (res.ok) location.reload();
    else VP.toast(VP.errorMessage({ message: res.error || 'Failed to delete volume' }), 'error');
  } catch (e) {
    VP.toast(VP.errorMessage(e), 'error');
  }
}

</script>

<%- include('../partials/foot') %>

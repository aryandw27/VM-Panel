    const url = '/servers/<%= vm.id %>/console?tab=terminal&mode=full';
    window.open(url, 'vpanel_terminal_<%= vm.id %>', `width=${w},height=${h},top=${top},left=${left},menubar=no,toolbar=no,location=no,status=no,resizable=yes`);

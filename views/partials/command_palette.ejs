<div id="cmdPaletteBackdrop" class="cmd-palette-backdrop" onclick="if(event.target===this)closeCommandPalette()" style="display:none">
  <div class="cmd-palette-modal">
    <div class="cmd-palette-header">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" class="cmd-search-icon">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input type="text" id="cmdPaletteInput" placeholder="Type a command or search servers, settings, themes..." autocomplete="off" />
      <div class="cmd-shortcuts">
        <span class="cmd-badge">ESC to close</span>
      </div>
    </div>

    <div class="cmd-palette-body" id="cmdPaletteList">
      
    </div>

    <div class="cmd-palette-footer">
      <div class="cmd-footer-hints">
        <span><kbd>↑</kbd> <kbd>↓</kbd> Navigate</span>
        <span><kbd>↵</kbd> Select</span>
        <span><kbd>ESC</kbd> Dismiss</span>
      </div>
      <div class="cmd-footer-branding">
        <span>SiliconHost Spotlight</span>
      </div>
    </div>
  </div>
</div>

<style>
.cmd-palette-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.78);
  z-index: 99999;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 10vh;
  animation: cmdFadeIn 0.15s ease-out;
}
@keyframes cmdFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.cmd-palette-modal {
  width: 100%;
  max-width: 640px;
  background: #11141b;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  box-shadow: 0 32px 80px rgba(0, 0, 0, 0.85);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 75vh;
  animation: cmdSlideDown 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes cmdSlideDown {
  from { transform: translateY(-12px) scale(0.98); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}
.cmd-palette-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
}
.cmd-search-icon {
  color: #38bdf8;
  flex-shrink: 0;
}
#cmdPaletteInput {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #f1f5f9;
  font-size: 15px;
  font-family: inherit;
}
#cmdPaletteInput::placeholder {
  color: #64748b;
}
.cmd-badge {
  font-size: 11px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 2px 7px;
  border-radius: 5px;
  color: #94a3b8;
}
.cmd-palette-body {
  flex: 1;
  overflow-y: auto;
  padding: 10px;
  max-height: 52vh;
}
.cmd-category-title {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #64748b;
  padding: 8px 10px 4px 10px;
}
.cmd-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 12px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.12s ease;
  color: #cbd5e1;
  margin-bottom: 2px;
}
.cmd-item-left {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}
.cmd-item-icon {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #38bdf8;
  flex-shrink: 0;
}
.cmd-item-title {
  font-size: 13.5px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cmd-item-subtitle {
  font-size: 11px;
  color: #64748b;
  margin-top: 1px;
}
.cmd-item-badge {
  font-size: 10.5px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.06);
  color: #94a3b8;
  flex-shrink: 0;
}
.cmd-item:hover, .cmd-item.active {
  background: rgba(56, 189, 248, 0.12);
  color: #ffffff;
}
.cmd-item:hover .cmd-item-icon, .cmd-item.active .cmd-item-icon {
  background: #38bdf8;
  color: #0d1322;
}
.cmd-palette-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(0, 0, 0, 0.2);
  font-size: 11.5px;
  color: #64748b;
}
.cmd-footer-hints {
  display: flex;
  gap: 12px;
}
.cmd-footer-hints kbd {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 4px;
  padding: 1px 5px;
  font-size: 10px;
  color: #94a3b8;
}
</style>

<script>
(function() {
  const isAdmin = <%= user && (user.role === 'admin' || user.root_admin) ? 'true' : 'false' %>;
  let activeIndex = 0;
  let filteredItems = [];

  const baseCommands = [
    
    { title: 'User Dashboard', subtitle: 'View servers and account status', category: 'Navigation', url: '/dashboard', icon: 'server' },
    { title: 'My Account Settings', subtitle: 'Security, 2FA, API Keys', category: 'Navigation', url: '/settings', icon: 'settings' },
    { title: 'Account Activity Log', subtitle: 'Recent login and action logs', category: 'Navigation', url: '/activity', icon: 'activity' },

    
    ...(isAdmin ? [
      { title: 'Admin Dashboard', subtitle: 'Cluster overview & system health', category: 'Admin Panel', url: '/admin', icon: 'shield' },
      { title: 'All Virtual Machines', subtitle: 'Manage all VMs across nodes', category: 'Admin Panel', url: '/admin/servers', icon: 'cpu' },
      { title: 'Deploy New VM Wizard', subtitle: 'Create VM with cloud-init & resources', category: 'Admin Panel', url: '/admin/servers/create', icon: 'plus' },
      { title: 'User Management', subtitle: 'View users, roles, and impersonate', category: 'Admin Panel', url: '/admin/users', icon: 'users' },
      { title: 'Storage Pools & ISOs', subtitle: 'Local, LVM, NFS and ISO Library', category: 'Admin Panel', url: '/admin/storage', icon: 'database' },
      { title: 'Virtual Network & Firewall', subtitle: 'Bridges, IP pools, NAT and firewall rules', category: 'Admin Panel', url: '/admin/network', icon: 'network' },
      { title: 'MongoDB Management Studio', subtitle: 'Databases, collections, documents & indexes', category: 'Admin Panel', url: '/admin/mongodb', icon: 'layers' },
      { title: 'API Keys & Webhooks', subtitle: 'Scoped tokens and HTTP webhooks', category: 'Admin Panel', url: '/admin/api', icon: 'key' },
      { title: 'Plugins Marketplace', subtitle: 'Discord, Telegram and custom plugins', category: 'Admin Panel', url: '/admin/plugins', icon: 'package' },
      { title: 'Audit & Security Center', subtitle: 'Unified audit trails and login security', category: 'Admin Panel', url: '/admin/audit', icon: 'lock' },
      { title: 'Host Nodes & Metrics', subtitle: 'Live CPU, RAM and disk waveforms', category: 'Admin Panel', url: '/admin/nodes', icon: 'bar-chart' },
      { title: 'System Updates', subtitle: 'Pterodactyl-grade updates & backups', category: 'Admin Panel', url: '/admin/updates', icon: 'refresh-cw' },
      { title: 'Platform Settings', subtitle: 'Themes, branding, mail, backups', category: 'Admin Panel', url: '/admin/settings', icon: 'sliders' },
    ] : []),

    
    ...(isAdmin ? [
      { title: 'Download ISO Image', subtitle: 'Direct cloud download Ubuntu/Debian/Alpine', category: 'Quick Actions', url: '/admin/storage', icon: 'download' },
      { title: 'Add Firewall Security Rule', subtitle: 'Allow/drop ports and CIDR ranges', category: 'Quick Actions', url: '/admin/network', icon: 'shield' },
      { title: 'Generate Live API Key', subtitle: 'Create scoped REST API token', category: 'Quick Actions', url: '/admin/api', icon: 'key' },
      { title: 'Clear All System Caches', subtitle: 'Purge RAM buffers, query caches, and expired tokens', category: 'Quick Actions', action: async () => {
        if (typeof closeCommandPalette === 'function') closeCommandPalette();
        try {
          VP.toast('Purging system caches...', 'info');
          await VP.api('/admin/cache/clear', { method: 'POST' });
          VP.toast('All system caches cleared successfully!', 'success');
        } catch (e) {
          VP.toast(VP.errorMessage(e, 'Cache clear failed.'), 'error');
        }
      }, icon: 'refresh-cw' },
      { title: 'Cache & Performance Settings', subtitle: 'Manage auto cache clear schedules and memory metrics', category: 'Admin Panel', url: '/admin/settings?tab=cache', icon: 'sliders' },
    ] : []),

    
    { title: 'Theme: Onyx Pure Black', subtitle: 'Deep minimal dark aesthetics', category: 'Theme Engine', action: () => switchTheme('dark'), icon: 'moon' },
    { title: 'Theme: Deep Slate Glass', subtitle: 'Flagship glassmorphic UI', category: 'Theme Engine', action: () => switchTheme('default'), icon: 'sun' },
    { title: 'Theme: Cyberpunk Neon', subtitle: 'Vibrant emerald & violet glow', category: 'Theme Engine', action: () => switchTheme('neon'), icon: 'zap' },
    { title: 'Theme: Arctic Nord', subtitle: 'Cool oceanic blue frost', category: 'Theme Engine', action: () => switchTheme('nord'), icon: 'compass' },
    { title: 'Theme: Dracula Gothic', subtitle: 'High contrast purple & pink', category: 'Theme Engine', action: () => switchTheme('dracula'), icon: 'droplet' },

    
    { title: 'Language: English (US)', subtitle: 'Switch display language to English', category: 'Language (i18n)', action: () => switchLang('en'), icon: 'globe' },
    { title: 'Language: हिन्दी (Hindi)', subtitle: 'भाषा को हिन्दी में बदलें', category: 'Language (i18n)', action: () => switchLang('hi'), icon: 'globe' },
    { title: 'Language: Español (Spanish)', subtitle: 'Cambiar idioma a Español', category: 'Language (i18n)', action: () => switchLang('es'), icon: 'globe' },
    { title: 'Language: Deutsch (German)', subtitle: 'Sprache auf Deutsch umstellen', category: 'Language (i18n)', action: () => switchLang('de'), icon: 'globe' },
    { title: 'Language: العربية (Arabic)', subtitle: 'تغيير اللغة إلى العربية', category: 'Language (i18n)', action: () => switchLang('ar'), icon: 'globe' },
  ];

  window.openCommandPalette = function() {
    const el = document.getElementById('cmdPaletteBackdrop');
    if (!el) return;
    el.style.display = 'flex';
    const input = document.getElementById('cmdPaletteInput');
    if (input) {
      input.value = '';
      input.focus();
    }
    renderCommands('');
  };

  window.closeCommandPalette = function() {
    const el = document.getElementById('cmdPaletteBackdrop');
    if (el) el.style.display = 'none';
  };

  function switchTheme(name) {
    fetch('/admin/settings/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 'panel.theme': name })
    }).finally(() => {
      document.documentElement.setAttribute('data-theme', name);
      window.location.reload();
    });
  }

  function switchLang(code) {
    document.cookie = 'vpanel_lang=' + code + '; path=/; max-age=31536000';
    window.location.reload();
  }

  function renderCommands(query) {
    const listEl = document.getElementById('cmdPaletteList');
    if (!listEl) return;
    query = (query || '').toLowerCase().trim();

    filteredItems = baseCommands.filter(item => {
      if (!query) return true;
      return item.title.toLowerCase().includes(query) ||
             (item.subtitle && item.subtitle.toLowerCase().includes(query)) ||
             item.category.toLowerCase().includes(query);
    });

    if (filteredItems.length === 0) {
      listEl.innerHTML = `
        <div style="padding:32px 16px;text-align:center;color:#64748b">
          <div style="margin-bottom:8px;color:#64748b">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28" style="display:inline-block"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>
          <div style="font-size:14px;font-weight:600;color:#94a3b8">No matching commands found</div>
          <div style="font-size:12px;margin-top:4px">Try searching for "servers", "users", "theme", or "storage"</div>
        </div>
      `;
      activeIndex = 0;
      return;
    }

    if (activeIndex >= filteredItems.length) activeIndex = 0;

    let html = '';
    let lastCat = '';
    filteredItems.forEach((item, idx) => {
      if (item.category !== lastCat) {
        lastCat = item.category;
        html += `<div class="cmd-category-title">${lastCat}</div>`;
      }
      const isActive = idx === activeIndex ? 'active' : '';
      html += `
        <div class="cmd-item ${isActive}" data-idx="${idx}" onclick="selectCmd(${idx})">
          <div class="cmd-item-left">
            <div class="cmd-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><circle cx="12" cy="12" r="9"/></svg>
            </div>
            <div>
              <div class="cmd-item-title">${escapeHtml(item.title)}</div>
              ${item.subtitle ? `<div class="cmd-item-subtitle">${escapeHtml(item.subtitle)}</div>` : ''}
            </div>
          </div>
          <span class="cmd-item-badge">${item.category}</span>
        </div>
      `;
    });
    listEl.innerHTML = html;
    scrollActiveIntoView();
  }

  function escapeHtml(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function scrollActiveIntoView() {
    const listEl = document.getElementById('cmdPaletteList');
    if (!listEl) return;
    const activeEl = listEl.querySelector('.cmd-item.active');
    if (activeEl) {
      activeEl.scrollIntoView({ block: 'nearest' });
    }
  }

  window.selectCmd = function(idx) {
    const item = filteredItems[idx];
    if (!item) return;
    closeCommandPalette();
    if (item.action) {
      item.action();
    } else if (item.url) {
      window.location.href = item.url;
    }
  };

  
  document.addEventListener('keydown', function(e) {
    const isCtrlK = (e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K');
    const isSlash = e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName);
    const modal = document.getElementById('cmdPaletteBackdrop');
    const isOpen = modal && modal.style.display !== 'none';

    if (isCtrlK || isSlash) {
      e.preventDefault();
      if (isOpen) closeCommandPalette();
      else openCommandPalette();
      return;
    }

    if (!isOpen) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      closeCommandPalette();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (filteredItems.length > 0) {
        activeIndex = (activeIndex + 1) % filteredItems.length;
        renderCommands(document.getElementById('cmdPaletteInput')?.value || '');
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (filteredItems.length > 0) {
        activeIndex = (activeIndex - 1 + filteredItems.length) % filteredItems.length;
        renderCommands(document.getElementById('cmdPaletteInput')?.value || '');
      }
    } else if (e.key === 'Enter') {
      e.preventDefault();
      selectCmd(activeIndex);
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('cmdPaletteInput');
    if (input) {
      input.addEventListener('input', (e) => {
        activeIndex = 0;
        renderCommands(e.target.value);
      });
    }
  });
})();
</script>


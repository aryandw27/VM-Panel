      return navigator.clipboard.writeText(t).then(() => {
        if (window.VP && VP.toast) VP.toast(successMessage || 'Copied to clipboard', 'success');
        return true;
      }).catch(() => {
        if (window.VP && VP.toast) VP.toast('Copy failed. Select the text manually to copy it.', 'error');
        return false;
      });
    }
    if (window.VP && VP.toast) VP.toast('Copy failed. Select the text manually to copy it.', 'error');
    return Promise.resolve(false);
  };

  
  window.powerServer = async function (action) {
    try {
      if (action === 'start' || action === 'restart') {
        if (window.VP && VP.playSound) VP.playSound('online');
      } else if (action === 'stop') {
        if (window.VP && VP.playSound) VP.playSound('offline');
      }
      VP.toast(`Sending ${action.toUpperCase()} signal...`, 'info');
      await VP.api('/servers/<%= vm.id %>/power', {
        method: 'POST',
        body: { action }
      });
      VP.toast(`Server power signal "${action}" completed`, 'success');
      setTimeout(() => {
        if (window.updateLiveStatus) window.updateLiveStatus();
      }, 1200);
    } catch (e) {
      VP.toast('Power action failed: ' + e.message, 'error');
    }

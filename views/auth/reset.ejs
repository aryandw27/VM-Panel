<%- include('../partials/head', { title: 'Reset Password' }) %>
<%- include('../partials/ambient') %>
<div class="auth-wrap">
  <div class="auth-card" style="position:relative;overflow:hidden">
    
    <div class="auth-logo" style="display:flex;flex-direction:column;align-items:center;margin-bottom:20px">
      <% const pn = settings['panel.name'] || 'vPanel Pro'; 
         let lg = '';
         if (settings['panel.logo_mode']==='upload' && settings['panel.logo_file']) lg = settings['panel.logo_file'];
         else if (settings['panel.logo_mode']==='url' && settings['panel.logo_url']) lg = settings['panel.logo_url'];
         if (!lg) lg = '/arix/Arix.png';
      %>
      <img src="<%= lg %>" alt="Arix Logo" style="height:48px;border-radius:10px;margin-bottom:12px;filter:drop-shadow(0 4px 14px rgba(74,53,207,0.4))"/>
      <span style="font-size:22px;font-weight:700;color:var(--gray-50);letter-spacing:-0.4px"><%= pn %></span>
    </div>

    <h1 class="auth-title" style="font-size:19px;font-weight:700;color:var(--gray-50)">Set New Password</h1>
    <p class="auth-sub" style="margin-bottom:22px">Choose a strong, secure password for your account</p>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="auth-foot mt-4"><a href="/login" class="btn btn-primary btn-block" style="padding:12px">Sign in now</a></div>
    <% } else { %>
    <form method="post" action="/reset">
      <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>"/>
      <div class="form-group mb-3">
        <label for="password">New Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required autofocus/>
      </div>
      <div class="form-group mb-3">
        <label for="password2">Confirm New Password</label>
        <input type="password" id="password2" name="password2" placeholder="••••••••" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-block mt-3" style="padding:12px;font-weight:700;font-size:14px">Save Password</button>
    </form>
    <div class="auth-foot" style="margin-top:24px;text-align:center">
      <a href="/login" style="font-weight:600;color:var(--primary-light)">Back to Sign In</a>
    </div>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>

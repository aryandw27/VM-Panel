  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);

  const mode = formData.get('mode');
  const targetDb = formData.get('db');
  const targetColl = formData.get('collection');

  if (mode === 'replace') {
    if (!await VP.confirmDialog(`Replace mode will TRUNCATE '${targetColl}' in '${targetDb}' before inserting records.`, { title: 'Replace collection contents?', confirmText: 'Replace records' })) {
      return;
    }
  }

  try {
    showToast('Uploading and importing backup...', 'info');
    const res = await fetch('/admin/mongodb/api/backups/import', {
      method: 'POST',
      body: formData
    }).then(r => r.json());

    if (res.ok) {
      showToast(`Restore complete! Imported ${res.importedCount} documents into '${targetColl}'`);
      form.reset();
      loadDatabasesAndCollections();
    } else {
      showToast(res.error || 'Restore failed', 'error');

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SiliconHost — Enterprise Cloud & Next-Gen VPS Infrastructure</title>
  <meta name="description"
    content="SiliconHost is an independent cloud compute platform delivering high-performance KVM VPS, pure NVMe Gen4 storage, and Anycast DDoS protection with quiet precision." />
  <script>
    if (window.location.pathname === '/landing' || window.location.hash) {
      try { history.replaceState(null, '', '/'); } catch (_) { }
    }
  </script>
  <script type="importmap">
  {
    "imports": {
      "lenis": "https://unpkg.com/lenis@1.3.23/dist/lenis.mjs",
      "three": "https://unpkg.com/three@0.143.0/build/three.module.js",
      "three/addons/": "https://unpkg.com/three@0.143.0/examples/jsm/"
    }
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      background: #ffffff;
      color: #111111;
      font-family: 'Onest', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background: #ffffff;
      color: #111111;
      font-family: 'Onest', sans-serif;
      overflow-x: hidden;
      min-height: 100vh;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      color: inherit;
      background: none;
      border: none;
      cursor: pointer;
    }

    ul {
      list-style: none;
    }

    img {
      display: block;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    :focus-visible {
      outline: 2px solid #b15f2c;
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation: none !important;
        transition: none !important;
      }
    }

    
    @media (max-width: 1920px) {
      html {
        font-size: 0.833333vw;
      }
    }

    @media (max-width: 1440px) {
      html {
        font-size: 1.111111vw;
      }
    }

    @media (max-width: 1024px) {
      html {
        font-size: 1.5625vw;
      }
    }

    @media (max-width: 640px) {
      html {
        font-size: 4.444444vw;
      }
    }

    
    :root {
      --background: #ffffff;
      --foreground: #111111;
      --ink: #0a0a0a;
      --muted: #8d8d8d;
      --subtle: #b6b6b6;
      --line: #e6e5e2;
      --surface: #f1f0ee;
      --surface-2: #e3e2df;
      --accent: #b15f2c;
      --accent-from: #cf8047;
      --accent-to: #97501f;
      --hero-from: #ecebe9;
      --hero-to: #c9c9c9;
      --radius-pill: 9999px;
      --radius-card: 2rem;
      --radius-card-sm: 1.25rem;
      --radius-control: 0.875rem;
      --text-watermark: 13rem;
      --container-shell: 88rem;
    }

    .shell {
      max-width: var(--container-shell);
      margin-inline: auto;
      width: 100%;
    }

    
    .skip-link {
      position: fixed;
      left: 1rem;
      top: 1rem;
      z-index: 60;
      border-radius: 0.875rem;
      background: #0a0a0a;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      color: #fff;
      transform: translateY(-200%);
      transition: transform 0.2s ease;
    }

    .skip-link:focus {
      transform: translateY(0);
    }

    
    #pageLoader {
      position: fixed;
      inset: 0;
      z-index: 120;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      background: #0a0a0a;
      color: #fff;
      border-radius: 0 0 2rem 2rem;
      transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
    }

    #pageLoader.exit {
      transform: translateY(-100%);
    }

    .loader-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      text-align: center;
      transition: opacity 0.4s ease, transform 0.4s ease;
    }

    #pageLoader.exit .loader-content {
      opacity: 0;
      transform: translateY(-12px);
    }

    .loader-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-weight: 600;
      font-size: 1.5rem;
      color: #fff;
    }

    @media (min-width: 640px) {
      .loader-brand {
        font-size: 1.875rem;
      }
    }

    .loader-brand svg {
      width: 1.875rem;
      height: 1.875rem;
      color: #cf8047;
    }

    .loader-tagline {
      max-width: 28ch;
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.4;
    }

    .loader-progress {
      width: min(22rem, 72vw);
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .loader-track {
      height: 1px;
      width: 100%;
      background: rgba(255, 255, 255, 0.15);
      position: relative;
    }

    .loader-fill {
      height: 100%;
      background: #cf8047;
      width: 0%;
      transition: width 0.08s linear;
    }

    .loader-status {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: rgba(255, 255, 255, 0.45);
    }

    .loader-status span.count {
      color: rgba(255, 255, 255, 0.8);
      font-variant-numeric: tabular-nums;
    }

    
    #siteHeader {
      position: absolute;
      inset-inline: 0;
      top: 0;
      z-index: 50;
      opacity: 0;
      transform: translateY(-14px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    #siteHeader.ready {
      opacity: 1;
      transform: translateY(0);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 1.25rem;
    }

    @media (min-width: 640px) {
      .header-inner {
        padding: 1.5rem 2rem;
      }
    }

    .brand-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: #ffffff;
      transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .brand-btn:hover {
      transform: scale(1.04);
    }

    .brand-btn svg {
      width: 1.25rem;
      height: 1.25rem;
      color: #cf8047;
    }

    .nav-list {
      display: none;
      align-items: center;
      gap: 2rem;
      font-size: 0.875rem;
      font-weight: 500;
    }

    @media (min-width: 1024px) {
      .nav-list {
        display: flex;
      }
    }

    .nav-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      color: rgba(255, 255, 255, 0.85);
      opacity: 0.85;
      transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease;
    }

    .nav-btn:hover {
      transform: translateY(-2px);
      opacity: 1;
      color: #ffffff;
    }

    .nav-btn.active {
      opacity: 1;
      font-weight: 600;
      color: #ffffff;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .clock-chip {
      display: none;
      align-items: center;
      gap: 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: #11141c;
      border-radius: 0.875rem;
      padding: 0.5rem 0.875rem;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.85);
    }

    @media (min-width: 768px) {
      .clock-chip {
        display: flex;
      }
    }

    .clock-label {
      color: rgba(255, 255, 255, 0.45);
    }

    .clock-time {
      min-width: 3.5rem;
      font-variant-numeric: tabular-nums;
      font-weight: 500;
      color: #ffffff;
    }

    .clock-sep {
      color: rgba(255, 255, 255, 0.25);
    }

    .clock-date {
      font-weight: 500;
      color: rgba(255, 255, 255, 0.85);
    }

    .header-portal-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: #141822;
      border-radius: 0.875rem;
      padding: 0.5rem 0.875rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: #ffffff;
      transition: background 0.25s ease, transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .header-portal-btn:hover {
      background: #202735;
      transform: scale(1.03);
    }

    .menu-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: #141822;
      border-radius: 0.875rem;
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #ffffff;
      transition: background 0.25s ease, transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .menu-btn:hover {
      background: #202735;
      transform: scale(1.04);
    }

    .menu-btn svg {
      width: 0.875rem;
      height: 0.875rem;
    }

    .menu-text {
      display: none;
    }

    @media (min-width: 640px) {
      .menu-text {
        display: inline;
      }
    }

    
    section#home {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      border-radius: 0 0 2rem 2rem;
      background: #000000;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    
    html[data-perf="minimal"] section#home,
    html[data-perf="minimal"] #scene {
      background: radial-gradient(60% 45% at 50% 30%, rgba(94, 230, 160, 0.10), transparent 70%), #000000;
    }

    
    #scene {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      pointer-events: none;
      z-index: 0;
      background: #000000;
    }

    .hero-vignette {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.45) 70%, rgba(0, 0, 0, 0.85) 100%), linear-gradient(to bottom, rgba(0, 0, 0, 0.45) 0%, transparent 25%, transparent 70%, rgba(0, 0, 0, 0.95) 100%);
    }

    .hero-watermark {
      pointer-events: none;
      position: absolute;
      inset-inline: 0;
      bottom: 7rem;
      z-index: 1;
      text-align: center;
      user-select: none;
      font-weight: 700;
      line-height: 1;
      font-size: var(--text-watermark);
      color: rgba(255, 255, 255, 0.08);
      letter-spacing: -0.04em;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1), transform 1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hero-watermark.ready {
      opacity: 0.7;
      transform: translateY(0);
    }

    
    .hero-content {
      position: relative;
      z-index: 20;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 7rem 1.25rem 3rem;
      flex: 1;
    }

    @media (min-width: 640px) {
      .hero-content {
        padding: 8rem 2rem 4rem;
      }
    }

    @media (min-width: 1024px) {
      .hero-content {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 2.5rem;
        padding: 9rem 2rem 5rem;
        align-items: center;
      }
    }

    .hero-left {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    @media (min-width: 1024px) {
      .hero-left {
        grid-column: span 7;
      }
    }

    
    .eyebrow {
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.88);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .eyebrow.ready {
      opacity: 1;
      transform: translateY(0);
    }

    .eyebrow-dot {
      width: 0.375rem;
      height: 0.375rem;
      background: #cf8047;
      border-radius: 9999px;
    }

    .eyebrow.light {
      color: rgba(255, 255, 255, 0.85);
    }

    .eyebrow.light .eyebrow-dot {
      background: #cf8047;
    }

    
    .hero-heading {
      max-width: 18ch;
      font-size: 2.25rem;
      font-weight: 600;
      line-height: 0.98;
      letter-spacing: -0.02em;
      color: #ffffff;
    }

    @media (min-width: 640px) {
      .hero-heading {
        font-size: 3rem;
      }
    }

    @media (min-width: 768px) {
      .hero-heading {
        font-size: 3.75rem;
      }
    }

    .line-clip {
      display: block;
      overflow: hidden;
      padding-bottom: 0.05em;
    }

    .line-inner {
      display: block;
      transform: translateY(100%);
      opacity: 0;
      transition: transform 0.9s cubic-bezier(0.215, 0.61, 0.355, 1), opacity 0.9s ease;
    }

    .line-inner.revealed {
      transform: translateY(0%);
      opacity: 1;
    }

    .rating-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .rating-row.ready {
      opacity: 1;
      transform: translateY(0);
    }

    .stars {
      display: flex;
      align-items: center;
      gap: 0.15rem;
      color: #cf8047;
    }

    .stars svg {
      width: 1rem;
      height: 1rem;
      fill: currentColor;
    }

    .rating-text {
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.8);
    }

    
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .cta-row.ready {
      opacity: 1;
      transform: translateY(0);
    }

    .pill-btn {
      display: inline-block;
      cursor: pointer;
      border-radius: var(--radius-pill);
      transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .pill-btn:hover {
      transform: scale(1.04);
    }

    .pill-inner {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      border-radius: var(--radius-pill);
      font-size: 0.875rem;
      font-weight: 500;
    }

    .pill-btn.with-arrow .pill-inner {
      padding: 0.375rem 0.375rem 0.375rem 1.5rem;
    }

    .pill-btn.no-arrow .pill-inner {
      padding: 0.875rem 1.75rem;
    }

    .pill-btn.dark .pill-inner {
      background: #0a0a0a;
      color: #ffffff;
    }

    .pill-btn.light .pill-inner {
      background: #f1f0ee;
      color: #111111;
    }

    .pill-btn.outline .pill-inner {
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: #141822;
      color: #ffffff;
    }

    .pill-badge {
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      font-size: 1rem;
      transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .pill-btn.dark .pill-badge {
      background: #ffffff;
      color: #0a0a0a;
    }

    .pill-btn.light .pill-badge,
    .pill-btn.outline .pill-badge {
      background: #ffffff;
      color: #0a0a0a;
    }

    .pill-badge svg {
      width: 1rem;
      height: 1rem;
    }

    .pill-btn:hover .pill-badge svg {
      transform: translate(2px, -2px);
    }

    
    .hero-right {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    @media (min-width: 1024px) {
      .hero-right {
        grid-column: span 5;
        align-items: flex-end;
      }
    }

    
    .hero-card {
      width: 100%;
      max-width: 24rem;
      border-radius: 1.25rem;
      background: #10141c;
      padding: 0.5rem;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.12);
      opacity: 0;
      transform: translateY(16px) scale(0.96);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @media (min-width: 1024px) {
      .hero-card {
        width: 19rem;
      }
    }

    .hero-card.ready {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .hero-card-inner {
      display: flex;
      gap: 0.5rem;
      cursor: pointer;
      border-radius: 0.875rem;
    }

    .hero-card-tile {
      aspect-ratio: 1;
      width: 6rem;
      display: grid;
      place-items: center;
      border-radius: 0.875rem;
      background: #0a0a0a;
      color: #cf8047;
      flex-shrink: 0;
    }

    .hero-card-tile svg {
      width: 1.875rem;
      height: 1.875rem;
    }

    .hero-card-panel {
      flex: 1;
      border-radius: 0.875rem;
      background: #171d27;
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 0.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    .card-slot {
      position: relative;
      min-height: 3.25rem;
    }

    .card-item {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
      pointer-events: none;
    }

    .card-item.active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .card-item.outgoing-prev {
      opacity: 0;
      transform: translateY(-14px);
    }

    .card-item.outgoing-next {
      opacity: 0;
      transform: translateY(14px);
    }

    .card-caption {
      font-size: 0.65rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #cf8047;
      margin-bottom: 0.15rem;
    }

    .card-title {
      max-width: 10rem;
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.35;
      color: #ffffff;
    }

    .card-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.5rem;
    }

    .card-dashes {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .card-dash {
      height: 0.25rem;
      border-radius: 9999px;
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.2);
      width: 0.375rem;
    }

    .card-dash.active {
      width: 1rem;
      background: #cf8047;
    }

    .card-controls {
      display: flex;
      gap: 0.35rem;
    }

    .card-btn {
      width: 1.75rem;
      height: 1.75rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      background: #1e2432;
      color: #ffffff;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
      transition: color 0.2s, background 0.2s;
    }

    .card-btn:hover {
      color: #cf8047;
      background: #283144;
    }

    .card-btn svg {
      width: 0.875rem;
      height: 0.875rem;
    }

    .card-btn.prev svg {
      transform: rotate(180deg);
    }

    
    .partners-wrap {
      width: 100%;
      max-width: 24rem;
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @media (min-width: 1024px) {
      .partners-wrap {
        width: 19rem;
      }
    }

    .partners-wrap.ready {
      opacity: 1;
      transform: translateY(0);
    }

    .partners-label {
      margin-bottom: 0.75rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.5);
      text-align: left;
    }

    @media (min-width: 1024px) {
      .partners-label {
        text-align: right;
      }
    }

    .partners-grid {
      display: grid;

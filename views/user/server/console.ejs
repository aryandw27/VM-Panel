    if (e.key === 'Escape' && isTerminalFullscreen) {
      window.toggleFullTerminal(false);
    }
  });

  
  window.addEventListener('resize', function () {
    if (isTerminalFullscreen) {
      const s = sessions[activeSessionId];
      if (s && s.fit) {
        try {
          s.fit.fit();
          sshResize(activeSessionId);
          updateSizeBadge(true);
        } catch (_) {}
      }
    }
  });

  
  window.resetToAutoSize = function (wrapperId) {
    const wrapper = document.getElementById(wrapperId);
    if (!wrapper) return;
    wrapper.style.width = '100%';
    wrapper.style.height = 'calc(100vh - 350px)';
    setTimeout(() => {
      if (wrapperId === 'termWrapper') {
        const s = sessions[activeSessionId];
        if (s && s.fit) { s.fit.fit(); sshResize(activeSessionId); updateSizeBadge(false); }
        if (s && s.term) s.term.focus();
      } else if (wrapperId === 'bootTermWrapper') {
        if (bootFit) bootFit.fit();
      }
      VP.toast('Reset to default Auto Size', 'info');
    }, 50);
  };

  function initCornerResizers() {
    const handles = document.querySelectorAll('.resize-handle');
    handles.forEach(handle => {
      handle.addEventListener('mousedown', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const targetId = this.dataset.target;
        const dir = this.dataset.dir;
        const wrapper = document.getElementById(targetId);
        if (!wrapper) return;

        wrapper.classList.add('is-resizing');

        const startX = e.clientX;
        const startY = e.clientY;
        const startWidth = wrapper.offsetWidth;
        const startHeight = wrapper.offsetHeight;

        function onMouseMove(moveEvent) {
          moveEvent.preventDefault();
          const deltaX = moveEvent.clientX - startX;
          const deltaY = moveEvent.clientY - startY;

          let newWidth = startWidth;
          let newHeight = startHeight;

          if (dir === 'br') {
            newWidth = startWidth + deltaX;
            newHeight = startHeight + deltaY;
          } else if (dir === 'bl') {
            newWidth = startWidth - deltaX;
            newHeight = startHeight + deltaY;
          } else if (dir === 'tr') {
            newWidth = startWidth + deltaX;
            newHeight = startHeight - deltaY;
          } else if (dir === 'tl') {
            newWidth = startWidth - deltaX;
            newHeight = startHeight - deltaY;
          } else if (dir === 'b') {
            newHeight = startHeight + deltaY;
          }

          
          const minW = 320;
          const minH = 260;
          const maxW = window.innerWidth - 60;
          const maxH = window.innerHeight - 100;

          newWidth = Math.max(minW, Math.min(maxW, newWidth));
          newHeight = Math.max(minH, Math.min(maxH, newHeight));

          if (dir !== 'b') {
            wrapper.style.width = newWidth + 'px';
          }
          wrapper.style.height = newHeight + 'px';

          
          if (targetId === 'termWrapper') {
            const s = sessions[activeSessionId];
            if (s && s.fit) {
              s.fit.fit();
              sshResize(activeSessionId);
              updateSizeBadge(true);
            }
          } else if (targetId === 'bootTermWrapper' && bootFit) {
            bootFit.fit();
          }
        }

        function onMouseUp() {
          wrapper.classList.remove('is-resizing');
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);

          if (targetId === 'termWrapper') {
            const s = sessions[activeSessionId];
            if (s && s.fit) {
              s.fit.fit();
              sshResize(activeSessionId);
              updateSizeBadge(true);
              if (s.term) s.term.focus();
            }
          } else if (targetId === 'bootTermWrapper' && bootFit) {
            bootFit.fit();
          }
        }

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      });
    });
  }

  window.clearTerm = function () {
    const s = sessions[activeSessionId];
    if (s && s.term) s.term.clear();
  };

  window.fitTerm = function () {
    const s = sessions[activeSessionId];
    if (s && s.fit && s.term) {
      try { s.fit.fit(); sshResize(activeSessionId); s.term.focus(); updateSizeBadge(); } catch (e) {}
    }
  };

  window.sendCtrlC = function () {
    if (connected && socket) {
      socket.emit('console:input', { sessionId: activeSessionId, data: '\x03' });
      const s = sessions[activeSessionId];
      if (s && s.term) s.term.focus();
    }
  };

  window.sendCtrlD = function () {
    if (connected && socket) {
      socket.emit('console:input', { sessionId: activeSessionId, data: '\x04' });
      const s = sessions[activeSessionId];
      if (s && s.term) s.term.focus();
    }
  };

  
  window.toggleAutoScroll = function () {
    autoScroll = !autoScroll;
    const lbl = document.getElementById('autoScrollLabel');
    const btn = document.getElementById('btnToggleScroll');
    if (lbl) lbl.textContent = 'Auto-Scroll: ' + (autoScroll ? 'ON' : 'OFF');
    if (btn) btn.classList.toggle('btn-primary', autoScroll);
    if (autoScroll && bootTerm) bootTerm.scrollToBottom();
  };

  window.toggleViewMode = function () {
    rawView = !rawView;
    const lbl = document.getElementById('viewModeLabel');
    const termDiv = document.getElementById('bootTerminal');
    const rawDiv = document.getElementById('bootRawContent');
    if (rawView) {
      termDiv.style.display = 'none';
      rawDiv.style.display = 'block';
      rawDiv.textContent = rawBootBuffer || '[Boot Log] No boot output recorded yet.';
      if (lbl) lbl.textContent = 'Terminal View';
      if (autoScroll) rawDiv.scrollTop = rawDiv.scrollHeight;
    } else {
      rawDiv.style.display = 'none';
      termDiv.style.display = 'block';
      if (lbl) lbl.textContent = 'Raw View';
      if (bootFit) bootFit.fit();
      if (autoScroll && bootTerm) bootTerm.scrollToBottom();
    }
  };

  window.clearBootDisplay = function () {
    if (bootTerm) bootTerm.clear();
    if (rawBootEl) rawBootEl.textContent = '';
    rawBootBuffer = '';
    VP.toast('Boot terminal display cleared', 'info');
  };

  window.clearBootServerLog = async function () {
    const ok = await VP.confirmDialog('Clear boot log files on server?', { title: 'Clear Server Logs' });
    if (!ok) return;
    if (socket && connected) {
      socket.emit('bootlog:clear', { vmId: <%= vm.id %> });
    } else {
      try {
        await VP.api('/servers/<%= vm.id %>/bootlog/clear', { method: 'POST' });
        clearBootDisplay();
        VP.toast('Boot logs cleared on server', 'success');
      } catch (e) {
        VP.toast(VP.errorMessage(e), 'error');
      }
    }
  };

  window.copyBootLog = function () {
    if (!rawBootBuffer) {
      VP.toast('No boot log output to copy', 'warning');
      return;
    }
    window.copyText(rawBootBuffer, 'Boot logs copied to clipboard!');
  };

  window.downloadBootLog = function () {
    if (!rawBootBuffer) {
      VP.toast('No boot log output to download', 'warning');
      return;
    }
    const blob = new Blob([rawBootBuffer], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = '<%= vm.name %>-boot-' + new Date().toISOString().replace(/[:.]/g, '-') + '.log';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    VP.toast('Boot log download started', 'success');
  };

  window.startAndStream = async function () {
    const btn = document.getElementById('btnStartFromBoot');
    if (btn) btn.disabled = true;
    try {
      VP.toast('Starting server...', 'info');
      await VP.api('/servers/<%= vm.id %>/power', { method: 'POST', body: { action: 'start' } });
      VP.toast('Server started! Streaming boot logs...', 'success');
      const pill = document.getElementById('headerStatusPill');
      if (pill) { pill.textContent = 'running'; pill.className = 'pill pill-green'; }
      if (btn) btn.style.display = 'none';
      joinBootLog();
    } catch (e) {
      VP.toast(VP.errorMessage(e), 'error');
      if (btn) btn.disabled = false;
    }
  };

  window.onSearchInput = function (query) {
    if (!query) {
      if (rawView && rawBootEl) rawBootEl.textContent = rawBootBuffer;
      return;
    }
    const q = query.toLowerCase();
    if (rawView && rawBootEl) {
      const lines = rawBootBuffer.split('\n');
      const filtered = lines.filter(l => l.toLowerCase().includes(q));
      rawBootEl.textContent = filtered.join('\n') || `[No lines matching "${query}"]`;
    }
  };

  
  window.switchView = function switchView(tab) {
    activeTab = tab;
    document.getElementById('tabTerminal').classList.toggle('active', tab === 'terminal');
    document.getElementById('tabNoVnc').classList.toggle('active', tab === 'novnc');
    document.getElementById('tabBootLog').classList.toggle('active', tab === 'bootlog');
    document.getElementById('paneTerminal').style.display = tab === 'terminal' ? 'block' : 'none';
    document.getElementById('paneNoVnc').style.display = tab === 'novnc' ? 'block' : 'none';
    document.getElementById('paneBootLog').style.display = tab === 'bootlog' ? 'block' : 'none';

    if (history.replaceState) {
      history.replaceState(null, null, '?tab=' + tab);
    }

    if (tab === 'terminal') {
      leaveBootLog();
      disconnectVnc();
      const s = sessions[activeSessionId];
      if (s && s.term) {
        setTimeout(() => {
          try {
            if (isDefaultSize) {
              s.term.resize(169, 33);
              sshResize(activeSessionId);
            } else {
              s.fit.fit();
              sshResize(activeSessionId);
            }
            s.term.focus();
            updateSizeBadge(!isDefaultSize);
          } catch (e) {}
        }, 100);
      }
      if (isVmRunning && (!socket || !connected)) {
        setupSocket();
      }
    } else if (tab === 'novnc') {
      leaveBootLog();
      connectVnc();
    } else if (tab === 'bootlog') {
      disconnectVnc();
      setTimeout(() => {
        try { bootFit.fit(); } catch (e) {}
      }, 100);
      joinBootLog();
    }
  };

  
  const urlParams = new URLSearchParams(window.location.search);
  const initialTab = (urlParams.get('tab') === 'bootlog' || window.location.hash === '#bootlog') ? 'bootlog' : (urlParams.get('tab') === 'novnc' ? 'novnc' : 'terminal');

  
  createSession('1', 'Session #1');
  switchSession('1');
  initBootTerm();
  initCornerResizers();

  if (initialTab === 'bootlog') {
    switchView('bootlog');
    setupSocket();
  } else if (initialTab === 'novnc') {
    switchView('novnc');
  } else {
    if (isVmRunning) {
      setupSocket();
    } else {
      setState('offline', 'pill-gray');
      const s = sessions['1'];
      if (s && s.term) {
        s.term.writeln('\r\n\x1b[33m[Notice] Server is offline. Start the server to launch SSH session or monitor Live Boot Logs.\x1b[0m\r\n');
      }
      if (sshBootBanner) sshBootBanner.style.display = 'flex';
      setupSocket();
    }
  }

  
  if (urlParams.get('mode') === 'full' || urlParams.get('fullscreen') === '1') {
    setTimeout(() => {
      window.toggleFullTerminal(true);
    }, 300);
  }

  window.openAiDiagnostics = function() {
    const modal = document.getElementById('aiModalBackdrop');
    if (!modal) return;
    modal.style.display = 'flex';
    const content = document.getElementById('aiModalContent');
    content.innerHTML = `
      <div style="text-align:center;padding:36px;color:#94a3b8">
        <div style="margin-bottom:14px;animation:spin 1.5s linear infinite;display:inline-block;color:var(--gray-300)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </div>
        <div style="font-weight:600;font-size:14px;color:#f1f5f9">Checking VM boot output locally...</div>
        <div style="font-size:12px;margin-top:4px">No logs are sent to an AI provider by this diagnostic.</div>
      </div>
    `;

    fetch('/servers/<%= vm.id %>/bootlog/diagnose', { method: 'POST' })
      .then(r => r.json())
      .then(res => {
        if (!res.ok || !res.diagnosis) {
          content.innerHTML = `<div class="empty" style="color:#ef4444">Failed to run diagnosis: ${res.error || 'Unknown error'}</div>`;
          return;
        }
        const d = res.diagnosis;
        const isCritical = d.severity === 'CRITICAL';
        const isWarning = d.severity === 'WARNING';
        const sevColor = isCritical ? '#ef4444' : (isWarning ? '#f59e0b' : '#10b981');
        const sevBg = isCritical ? 'rgba(239,68,68,0.12)' : (isWarning ? 'rgba(245,158,11,0.12)' : 'rgba(16,185,129,0.12)');
        const sevBorder = isCritical ? 'rgba(239,68,68,0.35)' : (isWarning ? 'rgba(245,158,11,0.35)' : 'rgba(16,185,129,0.35)');

        let fixesHtml = '';
        if (d.suggested_fixes && d.suggested_fixes.length) {
          fixesHtml = `
            <div style="margin-top:16px">
              <div style="font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px">Recommended Remediation Steps:</div>
              <ul style="margin:0;padding-left:18px;color:#cbd5e1;font-size:13px;line-height:1.6">
                ${d.suggested_fixes.map(f => `<li>${escapeDiagnosticHtml(f)}</li>`).join('')}
              </ul>
            </div>
          `;
        }

        let cmdsHtml = '';
        window.__aiDiagCmds = Array.isArray(d.terminal_commands) ? d.terminal_commands.slice() : [];
        if (d.terminal_commands && d.terminal_commands.length) {
          cmdsHtml = `
            <div style="margin-top:16px">
              <div style="font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px">Terminal Remediation Commands:</div>
              <div style="display:flex;flex-direction:column;gap:6px">
                ${d.terminal_commands.map((cmd, idx) => `
                  <div style="display:flex;align-items:center;justify-content:space-between;background:#060913;border:1px solid rgba(255,255,255,0.08);border-radius:6px;padding:8px 12px;font-family:monospace;font-size:12px;color:#38bdf8">
                    <code>${escapeDiagnosticHtml(cmd)}</code>
                    <button class="btn btn-sm" data-copy-cmd-idx="${idx}" style="padding:2px 8px;font-size:11px">Copy</button>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }

        let snippetHtml = '';
        if (d.snippet) {
          snippetHtml = `
            <div style="margin-top:14px;background:#060913;border-left:3px solid ${sevColor};padding:10px 14px;border-radius:0 6px 6px 0;font-family:monospace;font-size:12px;color:#f87171;word-break:break-all">
              ${escapeDiagnosticHtml(d.snippet)}
            </div>
          `;
        }

        content.innerHTML = `
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;background:${sevBg};border:1px solid ${sevBorder};padding:12px 16px;border-radius:10px;margin-bottom:16px">
            <div style="display:flex;align-items:center;gap:10px">
              <span style="font-weight:800;font-size:12px;padding:3px 10px;border-radius:20px;background:${sevColor};color:#fff">${escapeDiagnosticHtml(d.severity)}</span>
              <span style="font-weight:700;font-size:15px;color:#fff">${escapeDiagnosticHtml(d.title)}</span>
            </div>
            <span style="font-size:11px;color:#94a3b8;background:rgba(255,255,255,0.06);padding:3px 8px;border-radius:6px">Confidence: ${d.confidence}%</span>
          </div>

          <div style="font-size:13.5px;color:#e2e8f0;line-height:1.55;background:rgba(255,255,255,0.03);padding:14px;border-radius:8px;border:1px solid rgba(255,255,255,0.06)">
            ${escapeDiagnosticHtml(d.explanation)}
          </div>

          ${snippetHtml}
          ${fixesHtml}
          ${cmdsHtml}

          <div style="margin-top:20px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#64748b">
            <span>Diagnostic Engine: <strong>${escapeDiagnosticHtml(d.provider)}</strong></span>
            <button class="btn btn-sm btn-primary" onclick="closeAiDiagnostics()">Done</button>
          </div>
        `;
      })
      .catch(e => {
        content.innerHTML = `<div class="empty" style="color:#ef4444">Error during analysis: ${e.message}</div>`;
      });
  };

  if (!window.__aiDiagCopyWired) {
    window.__aiDiagCopyWired = true;
    document.addEventListener('click', async (event) => {
      const button = event.target && event.target.closest ? event.target.closest('[data-copy-cmd-idx]') : null;
      if (!button || !Array.isArray(window.__aiDiagCmds)) return;
      const cmd = window.__aiDiagCmds[Number(button.dataset.copyCmdIdx)];
      if (!cmd) return;
      button.disabled = true;
      const ok = window.VP && VP.copyText ? await VP.copyText(cmd, 'Command copied to clipboard.') : false;
      button.disabled = false;
      if (ok) {
        const prior = button.textContent;
        button.textContent = 'Copied!';
        setTimeout(() => { button.textContent = prior; }, 1600);
      }
    });
  }
  window.closeAiDiagnostics = function() {
    const modal = document.getElementById('aiModalBackdrop');
    if (modal) modal.style.display = 'none';
  };
})();
</script>


<div id="aiModalBackdrop" style="display:none;position:fixed;inset:0;background:rgba(4,7,18,0.85);backdrop-filter:blur(8px);z-index:99999;align-items:center;justify-content:center;padding:20px" onclick="if(event.target===this)closeAiDiagnostics()">
  <div style="background:#0d1322;border:1px solid rgba(139,92,246,0.3);border-radius:14px;max-width:680px;width:100%;max-height:85vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.6), 0 0 35px rgba(139,92,246,0.2);display:flex;flex-direction:column">
    <div style="padding:16px 20px;border-bottom:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:space-between;background:rgba(139,92,246,0.06)">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#8b5cf6,#6366f1);display:flex;align-items:center;justify-content:center;color:#fff">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div>
          <div style="font-weight:700;font-size:15px;color:#fff">Local Boot Diagnostics</div>
          <div style="font-size:11.5px;color:#94a3b8">QEMU, Kernel & System Boot Checks</div>
        </div>
      </div>
      <button class="icon-btn" onclick="closeAiDiagnostics()" style="color:#94a3b8">✕</button>
    </div>

    <div id="aiModalContent" style="padding:20px"></div>
  </div>
</div>

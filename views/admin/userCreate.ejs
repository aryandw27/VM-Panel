<%- include('../partials/head', { title: 'Create User' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<%
  const langList = (typeof languages !== 'undefined' && languages) || {
    en: 'English',
    es: 'Español',
    fr: 'Français',
    de: 'Deutsch',
    zh: '简体中文',
    ja: '日本語',
    ru: 'Русский',
    hi: 'हिन्दी'
  };
%>

<div class="main">
  
  <div style="font-size:13px;color:var(--text-muted);margin-bottom:12px;display:flex;align-items:center;gap:6px">
    <a href="/admin" style="color:var(--text-muted);text-decoration:none">Admin</a>
    <span>/</span>
    <a href="/admin/users" style="color:var(--text-muted);text-decoration:none">Users</a>
    <span>/</span>
    <span style="color:var(--accent);font-weight:600">Create</span>
  </div>

  <div class="flex-between mb-4">
    <div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.4px;margin:0">Create User</h2>
      <div class="muted" style="margin-top:2px">Add a new user account to the system</div>
    </div>
    <a href="/admin/users" class="btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" style="vertical-align:-2px;margin-right:4px"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Back to Users
    </a>
  </div>

  <div class="grid grid-2" style="gap:20px;align-items:start">
    
    <div class="card">
      <div class="card-title" style="display:flex;align-items:center;gap:8px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        User Identity
      </div>

      <div class="form-group mb-3">
        <label for="cEmail">Email Address <span style="color:#ef4444">*</span></label>
        <input type="email" id="cEmail" class="form-control" placeholder="user@example.com" required autocomplete="off"/>
      </div>

      <div class="form-group mb-3">
        <label for="cUsername">Username <span style="color:#ef4444">*</span></label>
        <input type="text" id="cUsername" class="form-control" placeholder="e.g. johndoe" required autocomplete="off"/>
        <small class="muted">Letters, numbers, underscores (3-32 characters).</small>
      </div>

      <div class="grid grid-2" style="gap:12px">
        <div class="form-group mb-3">
          <label for="cFirst">Client First Name</label>
          <input type="text" id="cFirst" class="form-control" placeholder="John" autocomplete="off"/>
        </div>
        <div class="form-group mb-3">
          <label for="cLast">Client Last Name</label>
          <input type="text" id="cLast" class="form-control" placeholder="Doe" autocomplete="off"/>
        </div>
      </div>

      <div class="form-group mb-3">
        <label for="cLang">Default Language</label>
        <select id="cLang" class="form-control" style="width:100%;padding:10px;border-radius:8px">
          <% for (const [k, v] of Object.entries(langList)) { %>
            <option value="<%= k %>" <%= k === 'en' ? 'selected' : '' %>><%= v %> (<%= k %>)</option>
          <% } %>
        </select>
        <small class="muted">The default language to use when rendering the panel for this user.</small>
      </div>
    </div>

    
    <div style="display:flex;flex-direction:column;gap:20px">
      
      <div class="card">
        <div class="card-title" style="display:flex;align-items:center;gap:8px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Permissions
        </div>
        <div class="form-group mb-2">
          <label for="cAdmin">Administrator</label>
          <select id="cAdmin" class="form-control" style="width:100%;padding:10px;border-radius:8px">
            <option value="0">No (Standard User)</option>
            <option value="1">Yes (Full Administrator)</option>
          </select>
          <small class="muted" style="display:block;margin-top:6px">Setting this to 'Yes' gives this user full administrative access to all VMs, nodes, and configurations.</small>
        </div>
      </div>

      
      <div class="card">
        <div class="card-title" style="display:flex;align-items:center;justify-content:space-between">
          <div style="display:flex;align-items:center;gap:8px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Password Security
          </div>
          <button type="button" class="btn btn-sm" onclick="generatePass()" style="font-size:12px;display:flex;align-items:center;gap:4px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            Generate Password
          </button>
        </div>

        <div id="genAlert" class="pill pill-green mb-3" style="display:none;padding:10px 14px;border-radius:8px;font-size:13px;width:100%">
          <span style="font-weight:700">Generated Password:</span> <code id="genPassTxt" style="font-weight:700;letter-spacing:1px;margin-left:6px;user-select:all"></code>
        </div>

        <div class="form-group mb-2">
          <label for="cPass">Password <span style="color:#ef4444">*</span></label>
          <div style="position:relative">
            <input type="password" id="cPass" class="form-control" placeholder="••••••••" required autocomplete="new-password"/>
          </div>
          <small class="muted">Must be at least 6 characters long.</small>
        </div>
      </div>
    </div>
  </div>

  <div class="card mt-4" style="display:flex;align-items:center;justify-content:space-between;padding:16px 24px">
    <div class="muted text-sm">Review details before creating. The user can log in immediately upon creation.</div>
    <div class="flex" style="gap:10px">
      <a href="/admin/users" class="btn">Cancel</a>
      <button type="button" class="btn btn-primary" onclick="submitCreate()" style="background:#10b981;border-color:#10b981;display:flex;align-items:center;gap:6px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M20 8v6M23 11h-6"/></svg>
        Create User
      </button>
    </div>
  </div>
</div>

<%- include('../partials/music') %>
<%- include('../partials/foot') %>

<script>
function generatePass() {
  const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#$%&*';
  let pass = '';
  for (let i = 0; i < 14; i++) {
    pass += chars.charAt(Math.floor(Math.random() * chars.length));
  }
  document.getElementById('cPass').value = pass;
  document.getElementById('cPass').type = 'text';
  document.getElementById('genPassTxt').textContent = pass;
  document.getElementById('genAlert').style.display = 'block';
  VP.toast('Generated password and filled in field', 'success');
}

async function submitCreate() {
  const email = document.getElementById('cEmail').value.trim();
  const username = document.getElementById('cUsername').value.trim();
  const name_first = document.getElementById('cFirst').value.trim();
  const name_last = document.getElementById('cLast').value.trim();
  const language = document.getElementById('cLang').value;
  const root_admin = parseInt(document.getElementById('cAdmin').value, 10);
  const password = document.getElementById('cPass').value;

  if (!email || !username || !password) {
    return VP.toast('Email, username, and password are required', 'error');
  }

  try {
    const res = await VP.api('/admin/users/create', {
      method: 'POST',
      body: {
        email,
        username,
        name_first,
        name_last,
        name: (name_first || name_last) ? `${name_first} ${name_last}`.trim() : username,
        language,
        root_admin,
        role: root_admin ? 'admin' : 'user',
        password
      }
    });
    VP.toast('User created successfully!', 'success');
    setTimeout(() => {
      location.href = `/admin/users/${res.user.id}`;
    }, 700);
  } catch (err) {
    VP.toast(err.message || 'Failed to create user', 'error');
  }
}
</script>


<%- include('../partials/head', { title: 'App Store', styles: ['/css/app-store.css'] }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<main class="main app-store">
  <header class="app-store-heading">
    <div>
      <p class="app-store-eyebrow">SILICONHOST / MARKETPLACE</p>
      <h1>VPS App Store</h1>
      <p class="muted">Install reviewed applications or run your own trusted installer on a VM you own.</p>
    </div>
    <a class="btn btn-outline" href="/dashboard">Back to dashboard</a>
  </header>

  <section class="app-store-notice" aria-label="Installer security notice">
    <i data-lucide="shield-check"></i>
    <p><strong>Installers run with administrator privileges inside your VM.</strong> Review the publisher and script before continuing. Docker-based installs require a Debian or Ubuntu guest and an internet connection.</p>
  </section>

  <% if (!vms.length) { %>
    <section class="card app-store-empty">
      <i data-lucide="server"></i>
      <h2>Deploy a VM to get started</h2>
      <p class="muted">The store only installs software on VMs owned by your account.</p>
      <a class="btn btn-primary" href="/dashboard">View your servers</a>
    </section>
  <% } else { %>
    <section class="card app-store-target">
      <label for="appStoreVm">Install on</label>
      <select id="appStoreVm" class="form-control">
        <% vms.forEach((vm) => { %>
          <option value="<%= vm.id %>" data-status="<%= vm.status %>" data-ssh-port="<%= vm.ssh_port %>" data-username="<%= vm.username %>"><%= vm.name %> · <%= vm.status %></option>
        <% }); %>
      </select>
      <span class="muted">The VM must be running and reachable over SSH.</span>
    </section>

    <%
      const appGroups = [];
      apps.forEach((app) => {
        let group = appGroups.find((candidate) => candidate.name === app.category);
        if (!group) {
          group = { name: app.category, items: [] };
          appGroups.push(group);
        }
        group.items.push(app);
      });
    %>
    <% appGroups.forEach((group) => { %>
      <h2 class="app-store-group-title"><%= group.name %></h2>
      <section class="app-store-grid" aria-label="<%= group.name %> applications">
        <% group.items.forEach((app) => { %>
          <article class="card app-store-card">
            <div class="app-store-card-top">
              <span class="app-store-icon"><i data-lucide="<%= app.icon %>"></i></span>
              <span class="app-store-category"><%= app.category %></span>
            </div>
            <h2><%= app.name %></h2>
            <p class="muted"><%= app.description %></p>
            <p class="app-store-exposure"><i data-lucide="network"></i><%= app.exposure %></p>
            <button type="button" class="btn btn-primary app-store-launch" data-app-id="<%= app.id %>" data-app-name="<%= app.name %>">Install <%= app.name %></button>
          </article>
        <% }); %>
      </section>
    <% }); %>

    <section class="card app-store-custom">
      <div class="app-store-card-top">
        <span class="app-store-icon"><i data-lucide="terminal"></i></span>
        <span class="app-store-category">Advanced</span>
      </div>
      <h2>Custom install script</h2>
      <p class="muted">Run a script you have reviewed on your VM as root. The script is sent over the VM's authenticated SSH connection, limited to <%= Math.floor(maxCustomScriptBytes / 1024) %> KB, and is not saved by the panel.</p>
      <label for="customInstallScript">Shell script</label>
      <textarea id="customInstallScript" rows="9" maxlength="<%= maxCustomScriptBytes %>" spellcheck="false" placeholder="#!/usr/bin/env bash&#10;set -euo pipefail&#10;# Commands run as root inside the selected VM."></textarea>
      <div class="app-store-custom-footer">
        <span id="customScriptSize" class="muted">0 / <%= Math.floor(maxCustomScriptBytes / 1024) %> KB</span>
        <button type="button" id="runCustomInstall" class="btn btn-outline">Review and run script</button>
      </div>
    </section>
  <% } %>
  <div class="app-store-status" id="appStoreStatus" role="status" aria-live="polite" hidden></div>
  <section class="card app-store-result" id="appStoreResult" hidden aria-live="polite"></section>
</main>

<script type="application/json" id="appStoreConfigDefs"><%- JSON.stringify(locals.configDefs || {}) %></script>

<div class="app-store-modal" id="appStoreModal" hidden>
  <div class="app-store-modal-backdrop" data-modal-close></div>
  <div class="app-store-modal-card" role="dialog" aria-modal="true" aria-labelledby="appStoreModalTitle">
    <header class="app-store-modal-head">
      <div>
        <p class="app-store-modal-eyebrow" id="appStoreModalEyebrow">INSTALL</p>
        <h3 id="appStoreModalTitle">Configure installation</h3>
        <p class="app-store-modal-sub muted" id="appStoreModalSub"></p>
      </div>
      <button type="button" class="app-store-modal-x" data-modal-close aria-label="Close installation window">&times;</button>
    </header>

    <section class="app-store-modal-body" id="appStoreConfigPane">
      <div class="app-store-config-vm">
        <span class="muted">Install on</span>
        <strong id="appStoreTargetVm">—</strong>
      </div>
      <form id="appStoreConfigForm" autocomplete="off">
        <div id="appStoreConfigFields" class="app-store-config-grid"></div>
        <p class="app-store-config-error" id="appStoreConfigError" hidden></p>
        <section class="app-store-cf">
          <label class="app-store-cf-toggle">
            <input type="checkbox" id="appStoreCfEnabled"/>
            <span>Expose this app through a Cloudflare Tunnel (installs cloudflared after the app)</span>
          </label>
          <div id="appStoreCfFields" hidden>
            <label for="appStoreCfToken">Cloudflare tunnel installation command</label>
            <textarea id="appStoreCfToken" rows="3" spellcheck="false" placeholder="sudo cloudflared service install eyJhIjoi…"></textarea>
            <p class="app-store-cf-help">
              How to get it: go to <strong>dash.cloudflare.com</strong> &gt; select your domain &gt; go to
              <strong>Networking &gt; Tunnels</strong> &gt; create a tunnel &gt; select your OS &gt; copy the installation command and paste it above.
              The tunnel installs <em>after</em> the app. Afterwards map the hostname to this app in the Cloudflare Zero Trust dashboard.
            </p>
            <p class="app-store-cf-error" id="appStoreCfError" hidden></p>
          </div>
        </section>
        <label class="app-store-trust">
          <input type="checkbox" id="appStoreTrust"/>
          <span>I trust this installer and understand it runs with administrator privileges inside the VM.</span>
        </label>
        <div class="app-store-modal-actions">
          <button type="button" class="btn btn-outline" data-modal-close>Cancel</button>
          <button type="button" class="btn btn-primary" id="appStoreStartInstall">Start installation</button>
        </div>
      </form>
    </section>

    <section class="app-store-modal-body" id="appStoreInstallPane" hidden>
      <div class="app-store-progress-row">
        <div class="app-store-progress" aria-hidden="true"><div class="app-store-progress-bar" id="appStoreProgressBar"></div></div>
        <span class="app-store-pct" id="appStorePct">0%</span>
      </div>
      <div class="app-store-phase-row">
        <span class="app-store-phase" id="appStorePhase">Preparing…</span>
        <span class="app-store-timer" id="appStoreTimer">00:00</span>
        <span class="app-store-status-pill" id="appStoreJobStatus">starting</span>
      </div>
      <div class="app-store-console" id="appStoreConsole" tabindex="0" aria-label="Installation console output"></div>
      <div class="app-store-console-foot">
        <label class="app-store-autoscroll"><input type="checkbox" id="appStoreAutoScroll" checked/> Auto-scroll</label>
        <span class="muted" id="appStoreLogCount">0 lines</span>
      </div>
      <section class="app-store-summary" id="appStoreSummary" hidden aria-live="polite"></section>
      <div class="app-store-modal-actions">
        <button type="button" class="btn btn-outline" id="appStoreHideBtn" hidden>Hide — installation keeps running</button>
        <button type="button" class="btn btn-primary" id="appStoreCloseDone" hidden>Close</button>
      </div>
    </section>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script src="/js/app-store.js" defer></script>

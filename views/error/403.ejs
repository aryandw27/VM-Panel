<%- include('../partials/head', { title: title || '403 - Forbidden' }) %>
<%- include('../partials/ambient') %>

<div class="auth-wrap">
  <div class="auth-card" style="text-align:center">
    <div style="margin-bottom:16px">
      <a href="/" style="display:inline-block">
        <img src="/arix/Arix.png" alt="Arix Theme" style="height:44px;width:auto"/>
      </a>
    </div>

    <div style="font-size:72px;font-weight:900;letter-spacing:-2px;line-height:1;margin:12px 0 8px;background:linear-gradient(135deg, #ef4444, #f87171);-webkit-background-clip:text;-webkit-text-fill-color:transparent">
      <%= code || '403' %>
    </div>

    <h1 style="font-size:20px;font-weight:800;color:#fff;margin-bottom:8px">
      <%= title || 'Access Denied / Forbidden' %>
    </h1>

    <p style="font-size:13px;color:var(--text-muted);margin-bottom:24px;line-height:1.5">
      <%= message || 'You do not have the necessary administrative privileges or subuser permissions to access this resource.' %>
    </p>

    <div class="flex" style="gap:10px;justify-content:center">
      <a href="/dashboard" class="btn btn-primary" style="padding:10px 22px;font-weight:700">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="vertical-align:-2px;margin-right:6px"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2 2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Return to Dashboard
      </a>
      <button onclick="history.back()" class="btn" style="padding:10px 18px">
        Go Back
      </button>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>

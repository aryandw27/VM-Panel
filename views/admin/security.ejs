<%- include('../partials/head', { title: 'Rate Limits & IP Security', styles: ['/css/admin-security.css'] }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<main class="main security-page">
  <div class="security-page-heading">
    <div>
      <p class="security-eyebrow">ADMINISTRATION / SECURITY</p>
      <h1>Rate Limits &amp; IP Security</h1>
      <p class="muted">Protect the panel from abusive traffic and review recent request activity by IP, operating system, and browser.</p>
    </div>
    <button class="btn btn-outline" type="button" onclick="location.reload()">
      <i data-lucide="refresh-cw"></i> Refresh analytics
    </button>
  </div>

  <div class="security-notice" role="note">
    Analytics are grouped into five-minute summaries (up to 5,000 recent groups) and expire after 30 days. Browser and OS are inferred from the client-reported user agent and may be inaccurate. Users sharing an IP address also share its rate limit.
  </div>

  <section class="security-stats" aria-label="Request analytics for the last 24 hours">
    <article class="security-stat"><span class="security-stat-icon"><i data-lucide="activity"></i></span><div><strong><%= analytics.requests %></strong><span>Requests · 24 hours</span></div></article>
    <article class="security-stat"><span class="security-stat-icon security-icon-blue"><i data-lucide="network"></i></span><div><strong><%= analytics.uniqueIps %></strong><span>Unique IP addresses</span></div></article>
    <article class="security-stat"><span class="security-stat-icon security-icon-yellow"><i data-lucide="shield-alert"></i></span><div><strong><%= analytics.rateLimited %></strong><span>Rate-limited requests</span></div></article>
    <article class="security-stat"><span class="security-stat-icon security-icon-red"><i data-lucide="ban"></i></span><div><strong><%= blocks.filter((block) => !block.expiresAt || new Date(block.expiresAt) > new Date()).length %></strong><span>Active IP blocks</span></div></article>
  </section>

  <section class="card security-card">
    <div class="security-section-heading">
      <div><h2><i data-lucide="sliders-horizontal"></i> Automatic rate limiting</h2><p class="muted">Limits apply globally per client IP to panel pages and API requests.</p></div>
      <span class="pill <%= securityConfig.enabled ? 'pill-green' : 'pill-gray' %>"><%= securityConfig.enabled ? 'Protection enabled' : 'Protection disabled' %></span>
    </div>
    <form id="rateLimitForm" class="security-config-form">
      <label class="security-toggle">
        <input type="checkbox" name="enabled" <%= securityConfig.enabled ? 'checked' : '' %>>
        <span><strong>Enable automatic rate limiting</strong><small>Automatically block an IP after it exceeds the request threshold.</small></span>
      </label>
      <div class="security-form-grid">
        <div class="form-group"><label for="maxRequests">Requests allowed</label><input id="maxRequests" name="maxRequests" type="number" min="1" max="10000" value="<%= securityConfig.maxRequests %>" required><span class="form-hint">Maximum requests from one IP in the selected window.</span></div>
        <div class="form-group"><label for="windowSeconds">Time window (seconds)</label><input id="windowSeconds" name="windowSeconds" type="number" min="1" max="3600" value="<%= securityConfig.windowSeconds %>" required><span class="form-hint">Window resets automatically after this duration.</span></div>
        <div class="form-group"><label for="punishmentSeconds">Automatic block duration (seconds)</label><input id="punishmentSeconds" name="punishmentSeconds" type="number" min="1" max="604800" value="<%= securityConfig.punishmentSeconds %>" required><span class="form-hint">Maximum 7 days. A new block expires automatically.</span></div>
      </div>
      <div id="securityFormMessage" class="security-form-message" role="status" aria-live="polite"></div>
      <button class="btn btn-primary" type="submit"><i data-lucide="save"></i> Save rate limit settings</button>
    </form>
  </section>

  <section class="card security-card">
    <div class="security-section-heading">
      <div><h2><i data-lucide="user-round-x"></i> Manually block an IP</h2><p class="muted">Manual blocks remain until an administrator removes them or sets an expiry.</p></div>
    </div>
    <form id="blockIpForm" class="security-block-form">
      <div class="form-group"><label for="blockIp">IPv4 or IPv6 address</label><input id="blockIp" name="ip" type="text" inputmode="text" placeholder="203.0.113.25 or 2001:db8::1" maxlength="64" required></div>
      <div class="form-group"><label for="blockDuration">Block duration</label><select id="blockDuration" name="durationSeconds"><option value="0">Until manually unblocked</option><option value="900">15 minutes</option><option value="3600">1 hour</option><option value="86400">24 hours</option><option value="604800">7 days</option></select></div>
      <div class="form-group"><label for="blockReason">Reason (optional)</label><input id="blockReason" name="reason" type="text" maxlength="240" placeholder="Abusive or suspicious traffic"></div>
      <div id="blockFormMessage" class="security-form-message" role="status" aria-live="polite"></div>
      <button class="btn btn-danger" type="submit"><i data-lucide="ban"></i> Block IP address</button>
    </form>
  </section>

  <section class="card security-card">
    <div class="security-section-heading"><div><h2><i data-lucide="chart-no-axes-combined"></i> Request analytics</h2><p class="muted">Grouped client activity over the last 24 hours. Latest path excludes query parameters.</p></div></div>
    <div class="security-table-wrap">
      <table class="table security-table">
        <thead><tr><th>IP address</th><th>System / browser</th><th>Requests</th><th>Limited</th><th>Last request</th><th>Recent endpoint</th><th>Action</th></tr></thead>
        <tbody>
        <% if (!analytics.clients.length) { %>
          <tr><td colspan="7" class="text-center muted py-4">No request analytics recorded in the last 24 hours.</td></tr>
        <% } else { %>
          <% analytics.clients.forEach((client) => { const activeBlock = blocks.find((block) => block.ip === client.ip && (!block.expiresAt || new Date(block.expiresAt) > new Date())); %>
            <tr>
              <td class="mono security-ip"><%= client.ip %><% if (activeBlock) { %><span class="pill pill-red"><%= activeBlock.source === 'automatic' ? 'Auto blocked' : 'Blocked' %></span><% } %></td>
              <td><strong><%= client.os %></strong><span class="security-secondary"><%= client.browser %></span><span class="security-user-agent" title="<%= client.userAgent %>"><%= client.userAgent %></span></td>
              <td><%= client.requestCount %></td>
              <td><span class="<%= client.rateLimitedCount ? 'security-danger-text' : '' %>"><%= client.rateLimitedCount %></span></td>
              <td><%= client.lastSeenAt ? new Date(client.lastSeenAt).toLocaleString() : '—' %></td>
              <td class="mono security-endpoint"><%= client.lastMethod %> <%= client.lastPath %> · <%= client.lastStatus %></td>
              <td><% if (activeBlock) { %><button class="btn btn-sm btn-success" type="button" data-unblock-ip="<%= client.ip %>">Unblock</button><% } else { %><button class="btn btn-sm btn-danger" type="button" data-block-ip="<%= client.ip %>">Block</button><% } %></td>
            </tr>
          <% }) %>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card security-card">
    <div class="security-section-heading"><div><h2><i data-lucide="list-checks"></i> IP block list</h2><p class="muted">Automatic blocks expire after their configured punishment period. Manual blocks are retained until removed.</p></div></div>
    <div class="security-table-wrap">
      <table class="table security-table">
        <thead><tr><th>IP address</th><th>Source</th><th>Reason</th><th>Created</th><th>Expires</th><th>Blocked by</th><th>Action</th></tr></thead>
        <tbody>
        <% if (!blocks.length) { %>
          <tr><td colspan="7" class="text-center muted py-4">No IP blocks recorded.</td></tr>
        <% } else { %>
          <% blocks.forEach((block) => { %>
            <tr>
              <td class="mono security-ip"><%= block.ip %></td>
              <td><span class="pill <%= block.source === 'automatic' ? 'pill-yellow' : 'pill-red' %>"><%= block.source === 'automatic' ? 'Automatic' : 'Manual' %></span></td>
              <td><%= block.reason %></td>
              <td><%= block.createdAt ? new Date(block.createdAt).toLocaleString() : '—' %></td>
              <td><%= block.expiresAt ? new Date(block.expiresAt).toLocaleString() : 'Never' %></td>
              <td><%= block.blockedBy || 'Rate limiter' %></td>
              <td><button class="btn btn-sm btn-success" type="button" data-unblock-ip="<%= block.ip %>">Unblock</button></td>
            </tr>
          <% }) %>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script src="/js/admin-security.js" defer></script>

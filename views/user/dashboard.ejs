<%- include('../partials/head', { title: 'Dashboard' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  
  <div class="card mb-4" style="padding:28px 32px;position:relative;overflow:hidden">
    <div style="position:absolute;right:-40px;top:-40px;width:240px;height:240px;background:radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%);pointer-events:none"></div>
    <div class="flex-between" style="flex-wrap:wrap;gap:16px;position:relative;z-index:2">
      <div>
        <div class="pill pill-gray mb-2" style="font-size:11px;padding:3.5px 12px"><i data-lucide="sparkles" style="width:12px;height:12px"></i> CLOUD CLUSTER</div>
        <h2 style="font-size:26px;font-weight:700;letter-spacing:-0.4px;margin:0 0 6px 0;color:var(--gray-50)">Welcome back, <%= user.username %>!</h2>
        <div class="muted text-sm" style="color:var(--gray-300)">Manage and monitor your virtual cloud servers across the cluster.</div>
      </div>
      <div class="flex" style="gap:10px">
        <% if (user && (user.role === 'admin' || user.root_admin)) { %>
          <a class="btn btn-primary" href="/admin/servers/create" style="padding:10px 20px">
            <i data-lucide="plus" style="width:16px;height:16px"></i> Deploy Virtual Machine
          </a>
        <% } %>
      </div>
    </div>
  </div>

  
  <div class="grid grid-4 mb-4">
    <div class="stat">
      <div class="stat-icon" style="background:rgba(255,255,255,0.07);color:var(--gray-100);border-color:rgba(255,255,255,0.14)">
        <i data-lucide="server" style="width:22px;height:22px"></i>
      </div>
      <div>
        <div class="stat-value"><%= vms.length %></div>
        <div class="stat-label">Total Servers</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:var(--emerald-bg);color:var(--emerald);border-color:var(--emerald-border)">
        <i data-lucide="zap" style="width:22px;height:22px"></i>
      </div>
      <div>
        <div class="stat-value" style="color:var(--emerald)"><%= running %></div>
        <div class="stat-label">Active &amp; Online</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(255,255,255,0.07);color:var(--gray-200);border-color:rgba(255,255,255,0.14)">
        <i data-lucide="cpu" style="width:22px;height:22px"></i>
      </div>
      <div>
        <div class="stat-value"><%= vms.reduce((a,v)=>a+v.cpus,0) %></div>
        <div class="stat-label">vCPU Cores</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:var(--amber-bg);color:var(--amber);border-color:var(--amber-border)">
        <i data-lucide="hard-drive" style="width:22px;height:22px"></i>
      </div>
      <div>
        <div class="stat-value"><%= (vms.reduce((a,v)=>a+v.memory,0)/1024).toFixed(1) %> GB</div>
        <div class="stat-label">RAM Allocated</div>
      </div>
    </div>
  </div>

  
  <div class="card mb-4">
    <div class="flex-between mb-3" style="flex-wrap:wrap;gap:12px">
      <div class="flex" style="gap:10px;align-items:center">
        <div class="card-title" style="margin:0">
          <i data-lucide="layers" style="width:18px;height:18px;color:var(--primary-light)"></i>
          Virtual Machines
        </div>
        <span class="pill pill-gray"><%= vms.length %> instance<%= vms.length === 1 ? '' : 's' %></span>
      </div>

      <div class="flex" style="gap:10px;align-items:center">
        <input type="search" id="vmSearch" placeholder="Filter servers..." style="width:220px;padding:7px 12px;font-size:12.5px;border-radius:var(--radius-input)"/>
        <div class="flex" style="background:var(--gray-800);border:1px solid var(--border);border-radius:var(--radius-input);padding:3px;gap:3px">
          <button id="btnViewCards" class="btn btn-sm btn-primary" onclick="setVmView('cards')" title="Card View" style="padding:4px 10px;font-size:12px">
            <i data-lucide="grid" style="width:14px;height:14px"></i> Cards
          </button>
          <button id="btnViewTable" class="btn btn-sm" onclick="setVmView('table')" title="Table View" style="padding:4px 10px;font-size:12px">
            <i data-lucide="list" style="width:14px;height:14px"></i> Table
          </button>
        </div>
      </div>
    </div>

    <% if (vms.length === 0) { %>
      <div class="empty">
        <i data-lucide="server-off" style="width:48px;height:48px;color:var(--gray-400);margin-bottom:12px"></i>
        <p style="font-weight:600;font-size:15px;color:var(--gray-50);margin-bottom:4px">No servers deployed yet</p>
        <p class="muted">Deploy your first virtual machine to get started with instant cloud environments.</p>
        <% if (user && (user.role === 'admin' || user.root_admin)) { %>
          <div class="mt-3"><a href="/admin/servers/create" class="btn btn-primary">Deploy First Virtual Machine</a></div>
        <% } %>
      </div>
    <% } else { %>
      
      <div id="vmCardGrid" class="grid grid-3 mb-2" style="gap:16px;margin-top:12px">
        <% for (const v of vms) { %>
          <div class="vm-card-item card" data-search="<%= v.name %> <%= v.username %> <%= v.hostname %> <%= v.ssh_port %> <%= v.os_type %>" style="padding:20px;display:flex;flex-direction:column;justify-content:space-between;gap:14px;background:var(--gray-700)">
            <div>
              <div class="flex-between mb-2">
                <div class="flex" style="gap:10px;align-items:center">
                  <div style="width:38px;height:38px;border-radius:var(--radius-input);background:var(--gray-600);display:grid;place-items:center;border:1px solid var(--border)">
                    <i data-lucide="server" style="width:18px;height:18px;color:var(--primary-light)"></i>
                  </div>
                  <div>
                    <a href="/servers/<%= v.id %>" style="font-weight:700;color:var(--gray-50);font-size:15px"><%= v.name %></a>
                    <div class="muted mono text-sm" style="font-size:11px"><%= v.username %>@<%= v.hostname || 'localhost' %></div>
                  </div>
                </div>
                <span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>">
                  <%= v.status === 'running' ? 'Online' : 'Offline' %>
                </span>
              </div>

              <div class="flex" style="gap:6px;margin-bottom:12px;margin-top:8px">
                <span class="pill pill-blue font-bold" style="font-size:10.5px"><%= v.os_type || 'linux' %></span>
                <span class="pill mono font-bold" style="font-size:10.5px;color:var(--primary-light)">Port <%= v.ssh_port %></span>
              </div>

              
              <div style="background:var(--gray-800);border:1px solid var(--border);border-radius:var(--radius-input);padding:10px 12px;display:grid;grid-template-columns:repeat(3,1fr);gap:6px;text-align:center">
                <div>
                  <div class="muted text-sm" style="font-size:10px;text-transform:uppercase">vCPU</div>
                  <div style="font-weight:700;font-size:13px;color:var(--gray-50)"><%= v.cpus %> Core<%= v.cpus > 1 ? 's' : '' %></div>
                </div>
                <div>
                  <div class="muted text-sm" style="font-size:10px;text-transform:uppercase">Memory</div>
                  <div style="font-weight:700;font-size:13px;color:var(--gray-50)"><%= v.memory >= 1024 ? (v.memory/1024).toFixed(1) + ' GB' : v.memory + ' MB' %></div>
                </div>
                <div>
                  <div class="muted text-sm" style="font-size:10px;text-transform:uppercase">Disk</div>
                  <div style="font-weight:700;font-size:13px;color:var(--gray-50)"><%= v.disk_size || '20G' %></div>
                </div>
              </div>
            </div>

            
            <div class="flex-between" style="border-top:1px solid var(--border);padding-top:12px;gap:6px;flex-wrap:wrap">
              <div class="flex" style="gap:6px">
                <a class="btn btn-sm" href="/servers/<%= v.id %>/console" title="Open Console">
                  <i data-lucide="terminal" style="width:13px;height:13px"></i> Console
                </a>
                <% if (v.status === 'running') { %>
                  <button class="btn btn-sm btn-danger" onclick="power(<%= v.id %>,'stop')" title="Stop VM">Stop</button>
                  <button class="btn btn-sm" onclick="power(<%= v.id %>,'restart')" title="Restart VM">Restart</button>
                <% } else { %>
                  <button class="btn btn-sm btn-green" onclick="power(<%= v.id %>,'start')" title="Start VM">Start</button>
                <% } %>
              </div>
              <a class="btn btn-sm btn-primary" href="/servers/<%= v.id %>">Manage</a>
            </div>
          </div>
        <% } %>
      </div>

      
      <div id="vmTableView" class="table-wrap" style="display:none;margin-top:12px">
        <table>
          <thead>
            <tr>
              <th>Instance</th>
              <th>OS / Distro</th>
              <th>SSH &amp; Ports</th>
              <th>Specs (vCPU / RAM / Disk)</th>
              <th>Status</th>
              <th class="right">Management</th>
            </tr>
          </thead>
          <tbody>
          <% for (const v of vms) { %>
            <tr id="vm-row-<%= v.id %>" class="vm-table-row" data-search="<%= v.name %> <%= v.username %> <%= v.hostname %> <%= v.ssh_port %> <%= v.os_type %>">
              <td>
                <div class="flex" style="gap:10px">
                  <div style="width:34px;height:34px;border-radius:var(--radius-input);background:var(--gray-600);display:grid;place-items:center;border:1px solid var(--border)">
                    <i data-lucide="server" style="width:16px;height:16px;color:var(--primary-light)"></i>
                  </div>
                  <div>
                    <a href="/servers/<%= v.id %>" style="font-weight:700;color:var(--gray-50);font-size:14px"><%= v.name %></a>
                    <div class="muted text-sm mono" style="font-size:11.5px"><%= v.username %>@<%= v.hostname || 'localhost' %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="pill pill-blue font-bold"><%= v.os_type || 'linux' %></span>
              </td>
              <td class="mono">
                <span style="color:var(--primary-light);font-weight:600">Port <%= v.ssh_port %></span>
                <div class="muted text-sm">ssh -p <%= v.ssh_port %> <%= v.username %>@localhost</div>
              </td>
              <td>
                <div style="font-weight:600"><%= v.cpus %> vCPU · <%= v.memory %> MB</div>
                <div class="muted text-sm"><%= v.disk_size %> Storage</div>
              </td>
              <td>
                <span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>">
                  <%= v.status %>
                </span>
              </td>
              <td class="right">
                <div class="flex right" style="gap:6px">
                  <a class="btn btn-sm" href="/servers/<%= v.id %>/console" title="Open Web Terminal">
                    <i data-lucide="terminal" style="width:13px;height:13px"></i> Terminal
                  </a>
                  <a class="btn btn-sm" href="/servers/<%= v.id %>/files" title="Open File Manager">
                    <i data-lucide="folder" style="width:13px;height:13px"></i>
                  </a>
                  <% if (v.status === 'running') { %>
                    <button class="btn btn-sm btn-danger" onclick="power(<%= v.id %>,'stop')" title="Stop VM">Stop</button>
                    <button class="btn btn-sm" onclick="power(<%= v.id %>,'restart')" title="Restart VM">Restart</button>
                  <% } else { %>
                    <button class="btn btn-sm btn-green" onclick="power(<%= v.id %>,'start')" title="Start VM">Start</button>
                  <% } %>
                  <a class="btn btn-sm btn-primary" href="/servers/<%= v.id %>">Manage</a>
                </div>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <% if (subVms && subVms.length > 0) { %>
  <div class="card mb-4">
    <div class="card-title">
      <i data-lucide="users" style="width:18px;height:18px;color:var(--primary-light)"></i>
      Shared Virtual Machines
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Server</th><th>Owner</th><th>Status</th><th class="right">Action</th></tr></thead>
        <tbody>
        <% for (const v of subVms) { %>
          <tr>
            <td><a href="/servers/<%= v.id %>" style="font-weight:700;color:var(--gray-50)"><%= v.name %></a></td>
            <td><span class="muted"><%= v.owner_name %></span></td>
            <td><span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>"><%= v.status %></span></td>
            <td class="right"><a class="btn btn-sm btn-primary" href="/servers/<%= v.id %>">Open Server</a></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  
  <div class="card">
    <div class="card-title">
      <i data-lucide="clock" style="width:18px;height:18px;color:var(--primary-light)"></i>
      Recent Activity
    </div>
    <% if (recentActivity.length === 0) { %>
      <div class="empty" style="padding:28px"><p class="muted">No activity logged yet.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Event</th><th>Details</th><th>Timestamp</th></tr></thead>
          <tbody>
          <% for (const a of recentActivity.slice(0, 8)) { %>
            <tr>
              <td>
                <span class="pill pill-blue mono font-bold"><%= a.event %></span>
              </td>
              <td class="muted mono text-sm truncate" style="max-width:380px">
                <%= a.details ? JSON.stringify(a.details) : '—' %>
              </td>
              <td class="muted text-sm"><%= new Date(a.created_at).toLocaleString() %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>

<script>
function setVmView(mode) {
  const cardGrid = document.getElementById('vmCardGrid');
  const tableView = document.getElementById('vmTableView');
  const btnCards = document.getElementById('btnViewCards');
  const btnTable = document.getElementById('btnViewTable');

  if (mode === 'table') {
    if (cardGrid) cardGrid.style.display = 'none';
    if (tableView) tableView.style.display = 'block';
    if (btnCards) btnCards.className = 'btn btn-sm';
    if (btnTable) btnTable.className = 'btn btn-sm btn-primary';
    localStorage.setItem('vm_view_pref', 'table');
  } else {
    if (cardGrid) cardGrid.style.display = 'grid';
    if (tableView) tableView.style.display = 'none';
    if (btnCards) btnCards.className = 'btn btn-sm btn-primary';
    if (btnTable) btnTable.className = 'btn btn-sm';
    localStorage.setItem('vm_view_pref', 'cards');
  }
}


(function() {
  const pref = localStorage.getItem('vm_view_pref') || 'cards';
  setVmView(pref);
})();


document.getElementById('vmSearch')?.addEventListener('input', function() {
  const q = this.value.toLowerCase().trim();
  document.querySelectorAll('.vm-card-item').forEach(el => {
    const s = el.dataset.search ? el.dataset.search.toLowerCase() : el.textContent.toLowerCase();
    el.style.display = s.includes(q) ? 'flex' : 'none';
  });
  document.querySelectorAll('.vm-table-row').forEach(tr => {
    const s = tr.dataset.search ? tr.dataset.search.toLowerCase() : tr.textContent.toLowerCase();
    tr.style.display = s.includes(q) ? '' : 'none';
  });
});

const powerInflight = new Set();
async function power(id, action) {
  const key = `${id}:${action}`;
  if (powerInflight.has(key)) return;
  powerInflight.add(key);
  try {
    if (window.VP && VP.toast) VP.toast(`Sending ${action} command...`, 'info');
    const raw = await fetch(`/servers/${id}/power`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action })
    });
    const res = await raw.json().catch(() => ({}));
    res.status = raw.status;
    if (res.ok) {
      if (window.VP && VP.toast) VP.toast(`Server ${action} successful`, 'success');
      setTimeout(() => location.reload(), 600);
    } else {
      if (window.VP && VP.toast) VP.toast(VP.errorMessage({ message: res.error || 'Power action failed', status: res.status }), 'error', { sticky: true });
    }
  } catch (e) {
    if (window.VP && VP.toast) VP.toast(VP.errorMessage(e, 'Power action failed. Check the connection and try again.'), 'error', { sticky: true });
  } finally {
    powerInflight.delete(key);
  }
}
</script>

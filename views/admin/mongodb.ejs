<%- include('../partials/head', { title: 'MongoDB Management Studio' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<style>

.mongo-hero {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(6, 9, 19, 0.6) 100%);
  border: 1px solid rgba(16, 185, 129, 0.25);
  border-radius: 16px;
  padding: 20px 24px;
  margin-bottom: 24px;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(16px);
  box-shadow: var(--neu-raised);
}
[data-theme="light"] .mongo-hero {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, #ffffff 100%);
  border: 1px solid rgba(16, 185, 129, 0.3);
  box-shadow: var(--neu-raised);
}
.mongo-hero::after {
  content: '';
  position: absolute;
  top: -40px;
  right: -40px;
  width: 140px;
  height: 140px;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.25) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.mongo-hero-metric {
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 10px 16px;
  text-align: right;
  transition: all 0.2s ease;
}
[data-theme="light"] .mongo-hero-metric {
  background: #ffffff;
  border: 1px solid #e6e5e2;
  box-shadow: var(--neu-raised-sm);
}
.mongo-stat-card {
  background: var(--neu-surface, #0e1117);
  border: var(--neu-border, 1px solid var(--border));
  border-radius: var(--radius-card, 16px);
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: var(--neu-raised);
  transition: all 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.mongo-stat-card:hover {
  border-color: rgba(16, 185, 129, 0.4);
  transform: translateY(-2px);
  box-shadow: var(--neu-raised-hover);
}
[data-theme="light"] .mongo-stat-card {
  background: #ffffff;
  border: 1px solid #e6e5e2;
  box-shadow: var(--neu-raised);
}
.mongo-tab-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  background: rgba(0, 0, 0, 0.35);
  padding: 6px;
  border-radius: 14px;
  border: 1px solid var(--border);
  margin-bottom: 24px;
}
[data-theme="light"] .mongo-tab-nav {
  background: #f4f3f0;
  border: 1px solid #e6e5e2;
  box-shadow: var(--neu-inset);
}
.mongo-tab-btn {
  padding: 9px 18px;
  border-radius: 10px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--gray-400);
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.18s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.mongo-tab-btn:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.05);
}
.mongo-tab-btn.active {
  background: #10b981;
  color: #fff;
  border-color: #10b981;
  box-shadow: 0 0 16px rgba(16, 185, 129, 0.45);
}
.mongo-tab-pane {
  display: none;
  animation: fadeInPane 0.2s ease forwards;
}
.mongo-tab-pane.active {
  display: block;
}
@keyframes fadeInPane {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}
.json-viewer {
  font-family: 'JetBrains Mono', 'Fira Code', Consolas, Monaco, monospace;
  font-size: 12.5px;
  line-height: 1.5;
  background: #030712;
  color: #f3f4f6;
  padding: 16px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  overflow-x: auto;
  max-height: 520px;
  white-space: pre-wrap;
  word-break: break-all;
}
.json-key { color: #38bdf8; font-weight: 600; }
.json-string { color: #a7f3d0; }
.json-number { color: #f59e0b; }
.json-boolean { color: #ec4899; }
.json-null { color: #94a3b8; font-style: italic; }
.json-id { color: #c084fc; font-weight: 700; }

.badge-green { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
.badge-red { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
.badge-blue { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
.badge-amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
.badge-purple { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }

.query-chip {
  padding: 5px 12px;
  border-radius: 20px;
  border: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-dim);
  font-size: 12px;
  font-family: monospace;
  cursor: pointer;
  transition: all 0.15s ease;
}
.query-chip:hover {
  background: rgba(16, 185, 129, 0.15);
  border-color: #10b981;
  color: #fff;
}

.table-doc-row {
  transition: background 0.15s ease;
}
.table-doc-row:hover {
  background: rgba(255, 255, 255, 0.035);
}

.mongo-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.78);
  backdrop-filter: blur(8px);
  z-index: 1000;
  display: none;
  place-items: center;
  padding: 20px;
}
.mongo-modal-backdrop.open {
  display: grid;
}

.cell-truncate {
  max-width: 220px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: monospace;
  font-size: 12px;
}
</style>

<div class="main">
  
  <div class="flex-between mb-3">
    <div>
      <div class="muted text-sm mb-1" style="display:flex;align-items:center;gap:6px">
        <a href="/admin" class="muted">Admin</a>
        <span>/</span>
        <span style="color:#10b981;font-weight:600">MongoDB Management Studio</span>
      </div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.4px;margin:0;display:flex;align-items:center;gap:12px">
        <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.2" width="26" height="26"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        MongoDB Management
        <span id="connBadge" class="pill <%= status.connected ? 'badge-green' : 'badge-red' %>" style="font-size:12px;font-weight:700">
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:<%= status.connected ? '#10b981' : '#ef4444' %>;margin-right:6px"></span>
          <%= status.connected ? 'Connected' : 'Disconnected' %>
        </span>
      </h2>
    </div>

    <div class="flex" style="gap:10px">
      <button class="btn btn-sm" onclick="fetchStatusAndStats(true)" title="Refresh Telemetry">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
        Refresh
      </button>
      <button class="btn btn-sm" onclick="switchMongoTab('console')" style="border-color:rgba(16,185,129,0.3)">
        <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" width="14" height="14"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
        Query Console
      </button>
      <button class="btn btn-sm btn-primary" onclick="openCreateDbModal()" style="background:#10b981;border-color:#10b981">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 5v14M5 12h14"/></svg>
        New Database
      </button>
    </div>
  </div>

  
  <div class="mongo-hero">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px">
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
          <span style="font-size:13px;font-weight:700;letter-spacing:0.5px;color:#34d399;text-transform:uppercase">Server Engine</span>
          <span class="pill badge-blue mono" style="font-size:11px" id="heroEngine"><%= status.storageEngine || 'wiredTiger' %></span>
          <span class="pill badge-purple mono" style="font-size:11px" id="heroVersion">MongoDB v<%= status.version || '7.0+' %></span>
        </div>
        <div style="font-size:17px;font-weight:700;color:var(--gray-50);font-family:monospace" id="heroHost">
          <%= status.host || '127.0.0.1' %>:<%= status.port || '27017' %>
        </div>
        <div class="muted text-sm" style="margin-top:4px">
          Uptime: <span style="color:var(--gray-50);font-weight:600" id="heroUptime"><%= status.uptimeFormatted || 'Calculating...' %></span>
          <span style="margin:0 8px;opacity:0.4">|</span>
          Process: <span class="mono" id="heroProcess"><%= status.process || 'mongod' %></span>
        </div>
      </div>

      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <div class="mongo-hero-metric">
          <div class="muted text-sm" style="font-size:11px">Resident Memory</div>
          <div style="font-size:18px;font-weight:800;color:#34d399" id="heroMemResident">-- MB</div>
        </div>
        <div class="mongo-hero-metric">
          <div class="muted text-sm" style="font-size:11px">Active Connections</div>
          <div style="font-size:18px;font-weight:800;color:#38bdf8" id="heroConnections">-- / --</div>
        </div>
        <div class="mongo-hero-metric">
          <div class="muted text-sm" style="font-size:11px">Network In / Out</div>
          <div style="font-size:18px;font-weight:800;color:#fbbf24" id="heroNetwork">-- / --</div>
        </div>
      </div>
    </div>
  </div>

  
  <div class="mongo-tab-nav" id="mongoTabs">
    <button class="mongo-tab-btn active" data-tab="overview" onclick="switchMongoTab('overview')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Overview &amp; Telemetry
    </button>
    <button class="mongo-tab-btn" data-tab="databases" onclick="switchMongoTab('databases')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
      Databases &amp; Collections
    </button>
    <button class="mongo-tab-btn" data-tab="browser" onclick="switchMongoTab('browser')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      Document Browser
    </button>
    <button class="mongo-tab-btn" data-tab="console" onclick="switchMongoTab('console')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
      Query Console
    </button>
    <button class="mongo-tab-btn" data-tab="indexes" onclick="switchMongoTab('indexes')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M4 6h16M4 12h16M4 18h7"/></svg>
      Index Manager
    </button>
    <button class="mongo-tab-btn" data-tab="backups" onclick="switchMongoTab('backups')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Backup &amp; Restore
    </button>
    <button class="mongo-tab-btn" data-tab="users" onclick="switchMongoTab('users')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      DB Users
    </button>
  </div>

  
  <div class="mongo-tab-pane active" id="pane-overview">
    
    <div class="grid grid-4 mb-4">
      <div class="mongo-stat-card">
        <div class="font-semibold mb-1" style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--gray-400)">Total Databases</div>
        <div class="stat-value" id="statTotalDbs" style="font-size:26px;font-weight:800;color:var(--gray-50);letter-spacing:-0.03em">--</div>
        <div class="muted text-sm" style="font-size:11.5px;margin-top:4px;color:var(--gray-400)" id="statDbSize">Total Size: --</div>
      </div>
      <div class="mongo-stat-card">
        <div class="font-semibold mb-1" style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--gray-400)">Virtual Memory</div>
        <div class="stat-value" style="font-size:26px;font-weight:800;color:#c084fc;letter-spacing:-0.03em" id="statMemVirtual">-- MB</div>
        <div class="muted text-sm" style="font-size:11.5px;margin-top:4px;color:var(--gray-400)">Resident: <span id="statMemResidentSub">-- MB</span></div>
      </div>
      <div class="mongo-stat-card">
        <div class="font-semibold mb-1" style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--gray-400)">Total Opcounters</div>
        <div class="stat-value" style="font-size:26px;font-weight:800;color:#38bdf8;letter-spacing:-0.03em" id="statOpcountersTotal">--</div>
        <div class="muted text-sm mono" style="font-size:11px;margin-top:4px;color:var(--gray-400)" id="statOpcountersBreakdown">Q: 0 | I: 0 | U: 0 | D: 0</div>
      </div>
      <div class="mongo-stat-card">
        <div class="font-semibold mb-1" style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.04em;color:var(--gray-400)">Connection Pool</div>
        <div class="stat-value" style="font-size:26px;font-weight:800;color:#34d399;letter-spacing:-0.03em" id="statConnAvailable">--</div>
        <div class="muted text-sm" style="font-size:11.5px;margin-top:4px;color:var(--gray-400)">Available client slots</div>
      </div>
    </div>

    
    <div class="grid grid-2 mb-4">
      
      <div class="card">
        <div class="card-title flex-between mb-3">
          <span style="font-weight:700">Cluster Details</span>
          <span class="pill badge-green">Standalone Node</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;font-size:13px">
          <div class="flex-between" style="border-bottom:1px solid var(--border);padding-bottom:8px">
            <span class="muted">Status</span>
            <span class="pill <%= status.connected ? 'badge-green' : 'badge-red' %>"><%= status.connected ? 'Healthy / Ready' : 'Down' %></span>
          </div>
          <div class="flex-between" style="border-bottom:1px solid var(--border);padding-bottom:8px">
            <span class="muted">Version</span>
            <span class="mono" id="dtVersion"><%= status.version || 'N/A' %></span>
          </div>
          <div class="flex-between" style="border-bottom:1px solid var(--border);padding-bottom:8px">
            <span class="muted">Storage Engine</span>
            <span class="mono" id="dtEngine"><%= status.storageEngine || 'wiredTiger' %></span>
          </div>
          <div class="flex-between" style="border-bottom:1px solid var(--border);padding-bottom:8px">
            <span class="muted">Process ID (PID)</span>
            <span class="mono" id="dtPid"><%= status.pid || 'N/A' %></span>
          </div>
          <div class="flex-between" style="border-bottom:1px solid var(--border);padding-bottom:8px">
            <span class="muted">Total Operations</span>
            <span class="mono" id="dtOps">Loading...</span>
          </div>
          <div class="flex-between">
            <span class="muted">Connection URI</span>
            <span class="mono muted" style="font-size:11px" id="dtUri">mongodb://127.0.0.1:27017</span>
          </div>
        </div>
      </div>

      
      <div class="card">
        <div class="card-title flex-between mb-3">
          <span style="font-weight:700">Database Breakdown</span>
          <button class="btn btn-sm" onclick="openCreateDbModal()" style="font-size:11px;padding:4px 8px">+ New DB</button>
        </div>
        <div style="overflow-x:auto">
          <table class="table" style="font-size:13px">
            <thead>
              <tr>
                <th>Database</th>
                <th>Size</th>
                <th>Collections</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="overviewDbsTbody">
              <tr><td colspan="4" class="text-center muted py-4">Loading databases...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  
  <div class="mongo-tab-pane" id="pane-databases">
    <div class="grid grid-3 mb-4">
      
      <div class="card" style="grid-column: span 1">
        <div class="flex-between mb-3">
          <span style="font-weight:700;font-size:15px">Databases</span>
          <button class="btn btn-sm btn-primary" onclick="openCreateDbModal()" style="padding:4px 10px;font-size:12px;background:#10b981;border-color:#10b981">+ Add DB</button>
        </div>
        <div id="dbListGroup" style="display:flex;flex-direction:column;gap:6px;max-height:550px;overflow-y:auto;padding-right:4px">
          <div class="muted text-sm py-3 text-center">Loading databases...</div>
        </div>
      </div>

      
      <div class="card" style="grid-column: span 2">
        <div class="flex-between mb-3">
          <div>
            <div class="muted text-sm">Selected Database</div>
            <h3 style="font-size:18px;font-weight:800;color:#10b981;margin:0" id="selectedDbTitle">vpanel</h3>
            <div class="muted text-sm mono" id="selectedDbStats" style="font-size:11px;margin-top:2px">Size: - | Collections: - | Objects: -</div>
          </div>
          <div class="flex" style="gap:8px">
            <button class="btn btn-sm" onclick="openCreateCollectionModal()" style="background:#10b981;color:#fff;border-color:#10b981">+ Create Collection</button>
            <button class="btn btn-sm btn-danger" onclick="promptDropCurrentDb()">Drop Database</button>
          </div>
        </div>

        <div style="overflow-x:auto">
          <table class="table" style="font-size:13px">
            <thead>
              <tr>
                <th>Collection Name</th>
                <th>Documents</th>
                <th>Size</th>
                <th>Avg Size</th>
                <th>Indexes</th>
                <th style="text-align:right">Actions</th>
              </tr>
            </thead>
            <tbody id="collectionsTbody">
              <tr><td colspan="6" class="text-center muted py-4">Select a database to view collections</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  
  <div class="mongo-tab-pane" id="pane-browser">
    
    <div class="card mb-3" style="padding:16px 18px">
      <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between">
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <div>
            <label class="muted text-sm" style="font-size:11px;display:block;margin-bottom:2px">Database</label>
            <select id="browserDbSelect" class="form-control" style="width:160px;font-size:13px" onchange="onBrowserDbChange()"></select>
          </div>
          <div>
            <label class="muted text-sm" style="font-size:11px;display:block;margin-bottom:2px">Collection</label>
            <select id="browserCollSelect" class="form-control" style="width:180px;font-size:13px" onchange="onBrowserCollChange()"></select>
          </div>
          <div style="flex:1;min-width:240px">
            <label class="muted text-sm" style="font-size:11px;display:block;margin-bottom:2px">Filter (JSON Query)</label>
            <div style="display:flex;gap:6px">
              <input type="text" id="browserFilterInput" class="form-control mono" placeholder='{"status": "active"}' style="font-size:12.5px" />
              <button class="btn btn-sm btn-primary" onclick="applyBrowserFilter()" style="background:#10b981;border-color:#10b981">Find</button>
              <button class="btn btn-sm" onclick="clearBrowserFilter()">Reset</button>
            </div>
          </div>
        </div>

        <div style="display:flex;gap:10px;align-items:flex-end">
          
          <div>
            <label class="muted text-sm" style="font-size:11px;display:block;margin-bottom:2px">View Mode</label>
            <div style="display:flex;border:1px solid var(--border);border-radius:8px;overflow:hidden">
              <button id="viewBtnTable" class="btn btn-sm" onclick="setDocViewMode('table')" style="border-radius:0;border:none;background:var(--accent);color:#fff">Table</button>
              <button id="viewBtnJson" class="btn btn-sm" onclick="setDocViewMode('json')" style="border-radius:0;border:none">JSON</button>
            </div>
          </div>
          <button class="btn btn-sm btn-primary" onclick="openInsertDocModal()" style="background:#10b981;border-color:#10b981">+ Insert Doc</button>
          <button class="btn btn-sm" onclick="loadBrowserDocs()" title="Reload">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          </button>
        </div>
      </div>
    </div>

    

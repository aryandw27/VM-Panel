          <td><span class="pill ${idx.sparse ? 'badge-amber' : 'badge-blue'}" style="font-size:10.5px">${idx.sparse ? 'Yes' : 'No'}</span></td>
          <td class="mono muted">v${idx.v || 2}</td>
          <td style="text-align:right">
            ${isPrimary ? '<span class="muted text-sm" style="font-size:11px">Protected</span>' : `
              <button class="btn btn-sm btn-danger" onclick="dropIndexPrompt('${escapeHtml(db)}', '${escapeHtml(collection)}', '${escapeHtml(idx.name)}')" style="font-size:11px;padding:3px 8px">Drop</button>
            `}
          </td>
        </tr>
      `;
    }).join('');
  } catch (e) {
    tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger py-4">Failed to load indexes: ${escapeHtml(e.message)}</td></tr>`;
  }
}


        </li>
        <li class="band-item">
          <div class="band-tile dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </div>
        </li>
        <li class="band-item">
          <div class="band-tile ghost">Faster</div>
        </li>
      </ul>
    </section>

    
    <section id="works">
      <div class="shell works-shell">
        <div class="works-header">
          <div class="works-eyebrow">Cloud Solutions</div>
          <h2 class="works-h2">
            <span class="line-clip"><span class="line-inner">Selected Compute Plans</span></span>
          </h2>
        </div>

        <ul class="works-grid">
          
          <li class="work-item">
            <article class="work-card modal-trigger">
              <div class="work-meta-row">
                <span>KVM VPS — Gen4 NVMe</span>
                <div class="work-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </div>

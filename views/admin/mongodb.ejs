<script>

const state = {
  currentTab: 'overview',
  databases: [],
  selectedDb: 'vpanel',
  selectedColl: '',
  browser: {
    db: 'vpanel',
    coll: '',
    filter: '',
    page: 1,
    limit: 25,
    totalPages: 1,
    total: 0,
    docs: [],
    viewMode: 'table'
  },
  console: {
    lastResult: null
  }
};


function showToast(msg, type = 'success') {
  const div = document.createElement('div');
  div.className = `alert alert-${type === 'error' ? 'danger' : type}`;
  div.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;box-shadow:0 8px 32px rgba(0,0,0,0.6);animation:fadeInPane 0.2s ease';
  div.textContent = msg;
  document.body.appendChild(div);
  setTimeout(() => {
    div.style.opacity = '0';
    setTimeout(() => div.remove(), 250);
  }, 3200);
}


function openModal(id) {
  const el = document.getElementById(id);
  if (el) el.classList.add('open');
}
function closeModal(id) {
  const el = document.getElementById(id);
  if (el) el.classList.remove('open');
}


function switchMongoTab(tabId) {
  state.currentTab = tabId;
  window.location.hash = tabId;
  document.querySelectorAll('.mongo-tab-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.tab === tabId);
  });
  document.querySelectorAll('.mongo-tab-pane').forEach(pane => {
    pane.classList.toggle('active', pane.id === `pane-${tabId}`);
  });

  
  if (tabId === 'databases') loadDatabasesAndCollections();
  else if (tabId === 'browser') syncBrowserSelectors();
  else if (tabId === 'console') syncConsoleSelectors();
  else if (tabId === 'indexes') syncIndexSelectors();
  else if (tabId === 'backups') syncBackupSelectors();
  else if (tabId === 'users') syncUserSelectors();
}


async function fetchStatusAndStats(isManual = false) {
  try {
    const [statusRes, statsRes] = await Promise.all([
      fetch('/admin/mongodb/api/status').then(r => r.json()),
      fetch('/admin/mongodb/api/stats').then(r => r.json())
    ]);

    if (statusRes.ok && statusRes.status) {
      const s = statusRes.status;
      const badge = document.getElementById('connBadge');
      if (badge) {
        badge.className = `pill ${s.connected ? 'badge-green' : 'badge-red'}`;
        badge.innerHTML = `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${s.connected ? '#10b981' : '#ef4444'};margin-right:6px"></span>${s.connected ? 'Connected' : 'Disconnected'}`;
      }
      if (s.storageEngine) document.getElementById('heroEngine').textContent = s.storageEngine;
      if (s.version) {
        document.getElementById('heroVersion').textContent = `MongoDB v${s.version}`;
        document.getElementById('dtVersion').textContent = s.version;
      }
      if (s.host && s.port) document.getElementById('heroHost').textContent = `${s.host}:${s.port}`;
      if (s.uptimeFormatted) document.getElementById('heroUptime').textContent = s.uptimeFormatted;
      if (s.process) document.getElementById('heroProcess').textContent = s.process;
      if (s.pid) document.getElementById('dtPid').textContent = s.pid;
    }

    if (statsRes.ok && statsRes.stats) {
      const st = statsRes.stats;
      if (st.mem) {
        const resMb = `${st.mem.resident} MB`;
        const virtMb = `${st.mem.virtual} MB`;
        document.getElementById('heroMemResident').textContent = resMb;
        document.getElementById('statMemResidentSub').textContent = resMb;
        document.getElementById('statMemVirtual').textContent = virtMb;
      }
      if (st.connections) {
        document.getElementById('heroConnections').textContent = `${st.connections.current} / ${st.connections.available}`;
        document.getElementById('statConnAvailable').textContent = `${st.connections.available} avail`;
      }
      if (st.network) {
        document.getElementById('heroNetwork').textContent = `${st.network.bytesInFormatted} / ${st.network.bytesOutFormatted}`;
      }
      if (st.opcounters) {
        const op = st.opcounters;
        const totalOps = (op.query || 0) + (op.insert || 0) + (op.update || 0) + (op.delete || 0) + (op.command || 0);
        document.getElementById('statOpcountersTotal').textContent = totalOps.toLocaleString();
        document.getElementById('statOpcountersBreakdown').textContent = `Q: ${op.query || 0} | I: ${op.insert || 0} | U: ${op.update || 0} | D: ${op.delete || 0}`;
        document.getElementById('dtOps').textContent = `${totalOps.toLocaleString()} operations`;
      }
    }

    
    await loadDatabasesOverview();
    if (isManual) showToast('Telemetry updated successfully');
  } catch (err) {
    console.error('Error fetching MongoDB telemetry:', err);
    if (isManual) showToast('Failed to refresh telemetry: ' + err.message, 'error');
  }
}

async function loadDatabasesOverview() {
  try {
    const res = await fetch('/admin/mongodb/api/databases').then(r => r.json());
    if (!res.ok) return;

    state.databases = res.databases || [];
    document.getElementById('statTotalDbs').textContent = state.databases.length;
    document.getElementById('statDbSize').textContent = `Total Size: ${res.totalSizeFormatted || '0 B'}`;

    const tbody = document.getElementById('overviewDbsTbody');
    if (state.databases.length === 0) {
      tbody.innerHTML = `<tr><td colspan="4" class="text-center muted py-4">No databases found</td></tr>`;
      return;
    }

    tbody.innerHTML = state.databases.map(db => `
      <tr>
        <td style="font-weight:700;color:#fff">${escapeHtml(db.name)}</td>
        <td class="mono muted">${escapeHtml(db.sizeFormatted || '0 B')}</td>
        <td><span class="pill badge-blue" style="font-size:11px">${db.empty ? 'Empty' : 'Active'}</span></td>
        <td>
          <button class="btn btn-sm" onclick="openDbCollections('${escapeHtml(db.name)}')" style="font-size:11px;padding:3px 8px">Explore</button>
        </td>
      </tr>
    `).join('');

    populateAllDbSelects();
  } catch (e) {
    console.error('Failed to load databases overview', e);
  }
}

function populateAllDbSelects() {
  const selects = ['browserDbSelect', 'consoleDbSelect', 'indexDbSelect', 'backupDbSelect', 'restoreDbSelect', 'userDbSelect'];
  selects.forEach(id => {
    const sel = document.getElementById(id);
    if (!sel) return;
    const current = sel.value;
    sel.innerHTML = state.databases.map(d => `<option value="${escapeHtml(d.name)}">${escapeHtml(d.name)}</option>`).join('');
    if (current && state.databases.some(d => d.name === current)) {
      sel.value = current;
    } else if (state.databases.some(d => d.name === 'vpanel')) {
      sel.value = 'vpanel';
    }
  });
}

function openDbCollections(dbName) {
  state.selectedDb = dbName;
  switchMongoTab('databases');
  loadCollectionsForDb(dbName);
}


async function loadDatabasesAndCollections() {
  await loadDatabasesOverview();
  const group = document.getElementById('dbListGroup');
  if (state.databases.length === 0) {
    group.innerHTML = `<div class="muted text-sm py-3 text-center">No databases found</div>`;
    return;
  }

  group.innerHTML = state.databases.map(d => {
    const isSelected = d.name === state.selectedDb;
    return `
      <div onclick="selectDatabase('${escapeHtml(d.name)}')" style="cursor:pointer;padding:10px 14px;border-radius:10px;background:${isSelected ? 'rgba(16,185,129,0.15)' : 'rgba(0,0,0,0.2)'};border:1px solid ${isSelected ? '#10b981' : 'var(--border)'};display:flex;justify-content:space-between;align-items:center">
        <div>
          <div style="font-weight:700;color:${isSelected ? '#34d399' : '#fff'};font-size:13.5px">${escapeHtml(d.name)}</div>
          <div class="muted text-sm mono" style="font-size:11px">${escapeHtml(d.sizeFormatted || '0 B')}</div>
        </div>
        <span class="pill ${d.empty ? 'badge-amber' : 'badge-green'}" style="font-size:10.5px">${d.empty ? 'Empty' : 'Active'}</span>
      </div>
    `;
  }).join('');

  if (state.selectedDb) {
    loadCollectionsForDb(state.selectedDb);
  }
}

function selectDatabase(dbName) {
  state.selectedDb = dbName;
  loadDatabasesAndCollections();
}

async function loadCollectionsForDb(dbName) {
  document.getElementById('selectedDbTitle').textContent = dbName;
  const tbody = document.getElementById('collectionsTbody');
  tbody.innerHTML = `<tr><td colspan="6" class="text-center muted py-4">Loading collections for ${escapeHtml(dbName)}...</td></tr>`;

  try {
    const [collRes, statsRes] = await Promise.all([
      fetch(`/admin/mongodb/api/collections?db=${encodeURIComponent(dbName)}`).then(r => r.json()),
      fetch(`/admin/mongodb/api/databases/${encodeURIComponent(dbName)}/stats`).then(r => r.json())
    ]);

    if (statsRes.ok && statsRes.stats) {
      const st = statsRes.stats;
      document.getElementById('selectedDbStats').textContent = `Size: ${st.storageSizeFormatted || st.dataSizeFormatted || '0 B'} | Collections: ${st.collections || 0} | Objects: ${st.objects || 0}`;
    }

    if (!collRes.ok || !collRes.collections || collRes.collections.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="text-center muted py-4">No collections found in ${escapeHtml(dbName)}</td></tr>`;
      return;
    }

    tbody.innerHTML = collRes.collections.map(c => `
      <tr class="table-doc-row">
        <td>
          <span style="font-weight:700;color:#fff;font-family:monospace;font-size:13px">${escapeHtml(c.name)}</span>
          ${c.capped ? '<span class="pill badge-purple" style="font-size:10px;margin-left:6px">Capped</span>' : ''}
        </td>
        <td class="mono font-semibold" style="color:#34d399">${(c.count || 0).toLocaleString()}</td>
        <td class="mono muted">${escapeHtml(c.sizeFormatted || '0 B')}</td>
        <td class="mono muted">${escapeHtml(c.avgObjSizeFormatted || '0 B')}</td>
        <td class="mono muted">${c.indexesCount || 1}</td>
        <td style="text-align:right">
          <div class="flex" style="gap:6px;justify-content:flex-end">
            <button class="btn btn-sm btn-primary" onclick="browseCollection('${escapeHtml(dbName)}', '${escapeHtml(c.name)}')" style="font-size:11px;padding:3px 8px;background:#10b981;border-color:#10b981">Browse</button>
            <button class="btn btn-sm" onclick="exportCollDirect('${escapeHtml(dbName)}', '${escapeHtml(c.name)}')" style="font-size:11px;padding:3px 8px" title="Export to JSON">Export</button>
            <button class="btn btn-sm" onclick="truncateCollectionPrompt('${escapeHtml(dbName)}', '${escapeHtml(c.name)}')" style="font-size:11px;padding:3px 8px" title="Wipe documents">Truncate</button>
            <button class="btn btn-sm btn-danger" onclick="dropCollectionPrompt('${escapeHtml(dbName)}', '${escapeHtml(c.name)}')" style="font-size:11px;padding:3px 8px">Drop</button>
          </div>
        </td>
      </tr>
    `).join('');
  } catch (err) {
    console.error('Failed to load collections', err);
    tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger py-4">Error loading collections: ${escapeHtml(err.message)}</td></tr>`;
  }
}

function browseCollection(dbName, collName) {
  state.browser.db = dbName;
  state.browser.coll = collName;
  state.browser.page = 1;
  state.browser.filter = '';
  switchMongoTab('browser');
}

function openCreateDbModal() {
  document.getElementById('newDbName').value = '';
  document.getElementById('newDbInitColl').value = 'init';
  openModal('modalCreateDb');
}

async function submitCreateDb() {
  const name = document.getElementById('newDbName').value.trim();
  const coll = document.getElementById('newDbInitColl').value.trim() || 'init';
  if (!name) return showToast('Please provide a database name', 'error');

  try {
    const res = await fetch('/admin/mongodb/api/databases/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, initialCollection: coll })
    }).then(r => r.json());

    if (res.ok) {
      showToast(`Database '${name}' created successfully`);
      closeModal('modalCreateDb');
      state.selectedDb = name;
      loadDatabasesAndCollections();
    } else {
      showToast(res.error || 'Failed to create database', 'error');
    }
  } catch (e) {
    showToast('Failed to create database: ' + e.message, 'error');
  }
}

async function promptDropCurrentDb() {
  const dbName = state.selectedDb;
  if (!dbName) return;
  if (['admin', 'local', 'config'].includes(dbName)) {
    VP.toast(`System database '${dbName}' cannot be dropped.`, 'warning'); return;
  }
  const conf = await VP.promptDialog(`Drop database '${dbName}'?`, { label: `Type '${dbName}' to confirm permanent deletion of every collection and document.`, placeholder: dbName, confirmText: `Drop database` });
  if (conf !== dbName) {
    if (conf !== null) VP.toast('Database name did not match. Aborting.', 'warning');
    return;
  }

  try {
    const res = await fetch('/admin/mongodb/api/databases/drop', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: dbName })
    }).then(r => r.json());

    if (res.ok) {
      showToast(`Database '${dbName}' dropped`);
      state.selectedDb = 'vpanel';
      loadDatabasesAndCollections();
    } else {
      showToast(res.error || 'Failed to drop database', 'error');
    }
  } catch (e) {
    showToast('Error dropping database: ' + e.message, 'error');
  }
}

function openCreateCollectionModal() {
  document.getElementById('createCollDbName').textContent = state.selectedDb;
  document.getElementById('newCollName').value = '';
  document.getElementById('newCollCapped').checked = false;
  document.getElementById('cappedOptions').style.display = 'none';
  openModal('modalCreateColl');
}

function toggleCappedOptions(checked) {
  document.getElementById('cappedOptions').style.display = checked ? 'block' : 'none';
}

async function submitCreateCollection() {
  const name = document.getElementById('newCollName').value.trim();
  if (!name) return showToast('Please enter a collection name', 'error');

  const capped = document.getElementById('newCollCapped').checked;
  const options = {};
  if (capped) {
    options.capped = true;
    options.size = parseInt(document.getElementById('newCollCappedSize').value) || 5242880;
    const max = parseInt(document.getElementById('newCollCappedMax').value);
    if (max) options.max = max;
  }

  try {
    const res = await fetch('/admin/mongodb/api/collections/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ db: state.selectedDb, name, options })
    }).then(r => r.json());

    if (res.ok) {
      showToast(`Collection '${name}' created`);
      closeModal('modalCreateColl');
      loadCollectionsForDb(state.selectedDb);
    } else {
      showToast(res.error || 'Failed to create collection', 'error');
    }
  } catch (e) {
    showToast('Error creating collection: ' + e.message, 'error');
  }
}

async function truncateCollectionPrompt(dbName, collName) {
  if (!await VP.confirmDialog(`Truncate '${collName}' in '${dbName}'? Every document will be wiped. This action is IRREVERSIBLE.`, { title: 'Truncate collection?', confirmText: 'Truncate collection' })) {
    return;
  }

  try {
    const res = await fetch('/admin/mongodb/api/collections/truncate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ db: dbName, name: collName })
    }).then(r => r.json());

    if (res.ok) {
      showToast(`Collection '${collName}' truncated (${res.deletedCount} documents removed)`);
      loadCollectionsForDb(dbName);
    } else {
      showToast(res.error || 'Failed to truncate collection', 'error');
    }
  } catch (e) {
    showToast('Error truncating: ' + e.message, 'error');
  }
}

async function dropCollectionPrompt(dbName, collName) {
  if (!await VP.confirmDialog(`Drop the collection '${collName}' in '${dbName}'? All indexes and documents will be destroyed.`, { title: 'Drop collection?', confirmText: 'Drop collection' })) {
    return;
  }

  try {
    const res = await fetch('/admin/mongodb/api/collections/drop', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ db: dbName, name: collName })
    }).then(r => r.json());

    if (res.ok) {
      showToast(`Collection '${collName}' dropped`);
      loadCollectionsForDb(dbName);
    } else {
      showToast(res.error || 'Failed to drop collection', 'error');
    }
  } catch (e) {
    showToast('Error dropping collection: ' + e.message, 'error');
  }
}

async function exportCollDirect(dbName, collName) {
  try {
    showToast(`Exporting collection '${collName}'...`, 'info');
    const res = await fetch('/admin/mongodb/api/backups/export', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ db: dbName, collection: collName })
    }).then(r => r.json());

    if (res.ok) {
      showToast(`Export complete: ${res.filename} (${res.count} documents)`);
    } else {
      showToast(res.error || 'Export failed', 'error');
    }
  } catch (e) {
    showToast('Export error: ' + e.message, 'error');
  }
}


async function syncBrowserSelectors() {
  populateAllDbSelects();
  const dbSel = document.getElementById('browserDbSelect');
  if (state.browser.db) dbSel.value = state.browser.db;
  await onBrowserDbChange(false);
  loadBrowserDocs();
}

async function onBrowserDbChange(reload = true) {
  const db = document.getElementById('browserDbSelect').value;
  state.browser.db = db;
  const collSel = document.getElementById('browserCollSelect');
  collSel.innerHTML = '<option>Loading...</option>';

  try {
    const res = await fetch(`/admin/mongodb/api/collections?db=${encodeURIComponent(db)}`).then(r => r.json());
    if (res.ok && res.collections && res.collections.length > 0) {
      collSel.innerHTML = res.collections.map(c => `<option value="${escapeHtml(c.name)}">${escapeHtml(c.name)} (${c.count})</option>`).join('');
      if (state.browser.coll && res.collections.some(c => c.name === state.browser.coll)) {
        collSel.value = state.browser.coll;
      } else {
        state.browser.coll = res.collections[0].name;
        collSel.value = res.collections[0].name;
      }
    } else {
      collSel.innerHTML = '<option value="">(No collections)</option>';
      state.browser.coll = '';
    }
  } catch (e) {
    console.error('Failed to load collections for browser', e);
  }

  if (reload) {
    state.browser.page = 1;
    loadBrowserDocs();
  }
}

function onBrowserCollChange() {
  state.browser.coll = document.getElementById('browserCollSelect').value;
  state.browser.page = 1;
  loadBrowserDocs();
}

function applyBrowserFilter() {
  state.browser.filter = document.getElementById('browserFilterInput').value.trim();
  state.browser.page = 1;
  loadBrowserDocs();
}

function clearBrowserFilter() {
  document.getElementById('browserFilterInput').value = '';
  state.browser.filter = '';
  state.browser.page = 1;
  loadBrowserDocs();
}

function setDocViewMode(mode) {
  state.browser.viewMode = mode;
  document.getElementById('viewBtnTable').style.background = mode === 'table' ? 'var(--accent)' : 'transparent';
  document.getElementById('viewBtnTable').style.color = mode === 'table' ? '#fff' : 'var(--text-dim)';
  document.getElementById('viewBtnJson').style.background = mode === 'json' ? 'var(--accent)' : 'transparent';
  document.getElementById('viewBtnJson').style.color = mode === 'json' ? '#fff' : 'var(--text-dim)';

  document.getElementById('docTableView').style.display = mode === 'table' ? 'block' : 'none';
  document.getElementById('docJsonView').style.display = mode === 'json' ? 'flex' : 'none';
  renderBrowserDocs();
}

function onPageSizeChange() {
  state.browser.limit = parseInt(document.getElementById('browserPageSize').value) || 25;
  state.browser.page = 1;
  loadBrowserDocs();
}

function changeBrowserPage(delta) {
  state.browser.page += delta;
  loadBrowserDocs();
}

async function loadBrowserDocs() {
  const db = state.browser.db;
  const coll = state.browser.coll;
  if (!coll) {
    document.getElementById('docTableBody').innerHTML = `<tr><td colspan="3" class="text-center muted py-4">Please select a collection</td></tr>`;
    document.getElementById('docJsonView').innerHTML = `<div class="text-center muted py-4">Please select a collection</div>`;
    return;
  }

  const queryParams = new URLSearchParams({
    db,
    collection: coll,
    page: state.browser.page,
    limit: state.browser.limit
  });
  if (state.browser.filter) {
    queryParams.set('filter', state.browser.filter);
  }

  document.getElementById('docFilterActiveBadge').style.display = state.browser.filter ? 'inline-block' : 'none';

  try {
    const res = await fetch(`/admin/mongodb/api/documents?${queryParams.toString()}`).then(r => r.json());
    if (!res.ok) {
      showToast(res.error || 'Failed to query documents', 'error');
      return;
    }

    state.browser.docs = res.documents || [];
    state.browser.total = res.total || 0;
    state.browser.totalPages = res.totalPages || 1;
    state.browser.page = res.page || 1;

    document.getElementById('docStatsLabel').textContent = `Showing ${state.browser.docs.length} of ${state.browser.total.toLocaleString()} documents in '${coll}'`;
    document.getElementById('paginationInfo').textContent = `Page ${state.browser.page} of ${state.browser.totalPages || 1} (Total: ${state.browser.total.toLocaleString()})`;
    document.getElementById('btnPrevPage').disabled = state.browser.page <= 1;
    document.getElementById('btnNextPage').disabled = state.browser.page >= state.browser.totalPages;

    renderBrowserDocs();
  } catch (e) {
    console.error('Error loading documents', e);
    showToast('Failed to load documents: ' + e.message, 'error');
  }
}

function renderBrowserDocs() {
  const docs = state.browser.docs;
  if (!docs || docs.length === 0) {
    document.getElementById('docTableBody').innerHTML = `<tr><td colspan="5" class="text-center muted py-4">No documents found matching query</td></tr>`;
    document.getElementById('docJsonView').innerHTML = `<div class="text-center muted py-4">No documents found</div>`;
    return;
  }

  if (state.browser.viewMode === 'table') {
    
    const keySet = new Set();
    docs.forEach(d => {
      Object.keys(d).forEach(k => {
        if (k !== '_id') keySet.add(k);
      });
    });
    const sampleKeys = Array.from(keySet).slice(0, 5);

    
    const ths = ['_id', ...sampleKeys, 'Actions'];
    document.getElementById('docTableHead').innerHTML = `
      <tr>
        ${ths.map(k => `<th>${escapeHtml(k)}</th>`).join('')}
      </tr>
    `;

    
    document.getElementById('docTableBody').innerHTML = docs.map(doc => {
      const idStr = String(doc._id);
      const cells = sampleKeys.map(k => {
        const val = doc[k];
        let valStr = '';
        if (val === undefined) valStr = '<span class="muted">-</span>';
        else if (typeof val === 'object' && val !== null) valStr = escapeHtml(JSON.stringify(val));
        else valStr = escapeHtml(String(val));
        return `<td><div class="cell-truncate" title="${escapeHtml(typeof val === 'object' ? JSON.stringify(val, null, 2) : String(val))}">${valStr}</div></td>`;
      }).join('');

      return `
        <tr class="table-doc-row">
          <td class="mono font-semibold" style="color:#c084fc">
            <span title="${escapeHtml(idStr)}">${escapeHtml(idStr.length > 18 ? idStr.slice(0, 18) + '…' : idStr)}</span>
          </td>
          ${cells}
          <td style="white-space:nowrap">
            <button class="btn btn-sm" onclick="editDocument('${escapeHtml(idStr)}')" style="font-size:11px;padding:3px 8px">Edit</button>
            <button class="btn btn-sm btn-danger" onclick="deleteDocumentPrompt('${escapeHtml(idStr)}')" style="font-size:11px;padding:3px 8px">Delete</button>
          </td>
        </tr>
      `;
    }).join('');
  } else {
    
    document.getElementById('docJsonView').innerHTML = docs.map(doc => {
      const idStr = String(doc._id);
      const jsonFormatted = syntaxHighlightJson(JSON.stringify(doc, null, 2));
      return `
        <div class="card" style="padding:14px;background:rgba(0,0,0,0.4);border:1px solid var(--border)">
          <div class="flex-between mb-2" style="border-bottom:1px solid rgba(255,255,255,0.06);padding-bottom:8px">
            <span class="mono font-semibold" style="color:#c084fc;font-size:12px">_id: ${escapeHtml(idStr)}</span>
            <div class="flex" style="gap:6px">
              <button class="btn btn-sm" onclick="copyDocumentJson('${escapeHtml(idStr)}')" style="font-size:11px;padding:2px 7px">Copy</button>
              <button class="btn btn-sm btn-primary" onclick="editDocument('${escapeHtml(idStr)}')" style="font-size:11px;padding:2px 7px;background:#10b981;border-color:#10b981">Edit</button>
              <button class="btn btn-sm btn-danger" onclick="deleteDocumentPrompt('${escapeHtml(idStr)}')" style="font-size:11px;padding:2px 7px">Delete</button>
            </div>
          </div>
          <pre class="json-viewer" style="max-height:260px;margin:0">${jsonFormatted}</pre>
        </div>
      `;
    }).join('');

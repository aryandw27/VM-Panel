});


document.addEventListener('DOMContentLoaded', () => {
  const hash = window.location.hash.replace('#', '');
  const initialTab = ['overview', 'databases', 'browser', 'console', 'indexes', 'backups', 'users'].includes(hash) ? hash : 'overview';
  
  fetchStatusAndStats(false);
  switchMongoTab(initialTab);

  
  setInterval(() => {
    if (state.currentTab === 'overview') {
      fetchStatusAndStats(false);
    }
  }, 10000);
});
</script>

